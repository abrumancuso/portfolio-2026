---
import SectionHeading from './SectionHeading.astro';
import { about, site } from '../data/site';
---

<section class="about section" id="sobre-mi" aria-labelledby="sobre-mi-title">
  <div class="about__inner">
    <figure class="about__media">
      <img
        src="/perfil.jpg"
        alt="Retrato de Abril Mancuso"
        width="700"
        height="933"
        loading="eager"
        decoding="async"
      />
      <figcaption>
        <span>{site.name}</span>
        <span>{site.location}</span>
      </figcaption>
    </figure>

    <div class="about__content">
      <SectionHeading
        eyebrow="Sobre mí"
        title={about.lead}
        id="sobre-mi-title"
      />

      <div class="about__paragraphs">
        {about.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
      </div>

      <ul class="about__tags" aria-label="Áreas de especialidad">
        {about.tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>

      <div class="about__links">
        <a class="btn btn--primary" href={site.behance} target="_blank" rel="noopener noreferrer">
          Ver más trabajos en Behance
        </a>
        <a class="about__text-link" href="#proceso">Ver cómo trabajo</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .about__media {
    position: sticky;
    top: calc(var(--nav-height) + 24px);
  }

  .about__media img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .about__media figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: 0.76rem;
    color: var(--color-text-muted);
  }

  .about__content :global(.section-header) {
    margin: 0 0 24px;
    text-align: left;
  }

  .about__content :global(.section-header p) {
    display: none;
  }

  .about__paragraphs {
    display: grid;
    gap: 16px;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .about__paragraphs :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .about__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 30px;
  }

  .about__text-link {
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 820px) {
    .about__inner {
      grid-template-columns: 1fr;
    }

    .about__media {
      position: static;
      max-width: 260px;
      margin: 0 auto;
    }
  }

  @media (max-width: 560px) {
    .about__links {
      align-items: stretch;
      flex-direction: column;
    }

    .about__links .btn {
      width: 100%;
    }
  }
</style>
