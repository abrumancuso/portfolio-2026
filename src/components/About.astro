---
import SectionHeading from './SectionHeading.astro';
import { about, site } from '../data/site';
---

<section class="about section" id="sobre-mi" aria-labelledby="sobre-mi-title">
  <div class="about__folder">
    <span class="folder__tab folder__tab--terracotta">Sobre mí</span>

    <div class="about__inner">
      <figure class="about__media">
        <span class="washi washi--checker about__tape" aria-hidden="true"></span>
        <span class="about__badge" aria-hidden="true">✦ 4.º año</span>
        <img
          src="/perfil.jpg"
          alt="Retrato de Abril Mancuso"
          width="700"
          height="933"
          loading="eager"
          decoding="async"
        />
        <figcaption>
          <span>{site.name}</span>
          <span>{site.location}</span>
        </figcaption>
      </figure>

      <div class="about__content">
        <SectionHeading
          eyebrow="Sobre mí"
          title={about.lead}
          id="sobre-mi-title"
        />

        <p class="about__umai">
          <span aria-hidden="true">✨</span>
          Cursando 4.º año de la Lic. en Tecnología Multimedial · UMAI
        </p>

        <div class="about__paragraphs">
          {about.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
        </div>

        <ul class="about__tags" aria-label="Áreas de especialidad">
          {about.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>

        <div class="about__links">
          <a class="btn btn--primary" href={site.behance} target="_blank" rel="noopener noreferrer">
            Ver más trabajos en Behance
          </a>
          <a class="about__text-link" href="#proceso">Ver cómo trabajo</a>
        </div>

        <svg class="about__arrow" aria-hidden="true" viewBox="0 0 120 72" width="108" height="64">
          <path
            d="M8 10c28 3 50 18 60 46"
            fill="none"
            stroke="#DC6B19"
            stroke-width="3"
            stroke-linecap="round"
          />
          <path
            d="M52 50c5 6 10 9 16 11M68 61c-6-1-11-4-15-9"
            fill="none"
            stroke="#DC6B19"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    overflow: clip;
  }

  .about__folder {
    position: relative;
    max-width: var(--container-width);
    margin: 0 auto;
    padding-top: 34px;
  }

  .about__folder > .folder__tab {
    left: clamp(16px, 4vw, 44px);
  }

  .about__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
    padding: clamp(24px, 4vw, 46px);
    overflow: clip;
    border: 2px solid var(--color-plum);
    border-radius: 0 var(--radius-lg) var(--radius-lg) var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker);
  }

  .about__inner::before {
    content: 'UX/UI · PM · UX/UI · PM · UX/UI · PM · UX/UI · PM · UX/UI · PM · UX/UI · PM';
    position: absolute;
    inset: -4% -6%;
    z-index: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.4rem);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 2px rgba(108, 3, 69, 0.055);
    transform: rotate(-5deg);
    pointer-events: none;
  }

  .about__media {
    position: sticky;
    top: calc(var(--nav-height) + 24px);
    z-index: 1;
    padding: 13px 13px 14px;
    border: 2px solid var(--color-plum);
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker);
    transform: rotate(-1.4deg);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .about__media:hover {
    transform: rotate(0deg) translateY(-3px);
    box-shadow: var(--shadow-sticker-lg);
  }

  .about__tape {
    top: -15px;
    left: 50%;
    width: 142px;
  }

  .about__badge {
    position: absolute;
    top: -14px;
    right: -10px;
    z-index: 2;
    padding: 6px 12px;
    border: 2px solid var(--color-plum);
    border-radius: 3px;
    background: var(--color-bubblegum);
    box-shadow: var(--shadow-sticker-sm);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-plum-deep);
    transform: rotate(6deg);
  }

  .about__media img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center top;
    border-radius: 2px;
    border: 1px solid rgba(108, 3, 69, 0.22);
    background: var(--color-bg-alt);
  }

  .about__media figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 13px;
    padding-top: 10px;
    border-top: 2px dashed rgba(108, 3, 69, 0.28);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .about__content {
    position: relative;
    z-index: 1;
  }

  .about__umai {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    padding: 10px 15px;
    border: 2px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-acid);
    box-shadow: var(--shadow-sticker-sm);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: 0.01em;
    color: var(--color-plum-deep);
    transform: rotate(-1deg);
  }

  .about__content :global(.section-header) {
    margin: 0 0 24px;
    text-align: left;
  }

  .about__content :global(.section-header p) {
    display: none;
  }

  .about__paragraphs {
    display: grid;
    gap: 16px;
    max-width: 62ch;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .about__paragraphs :global(strong) {
    color: var(--color-plum);
    font-weight: 700;
    box-shadow: inset 0 -0.45em 0 var(--color-mustard);
  }

  .about__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 30px;
  }

  .about__text-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 5px;
  }

  .about__arrow {
    position: absolute;
    right: clamp(0px, 3vw, 26px);
    bottom: -46px;
    z-index: 0;
    transform: rotate(6deg);
    pointer-events: none;
  }

  @media (max-width: 820px) {
    .about__inner {
      grid-template-columns: 1fr;
    }

    .about__media {
      position: static;
      max-width: 280px;
      margin: 0 auto;
    }

    .about__arrow {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .about__links {
      align-items: stretch;
      flex-direction: column;
    }

    .about__links .btn {
      width: 100%;
    }

    .about__inner {
      padding: 22px 18px 26px;
    }

    .about__folder > .folder__tab {
      left: 18px;
      padding-inline: 14px;
      font-size: 0.62rem;
    }
  }
</style>
