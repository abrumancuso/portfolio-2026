    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-plum);
    transition: background var(--transition), border-color var(--transition);
  }

  .rituals__hub:hover {
    border-color: var(--color-plum);
    background: var(--color-mustard);
  }

  .rituals__results {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    left: 0;
    z-index: 20;
    max-height: 260px;
    overflow-y: auto;
    padding: 6px;
    border: 1.5px solid var(--color-plum);
    border-radius: 3px;
    background: var(--color-surface);
  }

  .rituals__result {
    display: grid;
    gap: 1px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--transition);
  }

  .rituals__result:hover,
  .rituals__result:focus {
    background: var(--color-peach);
    outline: none;
  }

  .rituals__result strong {
    font-family: var(--font-ui);
    font-size: 0.88rem;
    color: var(--color-plum);
  }

  .rituals__result span {
    font-size: 0.74rem;
    color: var(--color-text-muted);
  }

  /* --- Skeleton de carga --- */
  .rituals__skeleton {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 22px;
  }

  .rituals__bone {
    display: block;
    height: 92px;
    border-radius: var(--radius-md);
    background: linear-gradient(
      100deg,
      var(--color-cream-deep) 20%,
      var(--color-peach) 45%,
      var(--color-cream-deep) 70%
    );
    background-size: 220% 100%;
    animation: rituals-shimmer 1.4s linear infinite;
  }

  @keyframes rituals-shimmer {
    from {
      background-position: 150% 0;
    }
    to {
      background-position: -50% 0;
    }
  }

  /* --- Vacío y error --- */
  .rituals__empty,
  .rituals__error {
    margin-top: 22px;
    padding: clamp(24px, 4vw, 40px);
    border: 1.5px solid var(--color-plum);
    border-radius: 3px;
    background: var(--color-bg);
    text-align: center;
  }

  .rituals__empty h3,
  .rituals__error h3 {
    margin-bottom: 8px;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
  }

  .rituals__empty p,
  .rituals__error p {
    max-width: 62ch;
    margin: 0 auto 18px;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.92rem;
  }

  .rituals__error {
    border-left: 4px solid var(--color-terracotta);
    background: var(--color-bg-alt);
  }

  .rituals__error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  /* --- Ciudades --- */
  .rituals__success {
    margin-top: 22px;
  }

  .rituals__cities {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 12px;
    align-items: stretch;
  }

  .rituals__city {
    display: grid;
    gap: 4px;
    padding: 18px;
    border: 1.5px solid var(--color-plum);
    border-radius: 3px;
  }

  .rituals__city--base {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .rituals__city--team {
    background: var(--color-mustard);
    color: var(--color-plum-deep);
  }

  .rituals__city-tag {
    justify-self: start;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: rgba(255, 248, 220, 0.18);
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .rituals__city--team .rituals__city-tag {
    background: rgba(108, 3, 69, 0.14);
  }

  .rituals__city-name {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: inherit;
  }

  .rituals__city-time {
    font-family: var(--font-ui);
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .rituals__city-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .rituals__city-weather {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1.5px dashed currentColor;
    font-size: 0.8rem;
    opacity: 0.92;
  }

  .rituals__city-emoji {
    font-size: 1.4rem;
    line-height: 1;
  }

  .rituals__bridge {
    align-self: center;
    display: grid;
    place-items: center;
    gap: 1px;
    min-width: 86px;
    padding: 10px 12px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-plum);
  }

  .rituals__bridge small {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* --- Rituales --- */
  .rituals__fieldset {
    margin-top: 22px;
    padding: 0;
    border: none;
  }

  .rituals__rituals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .rituals__ritual {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 1.5px solid var(--color-plum);
    border-radius: 3px;
    background: var(--color-surface);
    color: var(--color-plum);
    text-align: left;
    transition: background var(--transition), color var(--transition),
      border-color var(--transition);
  }

  .rituals__ritual:hover {
    border-color: var(--color-terracotta);
  }

  .rituals__ritual-name {
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .rituals__ritual-meta {
    font-size: 0.74rem;
    opacity: 0.82;
  }

  .rituals__ritual-state {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .rituals__ritual[aria-pressed='true'] {
    border-color: var(--color-plum);
  }

  .rituals__ritual[aria-pressed='true']::after {
    content: '✓';
    position: absolute;
    top: 10px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .rituals__ritual--plum[aria-pressed='true'] {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .rituals__ritual--terracotta[aria-pressed='true'] {
    background: var(--color-terracotta);
    color: var(--color-text);
  }

  .rituals__ritual--peach[aria-pressed='true'] {
    background: var(--color-peach);
    color: var(--color-plum);
  }

  .rituals__ritual--cream[aria-pressed='true'] {
    background: var(--color-cream-deep);
    color: var(--color-plum);
  }

  .rituals__ritual-detail {
    margin-top: 10px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  /* --- Agenda del tema --- */
  .rituals__agenda {
    margin-top: 16px;
    padding: 18px 20px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .rituals__agenda-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
  }

  .rituals__agenda-label {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .rituals__agenda-title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--color-plum);
  }

  .rituals__agenda-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: agenda;
  }

  .rituals__agenda-list li {
    position: relative;
    padding-left: 34px;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--color-text);
    counter-increment: agenda;
  }

  .rituals__agenda-list li::before {
    content: counter(agenda);
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-mustard);
    color: var(--color-plum);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .rituals__agenda-outcome {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1.5px dashed var(--color-border-strong);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .rituals__agenda-outcome span:first-child {
    font-family: var(--font-ui);
    font-weight: 700;
    color: var(--color-plum);
  }

  /* --- Brief de reunión --- */
  .rituals__brief {
    margin-top: 18px;
    padding: clamp(18px, 3vw, 26px);
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker-sm);
  }

  .rituals__brief-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .rituals__brief-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-mustard);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .rituals__brief-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .rituals__brief-badge[data-verdict='async'] {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .rituals__brief-badge[data-verdict='hybrid'] {
    background: var(--color-peach);
    color: var(--color-plum-deep);
  }

  .rituals__brief-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    color: var(--color-plum);
  }

  .rituals__brief-copy {
    max-width: 62ch;
    margin-top: 8px;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text);
  }

  .rituals__brief-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 1.5px dashed var(--color-border-strong);
  }

  .rituals__fact dt {
    margin-bottom: 4px;
    font-family: var(--font-ui);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .rituals__fact dd {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-plum);
  }

  /* --- Propuesta de trabajo --- */
  .rituals__proposal {
    margin-top: 20px;
    padding: clamp(22px, 3vw, 32px);
    border: 1.5px solid var(--color-plum);
    border-radius: 3px;
    background: var(--color-surface);
  }

  .rituals__proposal-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .rituals__proposal-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-mustard);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .rituals__proposal-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .rituals__proposal-badge[data-verdict='async'] {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .rituals__proposal-badge[data-verdict='hybrid'] {
    background: var(--color-peach);
    color: var(--color-plum-deep);
  }

  .rituals__proposal-goal {
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .rituals__proposal-title {
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--color-plum);
  }

  .rituals__proposal-text {
    max-width: 68ch;
    margin-top: 8px;
    font-family: var(--font-ui);
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-text);
  }

  .rituals__proposal-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 20px 0;
    padding: 16px 0;
    border-top: 1px solid rgba(108, 3, 69, 0.18);
    border-bottom: 1px solid rgba(108, 3, 69, 0.18);
  }

  .rituals__proposal-body {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 22px;
  }

  .rituals__proposal-label {
    margin-bottom: 10px;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .rituals__proposal-block--outcome {
    padding: 16px;
    border-radius: 2px;
    background: var(--color-bg-alt);
  }

  .rituals__proposal-outcome {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-plum);
  }

  .rituals__proposal-note {
    margin-top: 10px;
    font-family: var(--font-ui);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .rituals__proposal-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(108, 3, 69, 0.18);
  }

  .rituals__proposal-footer .rituals__proposal-note {
    flex: 1 1 240px;
    margin-top: 0;
    max-width: 46ch;
  }

  .rituals__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-plum);
    color: var(--color-cream);
    font-family: var(--font-ui);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 160ms ease;
  }

  .rituals__cta:hover {
    background: var(--color-terracotta);
  }

  .rituals__cta span {
    transition: transform 160ms ease;
  }

  .rituals__cta:hover span {
    transform: translateX(3px);
  }

  /* --- Barra de solapamiento --- */
  .rituals__overlap {
    margin-top: 22px;
    padding: clamp(16px, 2.5vw, 22px);
    border: 1.5px solid rgba(108, 3, 69, 0.25);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .rituals__overlap-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 14px;
  }

  .rituals__overlap-head h3 {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
  }

  .rituals__overlap-window {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .rituals__ruler {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-text-muted);
  }

  .rituals__track {
    display: grid;
    gap: 6px;
    margin: 8px 0 12px;
    padding: 8px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .rituals__lane {
    position: relative;
    height: 18px;
    border-radius: var(--radius-pill);
    background: rgba(108, 3, 69, 0.08);
    overflow: hidden;
  }

  .rituals__lane-label {
    position: absolute;
    top: 50%;
    left: 6px;
    z-index: 2;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-plum);
    opacity: 0.55;
    pointer-events: none;
  }

  .rituals__lane-blocks {
    position: absolute;
    inset: 0;
  }

  .rituals__block {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: var(--radius-pill);
  }

  .rituals__block--base {
    background: var(--color-plum);
  }

  .rituals__block--team {
    background: var(--color-terracotta);
  }

  .rituals__block--golden {
    background: repeating-linear-gradient(
      45deg,
      var(--color-mustard) 0 8px,
      #f9d68f 8px 16px
    );
    box-shadow: inset 0 0 0 1.5px var(--color-plum);
  }

  .rituals__lane--golden {
    height: 14px;
    background: rgba(247, 197, 102, 0.22);
  }

  .rituals__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .rituals__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    font-weight: 600;
  }

  .rituals__legend-item::before {
    content: '';
    width: 14px;
    height: 8px;
    border-radius: var(--radius-pill);
  }

  .rituals__legend-item--base::before {
    background: var(--color-plum);
  }

  .rituals__legend-item--team::before {
    background: var(--color-terracotta);
  }

  .rituals__legend-item--golden::before {
    background: var(--color-mustard);
    box-shadow: inset 0 0 0 1px var(--color-plum);
  }

  .rituals__legend-note {
    margin-left: auto;
    font-style: italic;
  }

  .rituals__golden-text {
    margin-top: 10px;
    padding: 10px 14px;
    border: 1.5px dashed var(--color-plum);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-plum);
  }

  .rituals__bar-readout {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }

  .rituals__bar-value {
    min-width: 52px;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-plum);
  }

  .rituals__bar-track {
    flex: 1;
    height: 10px;
    border: 1.5px solid var(--color-plum);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    overflow: hidden;
  }

  .rituals__bar-track span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--color-terracotta), var(--color-mustard));
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .rituals__bar-max {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--color-text-muted);
  }

  /* --- Diagnóstico --- */
  .rituals__diagnosis {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 14px;
    margin-top: 18px;
  }

  .rituals__score,
  .rituals__verdict,
  .rituals__kit {
    padding: 18px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .rituals__score {
    display: grid;
    align-content: start;
    gap: 6px;
    background: var(--color-mustard);
  }

  .rituals__score-label {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .rituals__score-value {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-plum);
    font-variant-numeric: tabular-nums;
  }

  .rituals__score-value small {
    font-size: 0.45em;
    vertical-align: super;
  }

  .rituals__score-track {
    height: 12px;
    margin-top: 4px;
    border: 1.5px solid var(--color-plum);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    overflow: hidden;
  }

  .rituals__score-track span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--color-plum), var(--color-terracotta));
    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .rituals__score-note {
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--color-plum-deep);
    opacity: 0.85;
  }

  .rituals__verdict {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .rituals__verdict-badge {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-plum);
    background: var(--color-mustard);
    box-shadow: var(--shadow-sticker-sm);
  }

  .rituals__verdict-badge[data-verdict='async'] {
    background: var(--color-plum);
    color: var(--color-cream);
    border-color: var(--color-plum-deep);
  }

  .rituals__verdict-badge[data-verdict='hybrid'] {
    background: var(--color-peach);
    color: var(--color-plum-deep);
  }

  .rituals__verdict h3 {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.2;
    color: var(--color-plum);
  }

  .rituals__verdict-copy {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .rituals__slot {
    margin-top: 2px;
    padding: 8px 12px;
    border: 1.5px dashed var(--color-plum);
    border-radius: var(--radius-sm);
    background: var(--color-cream-deep);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-plum);
  }

  .rituals__kit {
    border-color: var(--color-plum-deep);
    background: var(--color-plum);
    box-shadow: var(--shadow-sticker-sm);
  }

  .rituals__kit-label {
    margin-bottom: 8px;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mustard);
  }

  .rituals__kit ul {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rituals__kit li {
    position: relative;
    padding-left: 18px;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }

  .rituals__kit li::before {
    content: '\2726';
    position: absolute;
    left: 0;
    color: var(--color-mustard);
  }

  .rituals__weather {
    margin-top: 14px;
    padding: 12px 16px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-cream-deep);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-plum-deep);
  }

  .rituals__source {
    margin-top: 20px;
    text-align: center;
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .rituals__source a {
    color: var(--color-plum);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-mustard);
    text-underline-offset: 3px;
  }

  .rituals__source a:hover {
    color: var(--color-terracotta-deep);
  }

  @media (max-width: 980px) {
    .rituals__cities {
      grid-template-columns: 1fr;
    }

    .rituals__bridge {
      justify-self: center;
      min-width: 74px;
      transform: rotate(0deg);
    }

    .rituals__diagnosis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rituals__kit {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .rituals__rituals {
      grid-template-columns: 1fr;
    }

    .rituals__proposal-body {
      grid-template-columns: 1fr;
    }

    .rituals__brief-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rituals__diagnosis {
      grid-template-columns: 1fr;
    }

    .rituals__kit {
      grid-column: auto;
    }

    .rituals__legend-note {
      margin-left: 0;
      width: 100%;
    }

    .rituals__sticker--star {
      right: -6px;
    }

    .rituals__sticker--smile {
      left: -6px;
    }
  }

  @media (max-width: 560px) {
    .rituals__search-row {
      flex-direction: column;
    }

    .rituals__proposal-facts {
      grid-template-columns: 1fr;
    }

    .rituals__cta {
      width: 100%;
      justify-content: center;
    }

    .rituals__brief-facts {
      grid-template-columns: 1fr;
    }

    .rituals__go {
      width: 100%;
    }

    .rituals__bar {
      flex-direction: column;
      align-items: flex-start;
    }

    .rituals__panel {
      padding: 18px 16px;
    }

    .rituals__tape {
      width: 120px;
    }

    .rituals__city {
      padding: 14px;
    }

    .rituals__ruler span {
      font-size: 0.56rem;
    }
  }

  /* ============================================================
     REDISEÑO TÁCTIL · Carpeta de servicios + nota de propuesta
     (override estético: no altera estructura ni estados)
     ============================================================ */

  .rituals {
    overflow: clip;
    background:
      radial-gradient(ellipse 55% 40% at 82% 8%, rgba(247, 197, 102, 0.5), transparent 70%),
      radial-gradient(ellipse 40% 35% at 10% 92%, rgba(220, 107, 25, 0.12), transparent 70%),
      var(--color-bg);
  }

  .rituals::before {
    content: 'SERVICIOS · PROPUESTA';
    position: absolute;
    top: clamp(24px, 4vw, 64px);
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
    font-family: var(--font-display);
    font-size: clamp(4rem, 13vw, 12rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 2px rgba(108, 3, 69, 0.055);
    pointer-events: none;
  }

  .rituals__stage {
    padding-top: 36px;
  }

  .rituals__tab {
    left: clamp(16px, 4vw, 42px);
    z-index: 3;
  }

  .rituals__panel {
    border-radius: 0 var(--radius-lg) var(--radius-lg) var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 9px 9px 0 rgba(108, 3, 69, 0.16);
  }

  .rituals__tape {
    width: 184px;
    height: 30px;
    border: 1px solid rgba(108, 3, 69, 0.18);
    border-radius: 0;
    background-image: var(--tape-checker);
    background-size: 12px 12px;
    clip-path: polygon(1% 0, 99% 5%, 100% 94%, 0 100%);
    transform: translateX(-50%) rotate(-3deg);
    opacity: 0.92;
  }

  .rituals__sticker--star {
    border-radius: 2px;
    background: var(--color-acid);
    color: var(--color-plum-deep);
    box-shadow: 3px 3px 0 var(--color-plum);
    transform: rotate(8deg);
  }

  .rituals__sticker--smile {
    border-radius: 50%;
    background: var(--color-bubblegum);
    color: var(--color-plum-deep);
    box-shadow: 3px 3px 0 var(--color-plum);
    transform: rotate(-9deg);
  }

  .rituals__bar {
    padding-bottom: 18px;
    border-bottom: 2px dashed rgba(108, 3, 69, 0.28);
  }

  .rituals__state {
    padding: 6px 12px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 var(--color-plum);
  }

  .rituals__state[data-state='success'] {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .rituals__state[data-state='selected'] {
    background: var(--color-terracotta-deep);
    color: var(--color-cream);
  }

  .rituals__state[data-state='empty'] {
    border-style: dashed;
    background: var(--color-cream);
    color: var(--color-plum);
  }

  .rituals__state[data-state='error'] {
    border-color: var(--color-terracotta);
    background: var(--color-plum-deep);
    color: var(--color-cream);
  }

  .rituals__offline {
    border: 2px dashed var(--color-plum);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .rituals__offline:hover {
    background: var(--color-mustard);
  }

  .rituals__offline[aria-pressed='true'] {
    background: var(--color-terracotta-deep);
    color: var(--color-cream);
  }

  .rituals__label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .rituals__input {
    border-radius: 3px;
    background: var(--color-bg);
    box-shadow: inset 3px 3px 0 rgba(108, 3, 69, 0.06);
  }

  .rituals__input::placeholder {
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .rituals__input:focus {
    background: var(--color-surface);
    box-shadow: 4px 4px 0 var(--color-plum);
  }

  .rituals__go {
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 var(--color-plum);
  }

  .rituals__go:hover {
    background: var(--color-plum-deep);
    box-shadow: 6px 6px 0 var(--color-plum);
  }

  .rituals__hub {
    padding: 7px 12px;
    border: 2px solid var(--color-plum);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-plum);
    box-shadow: 2px 2px 0 rgba(108, 3, 69, 0.18);
  }

  .rituals__hub:nth-child(3n + 1) {
    background: var(--color-mustard);
  }

  .rituals__hub:nth-child(3n + 2) {
    background: var(--color-peach);
  }

  .rituals__hub:nth-child(3n) {
    background: var(--color-bubblegum);
  }

  .rituals__hub:hover {
    background: var(--color-acid);
    color: var(--color-plum-deep);
    transform: translate(-1px, -1px) rotate(-1deg);
    box-shadow: 3px 3px 0 var(--color-plum);
  }

  .rituals__results {
    border-radius: 2px;
    box-shadow: 5px 5px 0 var(--color-plum);
  }

  .rituals__result {
    border-radius: 2px;
  }

  .rituals__result:hover,
  .rituals__result:focus {
    background: var(--color-mustard);
  }

  .rituals__result strong {
    font-family: var(--font-body);
    font-weight: 700;
  }

  .rituals__result span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .rituals__bone {
    border-radius: 2px;
    background: linear-gradient(
      100deg,
      var(--color-cream-deep) 20%,
      var(--color-mustard) 45%,
      var(--color-cream-deep) 70%
    );
    background-size: 220% 100%;
  }

  .rituals__empty,
  .rituals__error {
    border: 2px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-mustard);
    box-shadow: var(--shadow-sticker);
    transform: rotate(-0.6deg);
  }

  .rituals__error {
    border-left: 8px solid var(--color-terracotta);
    background: var(--color-peach);
  }

  .rituals__empty h3,
  .rituals__error h3 {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .rituals__city {
    border-radius: 3px;
    box-shadow: 5px 5px 0 var(--color-plum);
    transform: rotate(-0.5deg);
  }

  .rituals__city--team {
    background: var(--color-mustard);
    transform: rotate(0.5deg);
  }

  .rituals__city-tag {
    border: 1.5px solid currentColor;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
  }

  .rituals__city-name {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .rituals__city-time {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .rituals__bridge {
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    box-shadow: 3px 3px 0 var(--color-plum);
  }

  .rituals__fieldset {
    margin-top: 26px;
  }

  .rituals__rituals {
    gap: 12px;
  }

  .rituals__ritual {
    padding: 15px 17px 13px;
    border-radius: 10px 10px 0 0;
    box-shadow: 3px -2px 0 rgba(108, 3, 69, 0.12);
    transition: transform var(--transition), box-shadow var(--transition),
      background var(--transition), color var(--transition);
  }

  .rituals__ritual:nth-child(1) {
    background: var(--color-mustard);
  }

  .rituals__ritual:nth-child(2) {
    background: var(--color-peach);
  }

  .rituals__ritual:nth-child(3) {
    background: var(--color-bubblegum);
  }

  .rituals__ritual:nth-child(4) {
    background: var(--color-acid);
  }

  .rituals__ritual:nth-child(5) {
    background: var(--color-cream-deep);
  }

  .rituals__ritual:hover {
    transform: translateY(-3px);
    box-shadow: 4px 4px 0 var(--color-plum);
  }

  .rituals__ritual[aria-pressed='true'] {
    transform: translateY(-3px);
    box-shadow: 5px 5px 0 var(--color-plum);
  }

  .rituals__ritual-name {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .rituals__ritual-meta {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.02em;
  }

  .rituals__ritual-state {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .rituals__ritual[aria-pressed='true']::after {
    border: 2px solid currentColor;
    border-radius: 2px;
    font-family: var(--font-mono);
  }

  .rituals__ritual--plum[aria-pressed='true'] {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .rituals__ritual--terracotta[aria-pressed='true'] {
    background: var(--color-terracotta-deep);
    color: var(--color-cream);
  }

  .rituals__ritual--peach[aria-pressed='true'] {
    background: var(--color-peach);
    color: var(--color-plum);
  }

  .rituals__ritual--cream[aria-pressed='true'] {
    background: var(--color-cream-deep);
    color: var(--color-plum);
  }

  .rituals__ritual-detail {
    font-size: 0.84rem;
  }

  .rituals__proposal {
    position: relative;
    overflow: clip;
    margin-top: 24px;
    padding: clamp(22px, 3vw, 34px);
    border: 2px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-cream-deep);
    box-shadow: 7px 7px 0 var(--color-plum);
    transform: rotate(-0.4deg);
  }

  .rituals__proposal::before {
    content: 'PROPUESTA · REUNIÓN · PROPUESTA · REUNIÓN · PROPUESTA · REUNIÓN ·';
    position: absolute;
    inset: -8% -4%;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 2px rgba(108, 3, 69, 0.06);
    transform: rotate(-4deg);
    pointer-events: none;
  }

  .rituals__proposal > * {
    position: relative;
    z-index: 1;
  }

  .rituals__proposal-badge {
    padding: 5px 11px;
    border: 2px solid var(--color-plum);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: 2px 2px 0 var(--color-plum);
  }

  .rituals__proposal-goal {
    font-family: var(--font-script);
    font-style: italic;
    font-size: 1.18rem;
    font-weight: 400;
    color: var(--color-terracotta-deep);
  }

  .rituals__proposal-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.6vw, 2.5rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .rituals__proposal-text {
    max-width: 66ch;
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .rituals__proposal-facts {
    border-top: 2px dashed rgba(108, 3, 69, 0.28);
    border-bottom: 2px dashed rgba(108, 3, 69, 0.28);
  }

  .rituals__fact {
    padding: 10px 12px;
    border: 1.5px solid rgba(108, 3, 69, 0.32);
    border-radius: 2px;
    background: var(--color-surface);
    box-shadow: 2px 2px 0 rgba(108, 3, 69, 0.14);
  }

  .rituals__fact dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
  }

  .rituals__fact dd {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .rituals__proposal-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  .rituals__agenda-list li::before {
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-mustard);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .rituals__proposal-block--outcome {
    border: 2px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-acid);
    box-shadow: 3px 3px 0 rgba(108, 3, 69, 0.18);
    transform: rotate(0.6deg);
  }

  .rituals__proposal-outcome {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--color-plum-deep);
  }

  .rituals__proposal-footer {
    border-top: 2px dashed rgba(108, 3, 69, 0.28);
  }

  .rituals__cta {
    padding: 12px 20px;
    border: 2px solid var(--color-plum);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 var(--color-terracotta);
  }

  .rituals__cta:hover {
    background: var(--color-plum-deep);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-terracotta);
  }

  .rituals__source {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.01em;
  }

  @media (max-width: 700px) {
    .rituals__proposal,
    .rituals__empty,
    .rituals__error,
    .rituals__city {
      transform: none;
    }

    .rituals__proposal-block--outcome {
      transform: none;
    }

    .rituals::before {
      font-size: clamp(3rem, 16vw, 6rem);
    }

    .rituals__tab {
      left: 16px;
      padding-inline: 14px;
      font-size: 0.6rem;
    }
  }

  @media (max-width: 560px) {
    .rituals__stage {
      padding-top: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rituals *,
    .rituals *::before,
    .rituals *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
