    transition: background var(--transition), color var(--transition);
  }

  .rituals__state-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .rituals__state[data-state='loading'] .rituals__state-dot {
    animation: rituals-blink 1s ease-in-out infinite;
  }

  @keyframes rituals-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.2;
    }
  }

  .rituals__state[data-state='success'] {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .rituals__state[data-state='selected'] {
    background: var(--color-terracotta);
    color: var(--color-text);
  }

  .rituals__state[data-state='empty'] {
    background: var(--color-bg);
    color: var(--color-plum);
    border-style: dashed;
  }

  .rituals__state[data-state='error'] {
    background: var(--color-plum-deep);
    color: var(--color-cream);
    border-color: var(--color-terracotta);
  }

  .rituals__endpoint {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .rituals__offline {
    padding: 6px 12px;
    border: 1.5px dashed var(--color-plum);
    border-radius: var(--radius-pill);
    background: transparent;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-plum);
    transition: background var(--transition), color var(--transition);
  }

  .rituals__offline:hover {
    background: var(--color-peach);
  }

  .rituals__offline[aria-pressed='true'] {
    border-style: solid;
    background: var(--color-terracotta);
    color: var(--color-text);
  }

  .rituals__search {
    position: relative;
    padding: 20px 0 0;
  }

  .rituals__label {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .rituals__search-row {
    display: flex;
    gap: 10px;
    align-items: stretch;
  }

  .rituals__field {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .rituals__input {
    width: 100%;
    min-height: 50px;
    padding: 12px 20px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: 0.95rem;
    color: var(--color-text);
    transition: box-shadow var(--transition), background var(--transition);
  }

  .rituals__input::placeholder {
    color: var(--color-text-muted);
  }

  .rituals__input:focus {
    outline: none;
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker-sm);
  }

  .rituals__go {
    min-height: 50px;
    padding: 12px 26px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-pill);
    background: var(--color-plum);
    font-family: var(--font-ui);
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--color-cream);
    box-shadow: var(--shadow-sticker-sm);
    transition: transform var(--transition), box-shadow var(--transition),
      background var(--transition);
  }

  .rituals__go:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--color-plum);
    background: var(--color-plum-deep);
  }

  .rituals__hint {
    margin-top: 12px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .rituals__hubs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .rituals__hub {
    padding: 7px 14px;
    border: 1.5px solid rgba(108, 3, 69, 0.32);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-plum-soft);
    transition: transform var(--transition), background var(--transition),
      border-color var(--transition), color var(--transition);
  }

  .rituals__hub:hover {
    transform: translateY(-2px) rotate(-1deg);
    border-color: var(--color-plum);
    background: var(--color-mustard);
    color: var(--color-plum);
  }

  .rituals__results {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    left: 0;
    z-index: 20;
    max-height: 260px;
    overflow-y: auto;
    padding: 6px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker);
  }

  .rituals__result {
    display: grid;
    gap: 1px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--transition);
  }

  .rituals__result:hover,
  .rituals__result:focus {
    background: var(--color-peach);
    outline: none;
  }

  .rituals__result strong {
    font-family: var(--font-ui);
    font-size: 0.88rem;
    color: var(--color-plum);
  }

  .rituals__result span {
    font-size: 0.74rem;
    color: var(--color-text-muted);
  }

  /* --- Skeleton de carga --- */
  .rituals__skeleton {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 22px;
  }

  .rituals__bone {
    display: block;
    height: 92px;
    border-radius: var(--radius-md);
    background: linear-gradient(
      100deg,
      var(--color-cream-deep) 20%,
      var(--color-peach) 45%,
      var(--color-cream-deep) 70%
    );
    background-size: 220% 100%;
    animation: rituals-shimmer 1.4s linear infinite;
  }

  @keyframes rituals-shimmer {
    from {
      background-position: 150% 0;
    }
    to {
      background-position: -50% 0;
    }
  }

  /* --- Vacío y error --- */
  .rituals__empty,
  .rituals__error {
    margin-top: 22px;
    padding: clamp(24px, 4vw, 40px);
    border: 2px dashed var(--color-plum);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    text-align: center;
  }

  .rituals__empty-emoji,
  .rituals__error-emoji {
    margin-bottom: 8px;
    font-size: 2rem;
  }

  .rituals__empty h3,
  .rituals__error h3 {
    margin-bottom: 8px;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
  }

  .rituals__empty p,
  .rituals__error p {
    max-width: 62ch;
    margin: 0 auto 18px;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .rituals__error {
    border: 2px solid var(--color-plum);
    border-left: 8px solid var(--color-terracotta);
    background: var(--color-peach);
  }

  .rituals__error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  /* --- Ciudades --- */
  .rituals__success {
    margin-top: 22px;
  }

  .rituals__cities {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 12px;
    align-items: stretch;
  }

  .rituals__city {
    display: grid;
    gap: 4px;
    padding: 18px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sticker-sm);
  }

  .rituals__city--base {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .rituals__city--team {
    background: var(--color-mustard);
    color: var(--color-plum-deep);
  }

  .rituals__city-tag {
    justify-self: start;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: rgba(255, 248, 220, 0.18);
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .rituals__city--team .rituals__city-tag {
    background: rgba(108, 3, 69, 0.14);
  }

  .rituals__city-name {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: inherit;
  }

  .rituals__city-time {
    font-family: var(--font-ui);
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .rituals__city-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .rituals__city-weather {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1.5px dashed currentColor;
    font-size: 0.8rem;
    opacity: 0.92;
  }

  .rituals__city-emoji {
    font-size: 1.4rem;
    line-height: 1;
  }

  .rituals__bridge {
    align-self: center;
    display: grid;
    place-items: center;
    gap: 1px;
    min-width: 86px;
    padding: 10px 12px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker-sm);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-plum);
    transform: rotate(-2deg);
  }

  .rituals__bridge small {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* --- Rituales --- */
  .rituals__fieldset {
    margin-top: 22px;
    padding: 0;
    border: none;
  }

  .rituals__rituals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .rituals__ritual {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-plum);
    text-align: left;
    transition: transform var(--transition), box-shadow var(--transition),
      background var(--transition), color var(--transition);
  }

  .rituals__ritual:hover {
    transform: translate(-1px, -2px) rotate(-0.6deg);
    box-shadow: var(--shadow-sticker-sm);
  }

  .rituals__ritual-name {
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .rituals__ritual-meta {
    font-size: 0.74rem;
    opacity: 0.82;
  }

  .rituals__ritual-state {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .rituals__ritual[aria-pressed='true'] {
    box-shadow: var(--shadow-sticker-sm);
    transform: translate(-1px, -1px);
  }

  .rituals__ritual[aria-pressed='true']::after {
    content: '✓';
    position: absolute;
    top: 10px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .rituals__ritual--plum[aria-pressed='true'] {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .rituals__ritual--terracotta[aria-pressed='true'] {
    background: var(--color-terracotta);
    color: var(--color-text);
  }

  .rituals__ritual--peach[aria-pressed='true'] {
    background: var(--color-peach);
    color: var(--color-plum);
  }

  .rituals__ritual--cream[aria-pressed='true'] {
    background: var(--color-cream-deep);
    color: var(--color-plum);
  }

  .rituals__ritual-detail {
    margin-top: 10px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  /* --- Barra de solapamiento --- */
  .rituals__overlap {
    margin-top: 22px;
    padding: clamp(16px, 2.5vw, 22px);
    border: 1.5px solid rgba(108, 3, 69, 0.25);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .rituals__overlap-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 14px;
  }

  .rituals__overlap-head h3 {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
  }

  .rituals__overlap-window {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .rituals__ruler {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-text-muted);
  }

  .rituals__track {
    display: grid;
    gap: 6px;
    margin: 8px 0 12px;
    padding: 8px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .rituals__lane {
    position: relative;
    height: 18px;
    border-radius: var(--radius-pill);
    background: rgba(108, 3, 69, 0.08);
    overflow: hidden;
  }

  .rituals__lane-label {
    position: absolute;
    top: 50%;
    left: 6px;
    z-index: 2;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-plum);
    opacity: 0.55;
    pointer-events: none;
  }

  .rituals__lane-blocks {
    position: absolute;
    inset: 0;
  }

  .rituals__block {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: var(--radius-pill);
  }

  .rituals__block--base {
    background: var(--color-plum);
  }

  .rituals__block--team {
    background: var(--color-terracotta);
  }

  .rituals__block--golden {
    background: repeating-linear-gradient(
      45deg,
      var(--color-mustard) 0 8px,
      #f9d68f 8px 16px
    );
    box-shadow: inset 0 0 0 1.5px var(--color-plum);
  }

  .rituals__lane--golden {
    height: 14px;
    background: rgba(247, 197, 102, 0.22);
  }

  .rituals__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .rituals__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    font-weight: 600;
  }

  .rituals__legend-item::before {
    content: '';
    width: 14px;
    height: 8px;
    border-radius: var(--radius-pill);
  }

  .rituals__legend-item--base::before {
    background: var(--color-plum);
  }

  .rituals__legend-item--team::before {
    background: var(--color-terracotta);
  }

  .rituals__legend-item--golden::before {
    background: var(--color-mustard);
    box-shadow: inset 0 0 0 1px var(--color-plum);
  }

  .rituals__legend-note {
    margin-left: auto;
    font-style: italic;
  }

  .rituals__golden-text {
    margin-top: 10px;
    padding: 10px 14px;
    border: 1.5px dashed var(--color-plum);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-plum);
  }

  .rituals__bar-readout {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }

  .rituals__bar-value {
    min-width: 52px;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-plum);
  }

  .rituals__bar-track {
    flex: 1;
    height: 10px;
    border: 1.5px solid var(--color-plum);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    overflow: hidden;
  }

  .rituals__bar-track span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--color-terracotta), var(--color-mustard));
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .rituals__bar-max {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--color-text-muted);
  }

  /* --- Diagnóstico --- */
  .rituals__diagnosis {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 14px;
    margin-top: 18px;
  }

  .rituals__score,
  .rituals__verdict,
  .rituals__kit {
    padding: 18px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .rituals__score {
    display: grid;
    align-content: start;
    gap: 6px;
    background: var(--color-mustard);
  }

  .rituals__score-label {
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .rituals__score-value {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-plum);
    font-variant-numeric: tabular-nums;
  }

  .rituals__score-value small {
    font-size: 0.45em;
    vertical-align: super;
  }

  .rituals__score-track {
    height: 12px;
    margin-top: 4px;
    border: 1.5px solid var(--color-plum);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    overflow: hidden;
  }

  .rituals__score-track span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--color-plum), var(--color-terracotta));
    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .rituals__score-note {
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--color-plum-deep);
    opacity: 0.85;
  }

  .rituals__verdict {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .rituals__verdict-badge {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-plum);
    background: var(--color-mustard);
    box-shadow: var(--shadow-sticker-sm);
  }

  .rituals__verdict-badge[data-verdict='async'] {
    background: var(--color-plum);
    color: var(--color-cream);
    border-color: var(--color-plum-deep);
  }

  .rituals__verdict-badge[data-verdict='hybrid'] {
    background: var(--color-peach);
    color: var(--color-plum-deep);
  }

  .rituals__verdict h3 {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.2;
    color: var(--color-plum);
  }

  .rituals__verdict-copy {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .rituals__slot {
    margin-top: 2px;
    padding: 8px 12px;
    border: 1.5px dashed var(--color-plum);
    border-radius: var(--radius-sm);
    background: var(--color-cream-deep);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-plum);
  }

  .rituals__kit {
    border-color: var(--color-plum-deep);
    background: var(--color-plum);
    box-shadow: var(--shadow-sticker-sm);
  }

  .rituals__kit-label {
    margin-bottom: 8px;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mustard);
  }

  .rituals__kit ul {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rituals__kit li {
    position: relative;
    padding-left: 18px;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }

  .rituals__kit li::before {
    content: '\2726';
    position: absolute;
    left: 0;
    color: var(--color-mustard);
  }

  .rituals__weather {
    margin-top: 14px;
    padding: 12px 16px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-cream-deep);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-plum-deep);
  }

  .rituals__source {
