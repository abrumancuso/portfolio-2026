---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

/**
 * Propuesta de servicios — Paso 1 (ciudad del equipo) + Paso 2 (servicio).
 *
 * Usa Open-Meteo (geocoding + zonas horarias) para calcular el solapamiento
 * entre Buenos Aires y la ciudad del equipo, y arma una propuesta concreta
 * por servicio: cómo lo abordaría, qué entregaría y en qué horario conviene
 * la primera reunión. Todos los caminos terminan en un contacto directo.
 * Los estados pedidos en la consigna quedan visibles en la UI: loading,
 * success, selected, empty y error.
 */

const baseCity = {
  id: 'buenos-aires',
  name: 'Buenos Aires',
  country: 'Argentina',
  lat: -34.6037,
  lon: -58.3816,
  timezone: 'America/Argentina/Buenos_Aires',
  abbreviation: 'ART',
};

const hubs = [
  { id: 'san-francisco', name: 'San Francisco', country: 'Estados Unidos', lat: 37.7749, lon: -122.4194, timezone: 'America/Los_Angeles' },
  { id: 'madrid', name: 'Madrid', country: 'España', lat: 40.4168, lon: -3.7038, timezone: 'Europe/Madrid' },
  { id: 'cdmx', name: 'Ciudad de México', country: 'México', lat: 19.4326, lon: -99.1332, timezone: 'America/Mexico_City' },
  { id: 'londres', name: 'Londres', country: 'Reino Unido', lat: 51.5074, lon: -0.1278, timezone: 'Europe/London' },
  { id: 'berlin', name: 'Berlín', country: 'Alemania', lat: 52.52, lon: 13.405, timezone: 'Europe/Berlin' },
  { id: 'sao-paulo', name: 'São Paulo', country: 'Brasil', lat: -23.5505, lon: -46.6333, timezone: 'America/Sao_Paulo' },
];

const rituals = [
  {
    id: 'redes',
    label: 'Manejo de redes',
    short: 'Redes',
    goal: 'Construir una comunidad con identidad',
    meta: 'Estrategia y contenido',
    minutes: 30,
    sync: 1,
    tone: 'terracotta',
    detail: 'Estrategia, calendario editorial y métricas para crecer con coherencia.',
    proposal:
      'Diseño la estrategia de contenido a partir de tu audiencia y tus objetivos, y la bajo a un calendario editorial con piezas pensadas para cada red. Mido lo que funciona y ajusto: la idea no es publicar más, sino publicar con criterio.',
    agenda: [
      'Revisar objetivos, audiencia y canales actuales',
      'Definir tono, línea visual y frecuencia',
      'Acordar calendario y métricas de seguimiento',
    ],
    outcome: 'Plan de contenido y calendario editorial listos para arrancar',
  },
  {
    id: 'web',
    label: 'Diseño de web',
    short: 'Web',
    goal: 'Una web clara que convierta',
    meta: 'UX, UI y handoff',
    minutes: 30,
    sync: 1,
    tone: 'plum',
    detail: 'Arquitectura, interfaz y sistema visual pensados para la persona que navega.',
    proposal:
      'Empiezo por entender qué necesita quien entra a tu sitio y qué querés que haga. Después diseño la arquitectura, los flujos y la interfaz, con un sistema visual consistente y accesible. Entrego un prototipo navegable y todo listo para desarrollo.',
    agenda: [
      'Entender objetivos, audiencia y referencias',
      'Revisar arquitectura, flujos y contenido',
      'Definir alcance, plazos y próximos pasos',
    ],
    outcome: 'Prototipo navegable y especificaciones para desarrollo',
  },
  {
    id: 'revision',
    label: 'Revisión de diseño',
    short: 'Revisión',
    goal: 'Detectar qué frena la experiencia',
    meta: 'Auditoría UX/UI',
    minutes: 30,
    sync: 1,
    tone: 'peach',
    detail: 'Usabilidad, consistencia y accesibilidad con criterios claros, no con gustos.',
    proposal:
      'Reviso tu producto con ojo crítico y criterios claros: usabilidad, consistencia visual y accesibilidad. No opino por gusto; documento cada hallazgo, lo priorizo por impacto y te dejo recomendaciones accionables.',
    agenda: [
      'Recorrer el flujo y las pantallas clave',
      'Identificar fricciones y oportunidades',
      'Priorizar hallazgos y definir mejoras',
    ],
    outcome: 'Informe de hallazgos priorizado y plan de mejoras',
  },
  {
    id: 'rebranding',
    label: 'Rebranding',
    short: 'Marca',
    goal: 'Actualizar tu identidad sin perder esencia',
    meta: 'Identidad visual',
    minutes: 30,
    sync: 1,
    tone: 'cream',
    detail: 'Concepto, paleta, tipografía y aplicaciones para que la marca represente lo que hoy sos.',
    proposal:
      'Analizo qué dice hoy tu marca y qué debería decir. A partir de ahí construyo una identidad coherente: concepto, paleta, tipografía y aplicaciones. La idea no es cambiar por cambiar, sino que la marca represente lo que hoy sos.',
    agenda: [
      'Relevar la identidad actual y su contexto',
      'Definir concepto, tono y territorio visual',
      'Acordar alcance y aplicaciones prioritarias',
    ],
    outcome: 'Propuesta de identidad y guía de aplicación',
  },
  {
    id: 'gestion',
    label: 'Gestión de proyectos',
    short: 'Gestión',
    goal: 'Ordenar el proyecto y llegar con foco',
    meta: 'Planificación y seguimiento',
    minutes: 30,
    sync: 1,
    tone: 'plum',
    detail: 'Alcance, prioridades y cadencia de seguimiento para avanzar sin retrabajo.',
    proposal:
      'Ordeno el alcance, las prioridades y la capacidad real del equipo para que el proyecto avance sin retrabajo. Defino objetivos medibles, un roadmap claro y un seguimiento que destrabe decisiones a tiempo.',
    agenda: [
      'Revisar objetivos, alcance y equipo',
      'Priorizar el roadmap y detectar riesgos',
      'Definir cadencia de seguimiento y próximos pasos',
    ],
    outcome: 'Roadmap priorizado y sistema de seguimiento',
  },
];

const config = { baseCity, hubs, rituals, defaultRitual: 'web', defaultHub: 'madrid' };

const defaultRitual = rituals.find((ritual) => ritual.id === config.defaultRitual) ?? rituals[0];
---

<section class="rituals section" id="rituales" aria-labelledby="rituales-title">
  <div class="container rituals__inner">
    <SectionHeading
      eyebrow="Servicios"
      title="Elegí tu servicio"
      id="rituales-title"
    />

    <div class="rituals__intro">
      <svg class="rituals__intro-sparkle deco" viewBox="0 0 40 40" width="26" height="26" aria-hidden="true" focusable="false">
        <path d="M20 3c1.8 9.4 4.8 12.4 14.2 14.2C24.8 19 21.8 22 20 31.4 18.2 22 15.2 19 5.8 17.2 15.2 15.4 18.2 12.4 20 3Z" fill="#F7C566" stroke="#6C0345" stroke-width="1.6" stroke-linejoin="round" />
      </svg>

      <ol class="rituals__steps">
        <li class="rituals__step">
          <span class="rituals__step-badge">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2c1 5.4 2.6 7 8 8-5.4 1-7 2.6-8 8-1-5.4-2.6-7-8-8 5.4-1 7-2.6 8-8Z" />
            </svg>
            Paso 01
          </span>
          <span class="rituals__step-text">Indicá en qué ciudad está tu equipo</span>
        </li>
        <li class="rituals__step rituals__step--alt">
          <span class="rituals__step-badge">
            <svg viewBox="0 0 26 14" width="16" height="10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 8c6-5 13-6 20-2" />
              <path d="M20 2 22 6 17 7" />
            </svg>
            Paso 02
          </span>
          <span class="rituals__step-text">Elegí qué servicio o reunión necesitás coordinar</span>
        </li>
      </ol>
      <p class="rituals__intro-note">
        <span aria-hidden="true">✦</span> Con eso cruzo nuestros husos horarios en tiempo real y armamos una primera sesión de 30 minutos a medida.
      </p>

      <svg class="rituals__note-arrow deco" viewBox="0 0 90 60" width="72" height="48" fill="none" stroke="#DC6B19" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M10 8c22 3 38 16 44 34" />
        <path d="M47 37 54 42 57 33" />
      </svg>
    </div>

    <div class="rituals__stage">
      <span class="folder__tab folder__tab--terracotta rituals__tab">Propuesta en vivo</span>

      <svg class="rituals__star deco" viewBox="0 0 60 60" width="38" height="38" fill="none" stroke="#6C0345" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M30 5 37 23 56 23 41 34 47 53 30 41 13 53 19 34 4 23 23 23Z" />
        <path d="M30 16v18M22 30l8-6 8 6" opacity="0.5" />
      </svg>
      <svg class="rituals__heart deco" viewBox="0 0 40 36" width="24" height="22" fill="none" stroke="#DC6B19" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M20 31S5 21 5 12a7 7 0 0 1 15-2 7 7 0 0 1 15 2c0 9-15 19-15 19Z" />
      </svg>
      <span class="rituals__sync deco-highlighter" aria-hidden="true">Real-time sync</span>

      <div class="rituals__panel" data-rituals data-state="loading" aria-busy="true">
        <div class="rituals__bar">
          <span class="rituals__state" data-state-badge data-state="loading">
            <span class="rituals__state-dot" aria-hidden="true"></span>
            Cargando datos…
          </span>
          <p class="rituals__endpoint" aria-hidden="true">
            Open-Meteo · geocoding + zonas horarias · sin API key
          </p>
          <button class="rituals__offline" type="button" data-offline aria-pressed="false">
            Simular modo offline
          </button>
        </div>

        <form class="rituals__search" data-search-form role="search" novalidate>
          <label class="rituals__label" for="city-search">Paso 1 · ¿Dónde está tu equipo?</label>

          <div class="rituals__search-row">
            <div class="rituals__field">
              <input
                class="rituals__input"
                id="city-search"
                name="city"
                type="text"
                placeholder="Buscá una ciudad: Madrid, Tokio, Toronto…"
                autocomplete="off"
                spellcheck="false"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="city-results"
                data-city-input
              />
              <ul class="rituals__results" id="city-results" role="listbox" aria-label="Ciudades encontradas" data-results hidden></ul>
            </div>
            <button class="rituals__go" type="submit">Buscar</button>
          </div>

          <p class="rituals__hint" data-search-hint>Elegí un hub tecnológico o escribí cualquier ciudad del mundo:</p>

          <div class="rituals__hubs" data-hubs>
            {hubs.map((hub, index) => (
              <button
                class="rituals__hub"
                type="button"
                data-hub={index}
              >
                {hub.name}
              </button>
            ))}
          </div>
        </form>

        <!-- Estado 1: carga -->
        <div class="rituals__skeleton" data-region="loading" aria-label="Cargando datos del equipo">
          <span class="rituals__bone"></span>
          <span class="rituals__bone"></span>
          <span class="rituals__bone"></span>
        </div>

        <!-- Estado 4: vacío -->
        <div class="rituals__empty" data-region="empty" hidden>
          <h3>No encontramos esa ciudad</h3>
          <p data-empty-copy>
            Open-Meteo no devolvió resultados. Probá con otro nombre o volvé a
            los hubs sugeridos.
          </p>
          <button class="btn btn--primary" type="button" data-back-to-hubs>
            Volver a ciudades sugeridas
          </button>
        </div>

        <!-- Estado 5: error / fallback -->
        <div class="rituals__error" data-region="error" hidden role="alert">
          <h3>Se cortó la conexión con Open-Meteo</h3>
          <p data-error-copy>
            No pudimos traer la hora y la zona horaria en vivo. La herramienta no se
            rompe: podés reintentar o seguir con husos horarios de respaldo.
          </p>
          <div class="rituals__error-actions">
            <button class="btn btn--primary" type="button" data-retry>Reintentar conexión</button>
            <button class="btn btn--ghost" type="button" data-fallback>Usar husos de respaldo</button>
          </div>
        </div>

        <!-- Estados 2 y 3: contenido / selección -->
        <div class="rituals__success" data-region="success" hidden>
          <div class="rituals__cities">
            <article class="rituals__city rituals__city--base" aria-label="Estado actual en Buenos Aires">
              <p class="rituals__city-tag">Mi base</p>
              <h3 class="rituals__city-name">Buenos Aires</h3>
              <p class="rituals__city-time" data-base-time>--:--</p>
              <p class="rituals__city-meta">
                <span data-base-tz>ART</span> · <span data-base-offset>UTC−3</span>
              </p>
            </article>

            <div class="rituals__bridge" aria-hidden="true">
              <span data-diff>—</span>
              <small>diferencia</small>
            </div>

            <article class="rituals__city rituals__city--team" aria-label="Estado actual en la ciudad del equipo">
              <p class="rituals__city-tag">Ciudad del equipo</p>
              <h3 class="rituals__city-name" data-team-name>Elegí una ciudad</h3>
              <p class="rituals__city-time" data-team-time>--:--</p>
              <p class="rituals__city-meta">
                <span data-team-tz>—</span> · <span data-team-offset>—</span>
              </p>
            </article>
          </div>

          <fieldset class="rituals__fieldset">
            <legend class="rituals__label">Paso 2 · ¿En qué necesitás ayuda?</legend>
            <div class="rituals__rituals" role="group" aria-label="Servicios de diseño">
              {rituals.map((ritual) => (
                <button
                  class={`rituals__ritual rituals__ritual--${ritual.tone}`}
                  type="button"
                  data-ritual={ritual.id}
                  aria-pressed={ritual.id === config.defaultRitual ? 'true' : 'false'}
                >
                  <span class="rituals__ritual-name">{ritual.label}</span>
                  <span class="rituals__ritual-meta">{ritual.meta}</span>
                  <span class="rituals__ritual-state">
                    {ritual.id === config.defaultRitual ? 'Seleccionado' : 'Ver propuesta'}
                  </span>
                </button>
              ))}
            </div>
            <p class="rituals__ritual-detail" data-ritual-detail>
              {defaultRitual.detail}
            </p>
          </fieldset>

          <section class="rituals__proposal" data-proposal-card data-verdict="sync">
            <div class="rituals__proposal-head">
              <p class="rituals__proposal-badge" data-verdict-badge data-verdict="sync">
                <span class="rituals__proposal-dot" aria-hidden="true"></span>
                <span data-verdict-label>Reunión inicial</span>
              </p>
              <p class="rituals__proposal-goal" data-proposal-goal>{defaultRitual.goal}</p>
            </div>

            <h3 class="rituals__proposal-title" data-proposal-title>{defaultRitual.label}</h3>
            <p class="rituals__proposal-text" data-proposal>{defaultRitual.proposal}</p>

            <dl class="rituals__proposal-facts">
              <div class="rituals__fact">
                <dt>Duración</dt>
                <dd data-brief-duration>{defaultRitual.minutes} min</dd>
              </div>
              <div class="rituals__fact">
                <dt>Mejor horario</dt>
                <dd data-brief-slot>—</dd>
              </div>
              <div class="rituals__fact">
                <dt>Horas en común</dt>
                <dd data-brief-overlap>—</dd>
              </div>
            </dl>

            <div class="rituals__proposal-body">
              <div class="rituals__proposal-block">
                <p class="rituals__proposal-label">Cómo lo abordaría</p>
                <ol class="rituals__agenda-list" data-agenda-list>
                  {defaultRitual.agenda.map((item) => (
                    <li>{item}</li>
                  ))}
                </ol>
              </div>
              <div class="rituals__proposal-block rituals__proposal-block--outcome">
                <p class="rituals__proposal-label">Entregable</p>
                <p class="rituals__proposal-outcome" data-outcome>{defaultRitual.outcome}</p>
              </div>
            </div>

            <div class="rituals__proposal-footer">
              <p class="rituals__proposal-note" data-verdict-copy>
                Es una primera conversación sin compromiso: entiendo tu proyecto y te digo cómo lo encararía.
              </p>
              <a class="rituals__cta" data-meeting-cta data-email={site.email} href={`mailto:${site.email}`}>
                Agendar la reunión
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </section>
        </div>
      </div>
    </div>

    <p class="rituals__source">
      <span class="rituals__source-mark" aria-hidden="true">✦</span>
      Sincronización en tiempo real conectada a la API de
      <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo</a>
      (geocoding y husos horarios). Tus búsquedas son 100% privadas y no se
      almacenan datos. Si querés coordinar el encuentro, presioná el botón
      <strong>Agendar la reunión</strong>.
    </p>

    <p class="visually-hidden" role="status" aria-live="polite" data-live></p>
  </div>
</section>

<script
  type="application/json"
  id="rituals-config"
  is:inline
  set:html={JSON.stringify(config)}
></script>

<script>
  type Hub = {
    id: string;
    name: string;
    country: string;
    lat: number;
    lon: number;
    timezone?: string;
    abbreviation?: string;
  };

  type Ritual = {
    id: string;
    label: string;
    short: string;
    goal: string;
    meta: string;
    minutes: number;
    sync: number;
    tone: string;
    detail: string;
    proposal: string;
    agenda: string[];
    outcome: string;
  };

  type CityInfo = {
    name: string;
    country: string;
    lat: number;
    lon: number;
    timezone?: string;
    abbreviation: string;
    utcOffsetSeconds: number;
  };

  type Config = {
    baseCity: Hub;
    hubs: Hub[];
    rituals: Ritual[];
    defaultRitual: string;
    defaultHub: string;
  };

  type Plan = {
    diffSeconds: number;
    diffMin: number;
    overlapStart: number;
    overlapEnd: number;
    overlapMinutes: number;
    overlapHours: number;
    ritual: Ritual;
    score: number;
    verdict: 'sync' | 'hybrid' | 'async';
    slot: { startBA: number; endBA: number; startTeam: number; endTeam: number } | null;
    inBaseHours: boolean;
    inTeamHours: boolean;
  };

  const WORK_START = 9 * 60;
  const WORK_END = 18 * 60;
  const DAY = 24 * 60;

  const panel = document.querySelector<HTMLElement>('[data-rituals]');
  const configElement = document.getElementById('rituals-config');

  if (panel && configElement) {
    const config = JSON.parse(configElement.textContent ?? '{}') as Config;
    const rituals = config.rituals;
    const hubs = config.hubs;

    const find = <T extends Element = HTMLElement>(selector: string) =>
      panel.querySelector<T>(selector);

    const input = find<HTMLInputElement>('[data-city-input]');
    const form = find<HTMLFormElement>('[data-search-form]');
    const resultsList = find<HTMLUListElement>('[data-results]');
    const searchHint = find<HTMLElement>('[data-search-hint]');
    const stateBadge = find<HTMLElement>('[data-state-badge]');
    const live = document.querySelector<HTMLElement>('[data-live]');
    const offlineButton = find<HTMLButtonElement>('[data-offline]');
    const backToHubsButton = find<HTMLButtonElement>('[data-back-to-hubs]');
    const retryButton = find<HTMLButtonElement>('[data-retry]');
    const fallbackButton = find<HTMLButtonElement>('[data-fallback]');
    const emptyCopy = find<HTMLElement>('[data-empty-copy]');
    const errorCopy = find<HTMLElement>('[data-error-copy]');

    const regions = {
      loading: find<HTMLElement>('[data-region="loading"]'),
      empty: find<HTMLElement>('[data-region="empty"]'),
      error: find<HTMLElement>('[data-region="error"]'),
      success: find<HTMLElement>('[data-region="success"]'),
    };

    const baseTime = find<HTMLElement>('[data-base-time]');
    const baseTz = find<HTMLElement>('[data-base-tz]');
    const baseOffset = find<HTMLElement>('[data-base-offset]');

    const teamName = find<HTMLElement>('[data-team-name]');
    const teamTime = find<HTMLElement>('[data-team-time]');
    const teamTz = find<HTMLElement>('[data-team-tz]');
    const teamOffset = find<HTMLElement>('[data-team-offset]');
    const diffLabel = find<HTMLElement>('[data-diff]');

    const proposalCard = find<HTMLElement>('[data-proposal-card]');
    const verdictBadge = find<HTMLElement>('[data-verdict-badge]');
    const verdictLabel = find<HTMLElement>('[data-verdict-label]');
    const verdictCopy = find<HTMLElement>('[data-verdict-copy]');
    const proposalGoal = find<HTMLElement>('[data-proposal-goal]');
    const proposalTitle = find<HTMLElement>('[data-proposal-title]');
    const proposalText = find<HTMLElement>('[data-proposal]');
    const proposalOutcome = find<HTMLElement>('[data-outcome]');
    const briefDuration = find<HTMLElement>('[data-brief-duration]');
    const briefSlot = find<HTMLElement>('[data-brief-slot]');
    const briefOverlap = find<HTMLElement>('[data-brief-overlap]');
    const ritualDetail = find<HTMLElement>('[data-ritual-detail]');
    const agendaList = find<HTMLElement>('[data-agenda-list]');
    const meetingCta = find<HTMLAnchorElement>('[data-meeting-cta]');
    const ritualButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-ritual]'));
    const hubButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-hub]'));

    const STATE_LABELS: Record<string, string> = {
      loading: 'Cargando datos…',
      success: 'Contenido disponible',
      selected: 'Servicio seleccionado',
      empty: 'Sin resultados',
      error: 'Error de conexión',
    };

    const VERDICTS = {
      sync: {
        label: 'Reunión inicial',
        copy: 'Hay una franja cómoda para ambos: coordinemos ahí y cerremos los próximos pasos en la reunión.',
      },
      hybrid: {
        label: 'Reunión inicial',
        copy: 'Podemos reunirnos en una franja corta y dejar el resto por escrito para no forzar horarios.',
      },
      async: {
        label: 'Reunión inicial',
        copy: 'No hay una franja cómoda hoy: coordinemos un horario que funcione para ambos.',
      },
    } as const;

    let base: CityInfo | null = null;
    let team: CityInfo | null = null;
    let currentCity: Hub = hubs.find((hub) => hub.id === config.defaultHub) ?? hubs[0];
    let selectedRitual = config.defaultRitual;
    let simulateOffline = false;
    let lastResults: Hub[] = [];
    let searchTimer = 0;
    let searchSeq = 0;
    let loadSeq = 0;

    const pad = (value: number) => String(value).padStart(2, '0');

    const formatClock = (offsetSeconds: number, now = Date.now()) => {
      const date = new Date(now + offsetSeconds * 1000);
      return `${pad(date.getUTCHours())}:${pad(date.getUTCMinutes())}`;
    };

    const minutesOfDay = (offsetSeconds: number, now = Date.now()) => {
      const date = new Date(now + offsetSeconds * 1000);
      return date.getUTCHours() * 60 + date.getUTCMinutes();
    };

    const formatMinutes = (totalMinutes: number) => {
      const normalized = ((Math.round(totalMinutes) % DAY) + DAY) % DAY;
      return `${pad(Math.floor(normalized / 60))}:${pad(normalized % 60)}`;
    };

    const offsetLabel = (seconds: number) => {
      const sign = seconds >= 0 ? '+' : '−';
      const abs = Math.abs(seconds);
      const hours = Math.floor(abs / 3600);
      const minutes = Math.round((abs % 3600) / 60);
      return `UTC${sign}${hours}${minutes ? `:${pad(minutes)}` : ''}`;
    };

    const diffLabelText = (seconds: number) => {
      const totalMinutes = Math.round(seconds / 60);
      const sign = totalMinutes >= 0 ? '+' : '−';
      const abs = Math.abs(totalMinutes);
      const hours = Math.floor(abs / 60);
      const minutes = abs % 60;
      if (hours === 0) return `${sign}${minutes} min`;
      return minutes === 0 ? `${sign}${hours} h` : `${sign}${hours} h ${minutes} min`;
    };

    const setText = (element: Element | null, value: string) => {
      if (element) element.textContent = value;
    };

    const setState = (state: keyof typeof STATE_LABELS, message?: string) => {
      panel.dataset.state = state;
      panel.setAttribute('aria-busy', String(state === 'loading'));

      if (stateBadge) {
        stateBadge.dataset.state = state;
        stateBadge.innerHTML = '';
        const dot = document.createElement('span');
        dot.className = 'rituals__state-dot';
        dot.setAttribute('aria-hidden', 'true');
        stateBadge.append(dot, document.createTextNode(STATE_LABELS[state] ?? state));
      }

      regions.loading.hidden = state !== 'loading';
      regions.empty.hidden = state !== 'empty';
      regions.error.hidden = state !== 'error';
      regions.success.hidden = state !== 'success' && state !== 'selected';

      if (message) setText(live, message);

      if (state === 'success' || state === 'selected') renderPlan();
    };

    const showError = (message: string) => {
      setText(errorCopy, message);
      setState('error', message);
    };

    const zoneOffsetSeconds = (timeZone: string, now = Date.now()): number | null => {
      try {
        const formatter = new Intl.DateTimeFormat('en-US', {
          timeZone,
          timeZoneName: 'longOffset',
        });
        const part = formatter
          .formatToParts(new Date(now))
          .find((item) => item.type === 'timeZoneName');
        const match = part?.value.match(/GMT([+-])(\d{1,2})(?::(\d{2}))?/);
        if (!match) return null;
        const sign = match[1] === '-' ? -1 : 1;
        return sign * (Number(match[2]) * 3600 + Number(match[3] ?? 0) * 60);
      } catch {
        return null;
      }
    };

    const fetchForecast = async (city: Hub): Promise<CityInfo> => {
      if (simulateOffline) throw new Error('offline-simulado');

      const url = new URL('https://api.open-meteo.com/v1/forecast');
      url.searchParams.set('latitude', String(city.lat));
      url.searchParams.set('longitude', String(city.lon));
      url.searchParams.set('timezone', city.timezone ?? 'auto');

      const response = await fetch(url.toString());
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const data = await response.json();

      return {
        name: city.name,
        country: city.country ?? '',
        lat: city.lat,
        lon: city.lon,
        timezone: city.timezone,
        abbreviation: data?.timezone_abbreviation ?? 'LOCAL',
        utcOffsetSeconds:
          typeof data?.utc_offset_seconds === 'number'
            ? data.utc_offset_seconds
            : (zoneOffsetSeconds(city.timezone ?? 'UTC') ?? 0),
      };
    };

    const geocode = async (query: string): Promise<Hub[]> => {
      if (simulateOffline) throw new Error('offline-simulado');

      const url = new URL('https://geocoding-api.open-meteo.com/v1/search');
      url.searchParams.set('name', query);
      url.searchParams.set('count', '5');
      url.searchParams.set('language', 'es');
      url.searchParams.set('format', 'json');

      const response = await fetch(url.toString());
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const data = await response.json();
      const results = Array.isArray(data?.results) ? data.results : [];

      return results.map((item: Record<string, unknown>) => ({
        id: String(item.id ?? `${item.latitude}-${item.longitude}`),
        name: String(item.name ?? query),
        country: String(item.country ?? ''),
        lat: Number(item.latitude),
        lon: Number(item.longitude),
      }));
    };

    const fallbackCity = (city: Hub): CityInfo => {
      const known = city.timezone ? zoneOffsetSeconds(city.timezone) : null;
      const estimated = Math.round(city.lon / 15) * 3600;
      const offset = known ?? estimated;
      return {
        name: city.name,
        country: city.country ?? '',
        lat: city.lat,
        lon: city.lon,
        timezone: city.timezone,
        abbreviation: city.abbreviation ?? offsetLabel(offset),
        utcOffsetSeconds: offset,
      };
    };

    const hideResults = () => {
      if (!resultsList) return;
      resultsList.hidden = true;
      resultsList.innerHTML = '';
      lastResults = [];
      input?.setAttribute('aria-expanded', 'false');
    };

    const chooseCity = (city: Hub) => {
      currentCity = city;
      if (input) input.value = city.name;
      hideResults();
      void loadTeam(city);
    };

    const renderResults = (results: Hub[]) => {
      if (!resultsList) return;
      lastResults = results;
      resultsList.innerHTML = '';

      results.forEach((result) => {
        const item = document.createElement('li');
        item.className = 'rituals__result';
        item.setAttribute('role', 'option');
        item.tabIndex = -1;

        const strong = document.createElement('strong');
        strong.textContent = result.name;

        const span = document.createElement('span');
        const place = [result.country].filter(Boolean).join('');
        span.textContent = place || 'Ciudad';

        item.append(strong, span);
        item.addEventListener('click', () => chooseCity(result));
        item.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            chooseCity(result);
          }
          if (event.key === 'Escape') {
            hideResults();
            input?.focus();
          }
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            const options = Array.from(
              resultsList.querySelectorAll<HTMLElement>('[role="option"]'),
            );
            const index = options.indexOf(item);
            const next = event.key === 'ArrowDown' ? options[index + 1] : options[index - 1];
            next?.focus();
          }
        });

        resultsList.appendChild(item);
      });

      resultsList.hidden = false;
      input?.setAttribute('aria-expanded', 'true');
      setText(searchHint, `${results.length} resultado(s). Elegí una ciudad para calcular el solapamiento.`);
    };

    const showEmpty = (query: string) => {
      hideResults();
      setText(
        emptyCopy,
        `Open-Meteo no encontró “${query}”. Probá con el nombre en español, sin abreviaturas, o volvé a los hubs sugeridos.`,
      );
      setState('empty', `Sin resultados para ${query}.`);
    };

    const renderCityClock = (city: CityInfo) => ({
      time: formatClock(city.utcOffsetSeconds),
      tz: city.abbreviation,
      offset: offsetLabel(city.utcOffsetSeconds),
    });

    const buildPlan = (): Plan | null => {
      if (!base || !team) return null;

      const diffSeconds = team.utcOffsetSeconds - base.utcOffsetSeconds;
      const diffMin = diffSeconds / 60;
      const overlapStart = Math.max(WORK_START, WORK_START - diffMin);
      const overlapEnd = Math.min(WORK_END, WORK_END - diffMin);
      const overlapMinutes = Math.max(0, overlapEnd - overlapStart);
      const overlapHours = overlapMinutes / 60;

      const ritual = rituals.find((item) => item.id === selectedRitual) ?? rituals[0];

      const now = Date.now();
      const baseMinutes = minutesOfDay(base.utcOffsetSeconds, now);
      const teamMinutes = minutesOfDay(team.utcOffsetSeconds, now);
      const inBaseHours = baseMinutes >= WORK_START && baseMinutes < WORK_END;
      const inTeamHours = teamMinutes >= WORK_START && teamMinutes < WORK_END;
      const outsideBoth = !inBaseHours && !inTeamHours;

      const overlapScore = (overlapHours / 9) * 55;
      const ritualScore = ritual.sync * 25 * Math.min(1, overlapHours / 2);
      const hourScore = inBaseHours && inTeamHours ? 20 : inBaseHours || inTeamHours ? 10 : 0;

      let score = Math.round(overlapScore + ritualScore + hourScore);
      if (overlapMinutes <= 0) score = Math.min(score, 30);
      score = Math.max(0, Math.min(100, score));

      let verdict: Plan['verdict'];
      if (overlapMinutes <= 0 || outsideBoth) verdict = 'async';
      else if (score >= 60) verdict = 'sync';
      else if (score >= 35) verdict = 'hybrid';
      else verdict = 'async';

      let slot: Plan['slot'] = null;
      if (overlapMinutes >= ritual.minutes) {
        const earliest = overlapStart;
        const latest = overlapEnd - ritual.minutes;
        const preferred = Math.max(earliest, 10 * 60);
        const startBA = Math.min(preferred, latest);
        slot = {
          startBA,
          endBA: startBA + ritual.minutes,
          startTeam: startBA + diffMin,
          endTeam: startBA + ritual.minutes + diffMin,
        };
      }

      return {
        diffSeconds,
        diffMin,
        overlapStart,
        overlapEnd,
        overlapMinutes,
        overlapHours,
        ritual,
        score,
        verdict,
        slot,
        inBaseHours,
        inTeamHours,
      };
    };

    const renderPlan = () => {
      const plan = buildPlan();
      if (!plan || !base || !team) return;

      const baseView = renderCityClock(base);
      const teamView = renderCityClock(team);

      setText(baseTime, baseView.time);
      setText(baseTz, baseView.tz);
      setText(baseOffset, baseView.offset);

      setText(teamName, team.name);
      setText(teamTime, teamView.time);
      setText(teamTz, teamView.tz);
      setText(teamOffset, teamView.offset);

      setText(diffLabel, diffLabelText(plan.diffSeconds));

      const verdict = VERDICTS[plan.verdict];
      verdictBadge?.setAttribute('data-verdict', plan.verdict);
      proposalCard?.setAttribute('data-verdict', plan.verdict);
      setText(verdictLabel, verdict.label);
      setText(verdictCopy, verdict.copy);

      setText(proposalGoal, plan.ritual.goal);
      setText(proposalTitle, plan.ritual.label);
      setText(proposalText, plan.ritual.proposal);
      setText(proposalOutcome, plan.ritual.outcome);
      setText(ritualDetail, plan.ritual.detail);

      if (meetingCta) {
        const email = meetingCta.dataset.email ?? '';
        const subject = `Reunión inicial · ${plan.ritual.label}`;
        const bodyLines = [
          `Hola Abril, me interesa ${plan.ritual.label.toLowerCase()}.`,
          plan.slot
            ? `Me viene bien ${formatMinutes(plan.slot.startBA)} en Buenos Aires (${formatMinutes(plan.slot.startTeam)} en ${team.name}).`
            : '¿Qué horario te queda cómodo?',
          '',
          'Gracias.',
        ];
        meetingCta.setAttribute(
          'href',
          `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`,
        );
      }

      setText(briefDuration, `${plan.ritual.minutes} min`);
      setText(
        briefOverlap,
        plan.overlapMinutes > 0
          ? `${plan.overlapHours.toFixed(plan.overlapHours % 1 === 0 ? 0 : 1)} h`
          : 'Sin ventana hoy',
      );

      if (plan.slot && plan.verdict !== 'async') {
        setText(
          briefSlot,
          `${formatMinutes(plan.slot.startBA)}–${formatMinutes(plan.slot.endBA)} en Buenos Aires · ${formatMinutes(plan.slot.startTeam)}–${formatMinutes(plan.slot.endTeam)} en ${team.name}`,
        );
      } else if (plan.overlapMinutes > 0) {
        setText(briefSlot, `No entra un bloque de ${plan.ritual.minutes} min`);
      } else {
        setText(briefSlot, 'Sin franja compartida');
      }

      if (agendaList) {
        agendaList.innerHTML = '';
        plan.ritual.agenda.forEach((item) => {
          const li = document.createElement('li');
          li.textContent = item;
          agendaList.appendChild(li);
        });
      }
    };

    const loadTeam = async (city: Hub) => {
      currentCity = city;
      const seq = ++loadSeq;

      if (simulateOffline) {
        showError(
          'Modo offline simulado: la calculadora sigue respondiendo con el estado de error. Usá “Reintentar conexión” para volver a la API real o “Usar husos de respaldo”.',
        );
        return;
      }

      setState('loading');
      setText(searchHint, `Consultando Open-Meteo para ${city.name}…`);

      try {
        const [baseData, teamData] = await Promise.all([
          fetchForecast(config.baseCity),
          fetchForecast(city),
        ]);

        if (seq !== loadSeq) return;

        base = baseData;
        team = teamData;

        setState(
          'success',
          `Ciudad cargada: ${team.name}. Diferencia horaria de ${diffLabelText(team.utcOffsetSeconds - base.utcOffsetSeconds)}.`,
        );
        setText(searchHint, 'Elegí un hub tecnológico o escribí cualquier ciudad del mundo:');
      } catch (error) {
        if (seq !== loadSeq) return;
        const detail = error instanceof Error ? error.message : 'error desconocido';
        showError(
          `No pudimos traer los datos en vivo (${detail}). Podés reintentar la conexión o continuar con husos horarios de respaldo para que la calculadora nunca deje de funcionar.`,
        );
      }
    };

    const renderOfflineButton = () => {
      if (!offlineButton) return;
      offlineButton.setAttribute('aria-pressed', String(simulateOffline));
      offlineButton.textContent = simulateOffline ? 'Offline activo · desactivar' : 'Simular modo offline';
    };

    offlineButton?.addEventListener('click', () => {
      simulateOffline = !simulateOffline;
      renderOfflineButton();
      if (simulateOffline) {
        void loadTeam(currentCity);
      } else if (currentCity) {
        void loadTeam(currentCity);
      }
    });

    retryButton?.addEventListener('click', () => {
      simulateOffline = false;
      renderOfflineButton();
      void loadTeam(currentCity);
    });

    fallbackButton?.addEventListener('click', () => {
      base = fallbackCity(config.baseCity);
      team = fallbackCity(currentCity);
      setState(
        'success',
        `Modo de respaldo activo para ${currentCity.name}. Husos calculados localmente.`,
      );
    });

    backToHubsButton?.addEventListener('click', () => {
      if (input) input.value = '';
      hideResults();
      setText(searchHint, 'Elegí un hub tecnológico o escribí cualquier ciudad del mundo:');
      if (base && team) setState('success');
      else void loadTeam(currentCity);
    });

    hubButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number(button.dataset.hub);
        const hub = hubs[index];
        if (!hub) return;
        if (input) input.value = hub.name;
        hideResults();
        void loadTeam(hub);
      });
    });

    ritualButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.dataset.ritual;
        if (!id) return;
        selectedRitual = id;
        ritualButtons.forEach((item) => {
          item.setAttribute('aria-pressed', String(item.dataset.ritual === id));
          const stateLabel = item.querySelector<HTMLElement>('.rituals__ritual-state');
          if (stateLabel) {
            stateLabel.textContent =
              item.dataset.ritual === id ? 'Seleccionado' : 'Ver propuesta';
          }
        });
        setState('selected', `Servicio seleccionado: ${id}. Propuesta actualizada.`);
      });
    });

    input?.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      const query = input.value.trim();

      if (query.length < 2) {
        searchSeq += 1;
        hideResults();
        setText(searchHint, 'Elegí un hub tecnológico o escribí cualquier ciudad del mundo:');
        return;
      }

      const seq = ++searchSeq;
      setText(searchHint, `Buscando “${query}” en Open-Meteo…`);
      searchTimer = window.setTimeout(() => {
        void searchCities(query, seq);
      }, 380);
    });

    const searchCities = async (query: string, seq: number) => {
      try {
        const results = await geocode(query);
        if (seq !== searchSeq) return;
        if (results.length === 0) {
          showEmpty(query);
          return;
        }
        if (panel.dataset.state === 'empty') {
          setState(base && team ? 'success' : 'loading');
        }
        renderResults(results);
      } catch {
        if (seq !== searchSeq) return;
        showError(
          'No pudimos consultar el buscador de ciudades. Revisá la conexión o usá los hubs sugeridos mientras tanto.',
        );
      }
    };

    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        hideResults();
        return;
      }
      if (
        (event.key === 'ArrowDown' || event.key === 'ArrowUp') &&
        resultsList &&
        !resultsList.hidden
      ) {
        event.preventDefault();
        const options = Array.from(
          resultsList.querySelectorAll<HTMLElement>('[role="option"]'),
        );
        const target = event.key === 'ArrowDown' ? options[0] : options[options.length - 1];
        target?.focus();
      }
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input?.value.trim();
      if (!query) return;

      if (lastResults.length > 0) {
        chooseCity(lastResults[0]);
        return;
      }

      const seq = ++searchSeq;
      void (async () => {
        try {
          const results = await geocode(query);
          if (seq !== searchSeq) return;
          if (results.length > 0) chooseCity(results[0]);
          else showEmpty(query);
        } catch {
          if (seq !== searchSeq) return;
          showError(
            'No pudimos consultar el buscador de ciudades. Revisá la conexión o usá los hubs sugeridos mientras tanto.',
          );
        }
      })();
    });

    /* Reloj vivo: refresca las horas y la propuesta cada 30 segundos. */
    window.setInterval(() => {
      const state = panel.dataset.state;
      if (state !== 'success' && state !== 'selected') return;
      renderPlan();
    }, 30000);

    renderOfflineButton();
    void loadTeam(currentCity);
  }
</script>

