---
import SectionHeading from './SectionHeading.astro';

const examples = ['Billie Eilish', 'Tini', 'Dua Lipa', 'Bad Bunny', 'Taylor Swift'];
---

<section class="album-lab section section--alt" id="identidad" aria-labelledby="identidad-title">
  <div class="container">
    <SectionHeading
      eyebrow="Laboratorio de identidad"
      title="Manual de identidad instantáneo: de una portada a un sistema visual"
      description="Buscá un artista, elegí un álbum y mirá cómo una portada se convierte en paleta, tipografía y reglas de uso. Un ejercicio de design systems aplicado a música."
      id="identidad-title"
    />

    <div class="album-lab__why">
      <div class="album-lab__why-head">
        <p class="album-lab__why-eyebrow">Un ejemplo de mi trabajo</p>
        <h3>Un ejemplo de lo que hago: leer una identidad y convertirla en un sistema aplicable.</h3>
        <p>
          Esta sección es una muestra acotada de mi trabajo. Uso los álbumes como caso de
          ejemplo para mostrar un proceso que aplico a cualquier identidad: leerla, extraer
          una paleta, elegir tipografía y traducirla en decisiones que otro equipo podría
          usar. El mismo proceso sirve para una marca, un packaging o una interfaz; los
          álbumes son el punto de partida, no el límite de lo que hago.
        </p>
      </div>

      <div class="album-lab__why-grid">
        <article class="album-lab__why-card">
          <span class="album-lab__why-number">01</span>
          <h4>Leer una identidad existente</h4>
          <p>
            La paleta no se inventa: se extrae de la portada. El primer paso es observar qué
            colores sostienen la imagen y cuáles funcionan como acento.
          </p>
        </article>
        <article class="album-lab__why-card">
          <span class="album-lab__why-number">02</span>
          <h4>Traducir a sistema</h4>
          <p>
            Colores, tipografía, jerarquía y aplicaciones. El manual convierte una pieza
            única en reglas reutilizables, igual que un design system.
          </p>
        </article>
        <article class="album-lab__why-card">
          <span class="album-lab__why-number">03</span>
          <h4>Hacer visible el criterio</h4>
          <p>
            Cada decisión queda a la vista: de dónde sale cada color, por qué elegí esa
            tipografía y qué parte es interpretación. Mostrar el proceso también es parte del
            trabajo.
          </p>
        </article>
      </div>
    </div>

    <div class="album-lab__panel" data-album-lab data-state="loading" aria-busy="true">
      <div class="album-lab__statusbar">
        <span class="album-lab__badge" data-badge data-state="loading">
          <span class="album-lab__badge-dot" aria-hidden="true"></span>
          <span data-badge-text>Buscando álbumes…</span>
        </span>
        <code class="album-lab__endpoint">GET itunes.apple.com/search?term=…&amp;entity=album</code>
      </div>

      <form class="album-lab__search" data-search-form>
        <label class="album-lab__search-label" for="album-search">Buscá un artista o una banda</label>
        <div class="album-lab__search-row">
          <input
            class="album-lab__input"
            id="album-search"
            name="artist"
            type="search"
            placeholder="Billie Eilish, Tini, Dua Lipa…"
            autocomplete="off"
            minlength="2"
            required
            data-search-input
            aria-describedby="album-search-hint"
          />
          <button class="btn btn--primary" type="submit">Buscar álbumes</button>
        </div>
        <div class="album-lab__examples" id="album-search-hint">
          <span>Probá con:</span>
          {examples.map((example) => (
            <button class="album-lab__example" type="button" data-example={example}>
              {example}
            </button>
          ))}
        </div>
      </form>

      <p class="album-lab__status" role="status" aria-live="polite" data-status>
        Consultando iTunes Search API…
      </p>

      <div class="album-lab__loading" data-loading aria-hidden="true">
        {[0, 1, 2, 3, 4, 5].map(() => (
          <div class="album-lab__skeleton"></div>
        ))}
      </div>

      <div class="album-lab__content" data-content hidden>
        <div class="album-lab__results-head">
          <div>
            <p class="album-lab__results-eyebrow">Resultados</p>
            <h3 data-results-title>Álbumes encontrados</h3>
          </div>
          <span class="album-lab__results-count" data-results-count></span>
        </div>

        <ul class="album-lab__grid" data-grid aria-label="Álbumes encontrados"></ul>

        <div class="album-lab__manual" data-manual data-state="loading">
          <div class="album-lab__manual-loading" data-manual-loading>
            <div class="album-lab__skeleton album-lab__skeleton--cover"></div>
            <div class="album-lab__manual-loading-body">
              <div class="album-lab__skeleton album-lab__skeleton--line"></div>
              <div class="album-lab__skeleton album-lab__skeleton--line"></div>
              <div class="album-lab__skeleton album-lab__skeleton--line album-lab__skeleton--short"></div>
            </div>
          </div>

          <div class="album-lab__manual-content" data-manual-content hidden>
            <div class="album-lab__manual-cover-wrap">
              <img class="album-lab__cover" data-cover alt="" width="600" height="600" />
              <div class="album-lab__cover-meta">
                <p data-album-artist></p>
                <h3 data-album-title></h3>
                <p data-album-meta></p>
                <a
                  class="album-lab__album-link"
                  data-album-link
                  href="https://music.apple.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Ver en Apple Music
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            <div class="album-lab__manual-body">
              <div class="album-lab__manual-head">
                <p class="album-lab__manual-eyebrow">Manual instantáneo</p>
                <h3>Identidad interpretada</h3>
                <p data-manual-note>
                  Paleta extraída de la portada y tipografía curada según el género. No es el
                  manual oficial de la discográfica.
                </p>
              </div>

              <div class="album-lab__block">
                <div class="album-lab__block-head">
                  <h4>Paleta extraída</h4>
                  <button class="album-lab__copy" type="button" data-copy-tokens>
                    Copiar tokens CSS
                  </button>
                </div>
                <div class="album-lab__palette-strip" data-palette-strip aria-hidden="true"></div>
                <div class="album-lab__palette" data-palette></div>
              </div>

              <div class="album-lab__block">
                <h4>Tipografía</h4>
                <div class="album-lab__type">
                  <div>
                    <span>Display</span>
                    <strong data-type-display></strong>
                  </div>
                  <div>
                    <span>Lectura</span>
                    <strong data-type-body></strong>
                  </div>
                </div>
                <p class="album-lab__type-note" data-type-note></p>
                <div class="album-lab__type-sample">
                  <p class="album-lab__type-sample-title" data-type-sample-title></p>
                  <p class="album-lab__type-sample-body" data-type-sample-body></p>
                </div>
              </div>

              <div class="album-lab__block album-lab__analysis-block">
                <div class="album-lab__block-head">
                  <h4>Análisis de diseño</h4>
                  <span class="album-lab__analysis-tag">Lectura personal</span>
                </div>
                <div class="album-lab__analysis" data-analysis></div>
                <p class="album-lab__tone" data-tone></p>
              </div>

              <div class="album-lab__block">
                <h4>Aplicaciones</h4>
                <ul class="album-lab__applications" data-applications></ul>
              </div>

              <div class="album-lab__block">
                <h4>Tokens CSS</h4>
                <pre class="album-lab__tokens"><code data-tokens></code></pre>
              </div>
            </div>

            <div class="album-lab__preview-wrap">
              <p class="album-lab__preview-label">Vista aplicada</p>
              <div class="album-lab__preview" data-preview>
                <div class="album-lab__preview-top">
                  <span>Manual instantáneo</span>
                  <span>01 / 05</span>
                </div>
                <p class="album-lab__preview-kicker" data-preview-artist></p>
                <h4 class="album-lab__preview-title" data-preview-title></h4>
                <p class="album-lab__preview-body" data-preview-body></p>
                <div class="album-lab__preview-palette" data-preview-palette aria-hidden="true"></div>
                <p class="album-lab__preview-footer">Abril Mancuso · Design system</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="album-lab__empty" data-empty hidden>
        <p class="album-lab__empty-title" data-empty-title>No encontramos álbumes.</p>
        <p class="album-lab__empty-message" data-empty-message>
          Probá con otro artista o usá el set de ejemplo.
        </p>
        <div class="album-lab__actions">
          <button class="btn btn--primary" type="button" data-retry>Reintentar búsqueda</button>
          <button class="btn btn--ghost" type="button" data-fallback>Ver set de ejemplo</button>
        </div>
      </div>

      <div class="album-lab__error" data-error hidden>
        <p class="album-lab__error-title" data-error-title>No fue posible buscar álbumes.</p>
        <p class="album-lab__error-message" data-error-message></p>
        <div class="album-lab__actions">
          <button class="btn btn--primary" type="button" data-retry>Reintentar búsqueda</button>
          <button class="btn btn--ghost" type="button" data-fallback>Ver set de ejemplo</button>
        </div>
      </div>

      <p class="album-lab__copy-status" role="status" aria-live="polite" data-copy-status></p>
    </div>

    <div class="album-lab__footer">
      <div>
        <p>
          <strong>Cómo leerlo:</strong> el manual parte de una portada real, extrae su paleta y
          propone una tipografía. La decisión de diseño está en qué se conserva, qué se traduce
          y qué se descarta.
        </p>
        <p>
          <strong>Límite:</strong> iTunes Search API no devuelve la tipografía original del
          álbum. La dupla tipográfica es una recomendación curada, no una reconstrucción exacta.
        </p>
      </div>
      <a
        class="album-lab__footer-link"
        href="https://developer.apple.com/library/archive/documentation/AudioVideo/Conceptual/iTuneSearchAPI/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Documentación de la API
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <noscript>
      <style is:inline>
        [data-album-lab] {
          display: none;
        }
      </style>
      <p class="album-lab__noscript">
        Activá JavaScript para buscar álbumes y generar el manual de identidad en vivo.
        <a href="https://music.apple.com/" target="_blank" rel="noopener noreferrer"
          >Ver Apple Music directamente</a
        >.
      </p>
    </noscript>
  </div>
</section>

<script>
  import {
    ALBUM_LIMIT,
    ITUNES_SEARCH_URL,
    SEARCH_TIMEOUT,
    fallbackAlbums,
    getTypographyPair,
    toAlbum,
    type Album,
    type ItunesAlbum,
    type TypographyPair,
  } from '../data/albums';

  interface RgbColor {
    r: number;
    g: number;
    b: number;
  }

  interface ExtractedColor extends RgbColor {
    weight: number;
  }

  interface PaletteEntry extends ExtractedColor {
    hex: string;
    role: string;
    contrast: string;
    name: string;
  }

  interface ToneProfile {
    dark: boolean;
    vivid: boolean;
    warm: boolean;
    label: string;
  }

  interface BrandTokens {
    css: string;
    bg: string;
    surface: string;
    text: string;
    muted: string;
    accent: string;
    onAccent: string;
  }

  const panel = document.querySelector<HTMLElement>('[data-album-lab]');

  if (panel) {
    const get = <T extends Element>(selector: string) => panel.querySelector<T>(selector);

    const badge = get<HTMLElement>('[data-badge]');
    const badgeText = get<HTMLElement>('[data-badge-text]');
    const status = get<HTMLElement>('[data-status]');
    const form = get<HTMLFormElement>('[data-search-form]');
    const input = get<HTMLInputElement>('[data-search-input]');
    const examples = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-example]'));
    const loading = get<HTMLElement>('[data-loading]');
    const content = get<HTMLElement>('[data-content]');
    const empty = get<HTMLElement>('[data-empty]');
    const emptyTitle = get<HTMLElement>('[data-empty-title]');
    const emptyMessage = get<HTMLElement>('[data-empty-message]');
    const error = get<HTMLElement>('[data-error]');
    const errorTitle = get<HTMLElement>('[data-error-title]');
    const errorMessage = get<HTMLElement>('[data-error-message]');
    const retryButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-retry]'));
    const fallbackButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-fallback]'));
    const resultsTitle = get<HTMLElement>('[data-results-title]');
    const resultsCount = get<HTMLElement>('[data-results-count]');
    const grid = get<HTMLUListElement>('[data-grid]');
    const manual = get<HTMLElement>('[data-manual]');
    const manualLoading = get<HTMLElement>('[data-manual-loading]');
    const manualContent = get<HTMLElement>('[data-manual-content]');
    const manualNote = get<HTMLElement>('[data-manual-note]');
    const cover = get<HTMLImageElement>('[data-cover]');
    const albumArtist = get<HTMLElement>('[data-album-artist]');
    const albumTitle = get<HTMLElement>('[data-album-title]');
    const albumMeta = get<HTMLElement>('[data-album-meta]');
    const albumLink = get<HTMLAnchorElement>('[data-album-link]');
    const paletteStrip = get<HTMLElement>('[data-palette-strip]');
    const palette = get<HTMLElement>('[data-palette]');
    const typeDisplay = get<HTMLElement>('[data-type-display]');
    const typeBody = get<HTMLElement>('[data-type-body]');
    const typeNote = get<HTMLElement>('[data-type-note]');
    const typeSampleTitle = get<HTMLElement>('[data-type-sample-title]');
    const typeSampleBody = get<HTMLElement>('[data-type-sample-body]');
    const analysis = get<HTMLElement>('[data-analysis]');
    const tone = get<HTMLElement>('[data-tone]');
    const applications = get<HTMLElement>('[data-applications]');
    const tokens = get<HTMLElement>('[data-tokens]');
    const preview = get<HTMLElement>('[data-preview]');
    const previewArtist = get<HTMLElement>('[data-preview-artist]');
    const previewTitle = get<HTMLElement>('[data-preview-title]');
    const previewBody = get<HTMLElement>('[data-preview-body]');
    const previewPalette = get<HTMLElement>('[data-preview-palette]');
    const copyTokensButton = get<HTMLButtonElement>('[data-copy-tokens]');
    const copyStatus = get<HTMLElement>('[data-copy-status]');

    type ViewState = 'loading' | 'success' | 'empty' | 'error';
    type Source = 'api' | 'fallback';

    let requestId = 0;
    let manualRequestId = 0;
    let controller: AbortController | null = null;
    let source: Source = 'api';
    let albums: Album[] = [];
    let selectedId: number | null = null;
    let lastQuery = 'Billie Eilish';

    const badgeMessages: Record<ViewState, string> = {
      loading: 'Buscando álbumes…',
      success: 'Álbumes cargados',
      empty: 'Sin resultados',
      error: 'Error de conexión',
    };

    const neutralPalette: ExtractedColor[] = [
      { r: 253, g: 251, b: 249, weight: 4 },
      { r: 237, g: 229, b: 219, weight: 3 },
      { r: 196, g: 167, b: 125, weight: 2 },
      { r: 116, g: 85, b: 47, weight: 2 },
      { r: 28, g: 25, b: 23, weight: 1 },
    ];

    const createElement = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className?: string,
      text?: string,
    ) => {
      const element = document.createElement(tag);
      if (className) element.className = className;
      if (text !== undefined) element.textContent = text;
      return element;
    };

    const clampByte = (value: number) => Math.max(0, Math.min(255, Math.round(value)));

    const toHex = ({ r, g, b }: RgbColor) =>
      `#${[r, g, b].map((value) => clampByte(value).toString(16).padStart(2, '0')).join('')}`;

    const luminance = ({ r, g, b }: RgbColor) => {
      const [rl, gl, bl] = [r, g, b].map((value) => {
        const channel = value / 255;
        return channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
      });
      return 0.2126 * rl + 0.7152 * gl + 0.0722 * bl;
    };

    const saturation = ({ r, g, b }: RgbColor) => {
      const max = Math.max(r, g, b);
      const min = Math.min(r, g, b);
      return max === 0 ? 0 : (max - min) / max;
    };

    const distance = (a: RgbColor, b: RgbColor) =>
      Math.sqrt((a.r - b.r) ** 2 + (a.g - b.g) ** 2 + (a.b - b.b) ** 2);

    const mix = (a: RgbColor, b: RgbColor, amount: number): RgbColor => ({
      r: clampByte(a.r + (b.r - a.r) * amount),
      g: clampByte(a.g + (b.g - a.g) * amount),
      b: clampByte(a.b + (b.b - a.b) * amount),
    });

    const contrastText = (color: RgbColor) => (luminance(color) > 0.179 ? '#111111' : '#ffffff');

    const assignRoles = (colors: RgbColor[]) => {
      const roles = colors.map(() => 'Apoyo');
      if (colors.length === 0) return roles;

      roles[0] = 'Dominante';

      const saturationOrder = colors
        .map((color, index) => ({ index, value: saturation(color) }))
        .sort((a, b) => b.value - a.value);
      for (const { index } of saturationOrder) {
        if (roles[index] === 'Apoyo') {
          roles[index] = 'Acento';
          break;
        }
      }

      const lightnessOrder = colors
        .map((color, index) => ({ index, value: luminance(color) }))
        .sort((a, b) => b.value - a.value);
      for (const { index } of lightnessOrder) {
        if (roles[index] === 'Apoyo') {
          roles[index] = 'Claro';
          break;
        }
      }
      for (const { index } of [...lightnessOrder].reverse()) {
        if (roles[index] === 'Apoyo') {
          roles[index] = 'Profundo';
          break;
        }
      }

      return roles;
    };

    const loadImage = (src: string) =>
      new Promise<HTMLImageElement>((resolve, reject) => {
        const image = new Image();
        image.crossOrigin = 'anonymous';
        image.decoding = 'async';
        image.onload = () => resolve(image);
        image.onerror = () => reject(new Error('No se pudo cargar la portada.'));
        image.src = src;
      });

    const extractPalette = async (url: string): Promise<ExtractedColor[]> => {
      const image = await loadImage(url);
      const size = 96;
      const canvas = document.createElement('canvas');
      canvas.width = size;
      canvas.height = size;
      const context = canvas.getContext('2d', { willReadFrequently: true });
      if (!context) throw new Error('Canvas no disponible.');

      context.drawImage(image, 0, 0, size, size);
      const { data } = context.getImageData(0, 0, size, size);
      const buckets = new Map<string, RgbColor & { count: number }>();

      for (let index = 0; index < data.length; index += 4) {
        const alpha = data[index + 3];
        if (alpha < 128) continue;

        const r = data[index];
        const g = data[index + 1];
        const b = data[index + 2];
        const key = `${r >> 5}-${g >> 5}-${b >> 5}`;
        const bucket = buckets.get(key);

        if (bucket) {
          bucket.r += r;
          bucket.g += g;
          bucket.b += b;
          bucket.count += 1;
        } else {
          buckets.set(key, { r, g, b, count: 1 });
        }
      }

      const colors = [...buckets.values()]
        .map(({ r, g, b, count }) => ({
          r: Math.round(r / count),
          g: Math.round(g / count),
          b: Math.round(b / count),
          count,
        }))
        .sort((a, b) => b.count - a.count);

      const picked: ExtractedColor[] = [];
      for (const color of colors) {
        if (picked.every((candidate) => distance(candidate, color) > 52)) {
          picked.push({
            r: color.r,
            g: color.g,
            b: color.b,
            weight: color.count,
          });
        }
        if (picked.length === 5) break;
      }

      while (picked.length < 5) {
        const base = picked[0] ?? { r: 120, g: 120, b: 120 };
        const factor = [0.85, 1.15, 0.7, 1.3][picked.length % 4];
        picked.push({
          r: clampByte(base.r * factor),
          g: clampByte(base.g * factor),
          b: clampByte(base.b * factor),
          weight: 1,
        });
      }

      return picked;
    };

    const rgbToHsl = ({ r, g, b }: RgbColor) => {
      const red = r / 255;
      const green = g / 255;
      const blue = b / 255;
      const max = Math.max(red, green, blue);
      const min = Math.min(red, green, blue);
      const lightness = (max + min) / 2;
      const delta = max - min;

      if (delta === 0) return { h: 0, s: 0, l: lightness };

      const saturationValue =
        lightness > 0.5 ? delta / (2 - max - min) : delta / (max + min);
      let hue = 0;

      if (max === red) hue = ((green - blue) / delta) % 6;
      else if (max === green) hue = (blue - red) / delta + 2;
      else hue = (red - green) / delta + 4;

      hue *= 60;
      if (hue < 0) hue += 360;

      return { h: hue, s: saturationValue, l: lightness };
    };

    const getHueFamily = ({ r, g, b }: RgbColor) => {
      const { h, s, l } = rgbToHsl({ r, g, b });
      if (s < 0.12) return 'neutro';
      if (h < 15 || h >= 345) return 'rojo';
      if (h < 45) return l < 0.38 ? 'marrón' : 'naranja';
      if (h < 70) return 'amarillo';
      if (h < 160) return 'verde';
      if (h < 190) return 'turquesa';
      if (h < 250) return 'azul';
      if (h < 290) return 'violeta';
      if (h < 330) return 'magenta';
      return 'rosa';
    };

    const describeColor = (color: RgbColor) => {
      const family = getHueFamily(color);
      const { s, l } = rgbToHsl(color);
      const parts = [family];
      if (l > 0.72) parts.push('claro');
      else if (l < 0.28) parts.push('profundo');
      if (s > 0.55) parts.push('saturado');
      else if (s < 0.2 && family !== 'neutro') parts.push('apagado');
      return parts.join(' ');
    };

    const colorMeaning = (color: RgbColor) => {
      const meanings: Record<string, string> = {
        rojo: 'energía, urgencia y deseo',
        naranja: 'cercanía, impulso y calidez',
        marrón: 'tierra, nostalgia y permanencia',
        amarillo: 'optimismo, atención y luz',
        verde: 'naturaleza, calma y crecimiento',
        turquesa: 'frescura, movimiento y aire',
        azul: 'confianza, distancia y control',
        violeta: 'misterio, creatividad e intensidad',
        magenta: 'expresión, pop y ruptura',
        rosa: 'sensibilidad, juego y seducción',
        neutro: 'silencio, sofisticación y estructura',
      };
      return meanings[getHueFamily(color)];
    };

    const getToneProfile = (colors: RgbColor[]): ToneProfile => {
      const averageLuminance =
        colors.reduce((total, color) => total + luminance(color), 0) / colors.length;
      const averageSaturation =
        colors.reduce((total, color) => total + saturation(color), 0) / colors.length;
      const dark = averageLuminance < 0.45;
      const vivid = averageSaturation > 0.32;
      const warm = colors.some((color) => color.r > color.b + 20);

      return {
        dark,
        vivid,
        warm,
        label: `${dark ? 'Nocturno' : 'Luminoso'} y ${vivid ? 'vibrante' : 'sobrio'}${
          warm ? ', con temperatura cálida' : ''
        }`,
      };
    };

    const buildConcept = (album: Album, toneLabel: string, typography: TypographyPair) =>
      `Un sistema que traduce la energía de ${album.genre.toLowerCase()} en una identidad ${toneLabel}. La portada aporta la paleta; ${typography.display} + ${typography.body} sostienen la jerarquía entre título, metadata y aplicación.`;

    const buildAnalysis = (
      album: Album,
      entries: PaletteEntry[],
      toneProfile: ToneProfile,
      typography: TypographyPair,
    ) => {
      const dominant = entries.find((entry) => entry.role === 'Dominante') ?? entries[0];
      const accent = entries.find((entry) => entry.role === 'Acento') ?? entries[1] ?? dominant;
      const light = entries.find((entry) => entry.role === 'Claro') ?? entries[0];
      const deep = entries.find((entry) => entry.role === 'Profundo') ?? entries[entries.length - 1];
      const secondary = entries
        .filter((entry) => entry !== dominant)
        .map((entry) => `${entry.name} (${entry.hex})`)
        .join(', ');

      const wrapper = document.createElement('div');
      wrapper.className = 'album-lab__analysis-copy';

      const intro = createElement(
        'p',
        'album-lab__analysis-paragraph',
        `Lo primero que me llama la atención de «${album.title}» es ${dominant.name} (${dominant.hex}). Es un color ${describeColor(
          dominant,
        )} que transmite ${colorMeaning(dominant)}; la portada lo usa como base y eso le da una presencia ${
          toneProfile.dark ? 'íntima y nocturna' : 'abierta y luminosa'
        }, ${toneProfile.vivid ? 'con mucha energía' : 'más contenida'}.`,
      );

      const paletteParagraph = createElement(
        'p',
        'album-lab__analysis-paragraph',
        `La paleta se completa con ${secondary}. ${accent.name} funciona como acento: es el color que activa la mirada y el que usaría para un botón o una llamada a la acción. ${light.name} abre aire y ${deep.name} ancla la composición.`,
      );

      const list = createElement('ul', 'album-lab__analysis-colors');
      for (const entry of entries) {
        const item = document.createElement('li');
        const dot = createElement('span', 'album-lab__analysis-dot');
        dot.style.backgroundColor = entry.hex;
        dot.setAttribute('aria-hidden', 'true');

        const copy = createElement('div', 'album-lab__analysis-color-copy');
        const title = createElement('strong', undefined, entry.name);
        const hex = createElement('span', 'album-lab__analysis-hex', entry.hex);
        title.append(' ', hex);
        const description = createElement(
          'p',
          undefined,
          `${entry.role}: transmite ${colorMeaning(entry)}.`,
        );
        copy.append(title, description);
        item.append(dot, copy);
        list.append(item);
      }

      const typographyParagraph = createElement(
        'p',
        'album-lab__analysis-paragraph',
        `Para acompañar esa lectura elegí ${typography.display} + ${typography.body}. ${typography.note} La portada viene de ${album.genre.toLowerCase()}, así que la dupla busca sostener ese tono sin competir con la imagen.`,
      );

      const closing = createElement(
        'p',
        'album-lab__analysis-paragraph album-lab__analysis-closing',
        `Si tuviera que llevarlo a una aplicación, usaría ${dominant.hex} como fondo, ${accent.hex} para acciones y ${light.hex} para respiración. No lo leo como el manual oficial: lo leo como una hipótesis de diseño que se puede discutir y ajustar.`,
      );

      wrapper.append(intro, paletteParagraph, list, typographyParagraph, closing);
      return wrapper;
    };

    const buildTokens = (entries: PaletteEntry[], typography: TypographyPair): BrandTokens => {
      const byLuminance = [...entries].sort((a, b) => luminance(b) - luminance(a));
      const background = byLuminance[0];
      const accent = [...entries].sort((a, b) => saturation(b) - saturation(a))[0];
      const text = contrastText(background);
      const textRgb = text === '#111111' ? { r: 17, g: 17, b: 17 } : { r: 255, g: 255, b: 255 };
      const surface = mix(background, textRgb, 0.08);
      const muted = mix(background, textRgb, 0.55);
      const onAccent = contrastText(accent);

      const css = `:root {
  --brand-bg: ${background.hex};
  --brand-surface: ${toHex(surface)};
  --brand-text: ${text};
  --brand-muted: ${toHex(muted)};
  --brand-accent: ${accent.hex};
  --brand-on-accent: ${onAccent};
  --brand-display: ${typography.displayStack};
  --brand-body: ${typography.bodyStack};
}`;

      return {
        css,
        bg: background.hex,
        surface: toHex(surface),
        text,
        muted: toHex(muted),
        accent: accent.hex,
        onAccent,
      };
    };

    const setView = (view: ViewState) => {
      panel.dataset.state = view;
      panel.setAttribute('aria-busy', String(view === 'loading'));
      loading.hidden = view !== 'loading';
      content.hidden = view !== 'success';
      empty.hidden = view !== 'empty';
      error.hidden = view !== 'error';
      updateBadge(view);
    };

    const updateBadge = (view: ViewState) => {
      if (!badge || !badgeText) return;
      const fallback = view === 'success' && source === 'fallback';
      badge.dataset.state = fallback ? 'fallback' : view;
      badgeText.textContent = fallback ? 'Set de ejemplo' : badgeMessages[view];
    };

    const setSource = (type: Source) => {
      source = type;
      if (panel.dataset.state === 'success') updateBadge('success');
    };

    const setManualState = (state: 'loading' | 'success') => {
      manual.dataset.state = state;
      manualLoading.hidden = state !== 'loading';
      manualContent.hidden = state !== 'success';
    };

    const copyText = async (text: string, message: string) => {
      try {
        await navigator.clipboard.writeText(text);
        copyStatus.textContent = message;
      } catch {
        copyStatus.textContent = 'No se pudo copiar. Seleccioná el texto manualmente.';
      }
      window.setTimeout(() => {
        copyStatus.textContent = '';
      }, 3000);
    };

    const renderPalette = (entries: PaletteEntry[]) => {
      paletteStrip.replaceChildren(
        ...entries.map((entry) => {
          const segment = createElement('span', 'album-lab__palette-segment');
          segment.style.backgroundColor = entry.hex;
          segment.style.flexGrow = String(Math.max(1, entry.weight));
          segment.title = `${entry.name} — ${entry.hex}`;
          return segment;
        }),
      );

      palette.replaceChildren(
        ...entries.map((entry) => {
          const button = createElement('button', 'album-lab__swatch');
          button.type = 'button';
          button.dataset.copy = entry.hex;
          button.title = `${entry.name} — ${entry.hex}`;
          button.setAttribute('aria-label', `Copiar ${entry.name}, ${entry.role}: ${entry.hex}`);

          const color = createElement('span', 'album-lab__swatch-color');
          color.style.backgroundColor = entry.hex;
          color.style.color = entry.contrast;
          color.textContent = entry.role.slice(0, 2).toUpperCase();

          const hex = createElement('span', 'album-lab__swatch-hex', entry.hex);
          const name = createElement('span', 'album-lab__swatch-name', entry.name);
          const role = createElement('span', 'album-lab__swatch-role', entry.role);
          button.append(color, hex, name, role);
          button.addEventListener('click', () => {
            void copyText(entry.hex, `Copiado ${entry.hex} — ${entry.name}.`);
          });
          return button;
        }),
      );
    };

    const renderTypography = (pair: TypographyPair, album: Album, conceptText: string) => {
      typeDisplay.textContent = pair.display;
      typeBody.textContent = pair.body;
      typeNote.textContent = pair.note;
      typeSampleTitle.textContent = album.title;
      typeSampleTitle.style.fontFamily = pair.displayStack;
      typeSampleBody.textContent = conceptText;
      typeSampleBody.style.fontFamily = pair.bodyStack;
    };

    const renderApplications = () => {
      const items = [
        'Portada y contraportada',
        'Post de lanzamiento',
        'Story 9:16',
        'Ficha de catálogo',
        'Banner de playlist',
      ];
      applications.replaceChildren(...items.map((item) => createElement('li', undefined, item)));
    };

    const applyPreview = (
      album: Album,
      tokensData: BrandTokens,
      typography: TypographyPair,
      conceptText: string,
      entries: PaletteEntry[],
    ) => {
      preview.style.setProperty('--brand-bg', tokensData.bg);
      preview.style.setProperty('--brand-surface', tokensData.surface);
      preview.style.setProperty('--brand-text', tokensData.text);
      preview.style.setProperty('--brand-muted', tokensData.muted);
      preview.style.setProperty('--brand-accent', tokensData.accent);
      preview.style.setProperty('--brand-on-accent', tokensData.onAccent);
      preview.style.setProperty('--brand-display', typography.displayStack);
      preview.style.setProperty('--brand-body', typography.bodyStack);

      previewArtist.textContent = album.artist;
      previewTitle.textContent = album.title;
      previewBody.textContent = conceptText;
      previewPalette.replaceChildren(
        ...entries.map((entry) => {
          const swatch = document.createElement('span');
          swatch.style.backgroundColor = entry.hex;
          return swatch;
        }),
      );
    };

    const renderManual = async (album: Album) => {
      const currentRequest = ++manualRequestId;
      setManualState('loading');
      if (source === 'api') {
        badge.dataset.state = 'loading';
        badgeText.textContent = 'Analizando portada…';
      }

      cover.src = album.artwork;
      cover.alt = `Portada de ${album.title} — ${album.artist}`;
      albumArtist.textContent = album.artist;
      albumTitle.textContent = album.title;
      albumMeta.textContent = `${album.year} · ${album.genre} · ${album.tracks} pistas`;
      albumLink.href = album.url;

      let usedFallbackPalette = false;
      const colors = await extractPalette(album.artwork).catch(() => {
        usedFallbackPalette = true;
        return neutralPalette;
      });

      if (currentRequest !== manualRequestId) return;

      const roles = assignRoles(colors);
      const entries: PaletteEntry[] = colors.map((color, index) => ({
        ...color,
        hex: toHex(color),
        role: roles[index],
        contrast: contrastText(color),
        name: describeColor(color),
      }));

      const typography = getTypographyPair(album.genre);
      const toneProfile = getToneProfile(colors);
      const toneLabel = toneProfile.label;
      const conceptText = buildConcept(album, toneLabel, typography);
      const tokensData = buildTokens(entries, typography);

      renderPalette(entries);
      renderTypography(typography, album, conceptText);
      renderApplications();
      applyPreview(album, tokensData, typography, conceptText, entries);
      analysis.replaceChildren(buildAnalysis(album, entries, toneProfile, typography));

      tone.textContent = toneLabel;
      tokens.textContent = tokensData.css;
      manualNote.textContent = usedFallbackPalette
        ? 'No se pudo leer la portada; se usó una paleta base. La tipografía es una recomendación curada, no el manual oficial de la discográfica.'
        : 'Paleta extraída de la portada y tipografía curada según el género. No es el manual oficial de la discográfica.';

      const selectedButton = grid.querySelector<HTMLButtonElement>(`[data-album-id="${album.id}"]`);
      const cardPalette = selectedButton?.querySelector<HTMLElement>('[data-album-palette]');
      if (cardPalette) {
        cardPalette.replaceChildren(
          ...entries.map((entry) => {
            const segment = document.createElement('span');
            segment.style.backgroundColor = entry.hex;
            return segment;
          }),
        );
      }

      setManualState('success');
      if (source === 'api') {
        badge.dataset.state = 'success';
        badgeText.textContent = 'Manual generado';
      }
      status.textContent = `Manual generado para ${album.title} — ${album.artist}.`;
    };

    const updateGridSelection = () => {
      grid.querySelectorAll<HTMLButtonElement>('[data-album-id]').forEach((button) => {
        button.setAttribute('aria-pressed', String(Number(button.dataset.albumId) === selectedId));
      });
    };

    const selectAlbum = (id: number) => {
      const album = albums.find((item) => item.id === id);
      if (!album) return;
      selectedId = id;
      updateGridSelection();
      void renderManual(album);
    };

    const renderGrid = () => {
      grid.replaceChildren(
        ...albums.map((album) => {
          const item = createElement('li', 'album-lab__album-item');
          const button = createElement('button', 'album-lab__album');
          button.type = 'button';
          button.dataset.albumId = String(album.id);
          button.setAttribute('aria-pressed', String(album.id === selectedId));
          button.setAttribute('aria-label', `${album.title} — ${album.artist} (${album.year})`);

          const image = document.createElement('img');
          image.src = album.artworkSmall;
          image.alt = '';
          image.loading = 'lazy';
          image.decoding = 'async';
          image.width = 200;
          image.height = 200;

          const title = createElement('span', 'album-lab__album-title', album.title);
          const meta = createElement('span', 'album-lab__album-meta', `${album.artist} · ${album.year}`);
          const action = createElement('span', 'album-lab__album-action', 'Ver análisis');
          const paletteHint = createElement('span', 'album-lab__album-palette');
          paletteHint.dataset.albumPalette = '';
          paletteHint.setAttribute('aria-hidden', 'true');
          button.append(image, title, meta, action, paletteHint);
          button.addEventListener('click', () => selectAlbum(album.id));
          item.append(button);
          return item;
        }),
      );
    };

    const fetchJson = async <T,>(url: string, signal: AbortSignal): Promise<T> => {
      const response = await fetch(url, {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
        signal,
      });
      if (!response.ok) throw new Error(`La API respondió con el estado ${response.status}.`);
      return (await response.json()) as T;
    };

    const showError = (title: string, message: string) => {
      setView('error');
      errorTitle.textContent = title;
      errorMessage.textContent = message;
      status.textContent = title;
    };

    const loadAlbums = async (query: string) => {
      const term = query.trim();
      if (term.length < 2) {
        input.focus();
        status.textContent = 'Escribí al menos dos caracteres para buscar.';
        return;
      }

      lastQuery = term;
      const currentRequest = ++requestId;
      controller?.abort();
      const localController = new AbortController();
      controller = localController;
      const timeout = window.setTimeout(() => localController.abort(), SEARCH_TIMEOUT);

      setSource('api');
      setView('loading');
      resultsTitle.textContent = `Resultados para “${term}”`;
      status.textContent = `Buscando álbumes de ${term}…`;

      try {
        const url = new URL(ITUNES_SEARCH_URL);
        url.searchParams.set('term', term);
        url.searchParams.set('entity', 'album');
        url.searchParams.set('limit', String(ALBUM_LIMIT));
        url.searchParams.set('country', 'US');

        const data = await fetchJson<{ results?: ItunesAlbum[] }>(
          url.toString(),
          localController.signal,
        );
        if (currentRequest !== requestId) return;

        const results = Array.isArray(data.results) ? data.results : [];
        const seen = new Set<number>();
        const normalizedTerm = term.toLowerCase();
        const artistRank = (album: Album) => {
          const artist = album.artist.toLowerCase();
          if (artist === normalizedTerm) return 0;
          if (artist.includes(normalizedTerm)) return 1;
          return 2;
        };
        const nextAlbums = results
          .map((item) => toAlbum(item))
          .filter((album): album is Album => {
            if (!album || seen.has(album.id)) return false;
            seen.add(album.id);
            return true;
          })
          .sort((a, b) => artistRank(a) - artistRank(b))
          .slice(0, ALBUM_LIMIT);

        if (nextAlbums.length === 0) {
          setView('empty');
          emptyTitle.textContent = 'No encontramos álbumes para esa búsqueda.';
          emptyMessage.textContent = 'Probá con otro artista, revisá la ortografía o usá el set de ejemplo.';
          status.textContent = 'Sin resultados.';
          return;
        }

        albums = nextAlbums;
        selectedId = albums[0].id;
        resultsCount.textContent = `${albums.length} álbum${albums.length === 1 ? '' : 'es'}`;
        setView('success');
        renderGrid();
        selectAlbum(albums[0].id);
      } catch {
        if (currentRequest !== requestId) return;
        showError(
          'No fue posible buscar álbumes.',
          'Revisá la conexión o usá el set de ejemplo para ver cómo funciona el manual.',
        );
      } finally {
        window.clearTimeout(timeout);
      }
    };

    const useFallback = () => {
      requestId += 1;
      controller?.abort();
      albums = fallbackAlbums;
      selectedId = albums[0].id;
      setSource('fallback');
      setView('success');
      resultsTitle.textContent = 'Set de ejemplo';
      resultsCount.textContent = `${albums.length} álbumes`;
      renderGrid();
      selectAlbum(albums[0].id);
      status.textContent = 'Set de ejemplo cargado. La paleta se extrae igual de las portadas.';
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void loadAlbums(input.value);
    });

    examples.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.example ?? '';
        input.value = value;
        void loadAlbums(value);
      });
    });

    retryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        void loadAlbums(lastQuery);
      });
    });

    fallbackButtons.forEach((button) => {
      button.addEventListener('click', useFallback);
    });

    copyTokensButton.addEventListener('click', () => {
      void copyText(tokens.textContent ?? '', 'Tokens CSS copiados.');
    });

    void loadAlbums('Billie Eilish');
  }
</script>

