---
import type { Project } from '../data/projects';
import { areaLabels } from '../data/projects';
import { miradaOptions } from '../data/miradas';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const miradas = miradaOptions.map((mirada) => mirada.id);

const searchText = [
  project.title,
  project.tag,
  project.summary,
  project.problem,
  project.role,
  ...project.roles,
  ...project.tools,
  ...project.decisions,
  ...Object.values(project.miradas).map((mirada) => `${mirada.focus} ${mirada.highlight} ${mirada.detail}`),
].join(' ');
---

<article
  class="project-card"
  data-project-card
  data-areas={project.areas.join(' ')}
  data-search={searchText}
  aria-label={project.title}
>
  <!-- Vista Galería Visual -->
  <div class="project-card__gallery">
    <div class="project-card__media">
      {project.media.type === 'video' ? (
        <>
          <img
            src={project.media.poster}
            alt={project.media.alt}
            loading="lazy"
            decoding="async"
            width="998"
            height="1706"
          />
          <span class="project-card__play" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <span class="project-card__badge">Video · {project.year}</span>
        </>
      ) : (
        <>
          <img
            src={project.media.images[0]}
            alt={project.media.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="project-card__badge">
            {project.media.images.length} imágenes · {project.year}
          </span>
        </>
      )}
    </div>

    <div class="project-card__body">
      <div class="project-card__topline">
        <span class="tag">{project.tag}</span>
        <span class="project-card__year">{project.year}</span>
      </div>

      <h3>
        <a class="project-card__title-link" href={`/proyectos/${project.id}`}>{project.title}</a>
      </h3>

      {miradas.map((mode) => (
        <p class="project-card__focus" data-mirada-panel={mode}>
          {project.miradas[mode].focus}
        </p>
      ))}

      <ul class="project-card__roles" aria-label="Roles del proyecto" data-mirada-highlight="producto">
        {project.roles.map((role) => <li>{role}</li>)}
      </ul>

      <ul class="project-card__tools" aria-label="Herramientas" data-mirada-highlight="gestion">
        {project.tools.map((tool) => <li>{tool}</li>)}
      </ul>

      <a class="project-card__open" href={`/proyectos/${project.id}`}>
        Ver caso completo
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Vista Ficha Técnica / Proceso -->
  <div class="project-card__technical">
    <header class="project-card__technical-head">
      <div>
        <span class="tag">{project.tag}</span>
        <h3>
          <a class="project-card__title-link" href={`/proyectos/${project.id}`}>{project.title}</a>
        </h3>
      </div>
      <span class="project-card__year">{project.year}</span>
    </header>

    <div class="project-card__technical-focus">
      {miradas.map((mode) => (
        <p data-mirada-panel={mode}>
          <strong>{project.miradas[mode].focus}</strong>
          <span>{project.miradas[mode].detail}</span>
        </p>
      ))}
    </div>

    <div class="project-card__technical-grid">
      <div>
        <h4>Problema</h4>
        <p>{project.problem}</p>

        <h4>Mi rol</h4>
        <p>{project.role}</p>

        <h4>Decisiones</h4>
        <ul class="project-card__decisions" data-mirada-highlight="producto">
          {project.decisions.map((decision) => <li>{decision}</li>)}
        </ul>
      </div>

      <div>
        <h4>Proceso</h4>
        <ol class="project-card__process" data-mirada-highlight="gestion">
          {project.process.map((step) => (
            <li>
              <strong>{step.step}</strong>
              <span>{step.detail}</span>
            </li>
          ))}
        </ol>

        <h4>Métricas del proyecto</h4>
        <dl class="project-card__metrics">
          {project.metrics.map((metric) => (
            <div>
              <dt>{metric.label}</dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>

        <h4>Herramientas</h4>
        <ul class="project-card__tools" data-mirada-highlight="gestion">
          {project.tools.map((tool) => <li>{tool}</li>)}
        </ul>
      </div>
    </div>

    <div class="project-card__technical-footer">
      <p class="project-card__areas">
        Áreas: {project.areas.map((area) => areaLabels[area]).join(' · ')}
      </p>
      <a class="project-card__open" href={`/proyectos/${project.id}`}>
        Abrir ficha completa
      </a>
    </div>
  </div>

</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: 0 18px 40px rgba(116, 85, 47, 0.12);
  }

  .project-card__gallery {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-ink);
  }

  .project-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.03);
  }

  .project-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(28, 25, 23, 0.72);
    color: #fff;
    transform: translate(-50%, -50%);
    backdrop-filter: blur(4px);
  }

  .project-card__badge {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 5px 10px;
    border-radius: 100px;
    background: rgba(28, 25, 23, 0.78);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 500;
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px;
  }

  .project-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .project-card__year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .project-card h3 {
    margin-bottom: 10px;
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
  }

  .project-card__title-link {
    text-decoration: none;
    transition: color var(--transition);
  }

  .project-card__title-link:hover {
    color: var(--color-accent-deep);
  }

  .project-card__focus {
    margin-bottom: 14px;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .project-card__roles,
  .project-card__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
    transition: outline var(--transition), background var(--transition);
  }

  .project-card__roles li {
    padding: 4px 9px;
    border-radius: 100px;
    background: var(--color-bg-alt);
    font-size: 0.74rem;
    color: var(--color-text-muted);
  }

  .project-card__tools li {
    padding: 4px 9px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    color: var(--color-accent-deep);
  }

  .project-card__open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    margin-top: auto;
    padding: 10px 16px;
    border: 1px solid var(--color-accent-deep);
    border-radius: var(--radius-sm);
    color: var(--color-accent-deep);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    transition: background var(--transition), color var(--transition);
  }

  .project-card__open:hover {
    background: var(--color-accent-deep);
    color: #fff;
  }

  .project-card__technical {
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
    padding: 24px;
  }

  .project-card__technical-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .project-card__technical-head h3 {
    margin-top: 8px;
  }

  .project-card__technical-focus {
    padding: 14px 16px;
    border-left: 3px solid var(--color-accent-deep);
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
  }

  .project-card__technical-focus strong {
    display: block;
    margin-bottom: 4px;
    color: var(--color-text);
  }

  .project-card__technical-focus span {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .project-card__technical-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .project-card__technical h4 {
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-card__technical h4:not(:first-child) {
    margin-top: 18px;
  }

  .project-card__technical p,
  .project-card__technical li {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .project-card__decisions,
  .project-card__process {
    display: grid;
    gap: 8px;
    padding-left: 18px;
    list-style: disc;
  }

  .project-card__process {
    list-style: decimal;
  }

  .project-card__process li {
    padding-left: 4px;
  }

  .project-card__process strong {
    display: block;
    color: var(--color-text);
    font-size: 0.86rem;
  }

  .project-card__process span {
    display: block;
    font-size: 0.84rem;
  }

  .project-card__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .project-card__metrics div {
    padding: 10px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    text-align: center;
  }

  .project-card__metrics dt {
    order: 2;
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .project-card__metrics dd {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-accent-deep);
  }

  .project-card__technical-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }

  .project-card__areas {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 620px) {
    .project-card__technical-grid {
      grid-template-columns: 1fr;
    }

    .project-card__metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
