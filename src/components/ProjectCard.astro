---
import type { Project } from '../data/projects';
import { miradaOptions } from '../data/miradas';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const miradas = miradaOptions.map((mirada) => mirada.id);
const fileNumber = String(index + 1).padStart(2, '0');
const stampIcon = project.media.type === 'video' ? '▶' : '✦';
const accent = String((index % 4) + 1);

const searchText = [
  project.title,
  project.tag,
  project.summary,
  project.problem,
  project.role,
  ...project.roles,
  ...project.tools,
  ...project.decisions,
  ...Object.values(project.miradas).map((mirada) => `${mirada.focus} ${mirada.highlight} ${mirada.detail}`),
].join(' ');
---

<article
  class="project-card"
  data-project-card
  data-accent={accent}
  data-areas={project.areas.join(' ')}
  data-search={searchText}
  aria-label={project.title}
>
  <!-- Archivo editorial (vista por defecto, sin portada) -->
  <div class="project-card__ficha">
    <div class="project-card__filebar">
      <span class="project-card__fileno">#{fileNumber}</span>
      <span class="project-card__filemeta">
        <span class="project-card__category">{project.tag}</span>
        <span class="project-card__year">{project.year}</span>
      </span>
    </div>

    <div class="project-card__ficha-body">
      <h3 class="project-card__ficha-title">
        <a class="project-card__title-link" href={`/proyectos/${project.id}`}>{project.title}</a>
      </h3>

      <span class="project-card__stamp">
        <span class="project-card__stamp-icon" aria-hidden="true">{stampIcon}</span>
        {project.format}
      </span>

      {miradas.map((mode) => (
        <p class="project-card__focus" data-mirada-panel={mode}>
          {project.miradas[mode].focus}
        </p>
      ))}

      <ul class="project-card__roles" aria-label="Roles del proyecto" data-mirada-highlight="producto">
        {project.roles.map((role) => <li>{role}</li>)}
      </ul>

      <ul class="project-card__tools" aria-label="Herramientas" data-mirada-highlight="gestion">
        {project.tools.map((tool) => <li>{tool}</li>)}
      </ul>

      <a class="project-card__open" href={`/proyectos/${project.id}`}>
        Ver proyecto y galería completa
        <svg class="project-card__open-arrow" aria-hidden="true" width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 6h34" />
          <path d="M29 1l6 5-6 5" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Galería visual (opcional, con portada) -->
  <div class="project-card__gallery">
    <div class="project-card__media">
      {project.media.type === 'video' ? (
        <>
          <img
            src={project.media.poster}
            alt={project.media.alt}
            loading="lazy"
            decoding="async"
            width="998"
            height="1706"
          />
          <span class="project-card__play" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <span class="project-card__badge">Video · {project.year}</span>
        </>
      ) : (
        <>
          <img
            src={project.media.images[0]}
            alt={project.media.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="project-card__badge">
            {project.media.images.length} imágenes · {project.year}
          </span>
        </>
      )}
    </div>

    <div class="project-card__body">
      <div class="project-card__topline">
        <span class="tag">{project.tag}</span>
        <span class="project-card__year">{project.year}</span>
      </div>

      <h3>
        <a class="project-card__title-link" href={`/proyectos/${project.id}`}>{project.title}</a>
      </h3>

      {miradas.map((mode) => (
        <p class="project-card__focus" data-mirada-panel={mode}>
          {project.miradas[mode].focus}
        </p>
      ))}

      <ul class="project-card__roles" aria-label="Roles del proyecto" data-mirada-highlight="producto">
        {project.roles.map((role) => <li>{role}</li>)}
      </ul>

      <ul class="project-card__tools" aria-label="Herramientas" data-mirada-highlight="gestion">
        {project.tools.map((tool) => <li>{tool}</li>)}
      </ul>

      <a class="project-card__open" href={`/proyectos/${project.id}`}>
        Ver caso completo
        <svg class="project-card__open-arrow" aria-hidden="true" width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 6h34" />
          <path d="M29 1l6 5-6 5" />
        </svg>
      </a>
    </div>
  </div>

</article>

<style>
  .project-card {
    --card-accent: var(--color-terracotta);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1.5px solid var(--color-plum);
    border-radius: 3px;
    background: var(--color-surface);
    transition: border-color var(--transition);
  }

  .project-card[data-accent='1'] {
    --card-accent: var(--color-terracotta);
  }

  .project-card[data-accent='2'] {
    --card-accent: var(--color-plum);
  }

  .project-card[data-accent='3'] {
    --card-accent: var(--color-mustard);
  }

  .project-card[data-accent='4'] {
    --card-accent: var(--color-terracotta-deep);
  }

  .project-card:hover {
    border-color: var(--color-terracotta);
  }

  /* --- Archivo editorial (ficha sin portada) --- */
  .project-card__ficha {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-top: 6px solid var(--card-accent);
    background: var(--color-surface);
  }

  .project-card__filebar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    padding: 16px clamp(18px, 2.4vw, 26px) 12px;
    border-bottom: 1.5px solid var(--color-plum);
    background: var(--color-bg-alt);
  }

  .project-card__fileno {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.4vw, 3.6rem);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: var(--color-plum);
  }

  .project-card__filemeta {
    display: grid;
    gap: 3px;
    text-align: right;
  }

  .project-card__category {
    max-width: 20ch;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-card__filemeta .project-card__year {
    color: var(--color-plum);
  }

  .project-card__ficha-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(22px, 3vw, 34px);
  }

  .project-card__ficha h3 {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .project-card__ficha .project-card__title-link {
    text-decoration: none;
  }

  /* Toda la card es clickeable mediante el título */
  .project-card .project-card__title-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .project-card__stamp {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 7px;
    margin-bottom: 16px;
    padding: 5px 11px;
    border: 1.5px dashed var(--card-accent);
    border-radius: 2px;
    background: var(--color-cream);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-plum);
    transform: rotate(-1deg);
  }

  .project-card__stamp-icon {
    font-size: 0.85em;
    line-height: 1;
    color: var(--card-accent);
  }

  .project-card__ficha .project-card__open {
    width: 100%;
  }

  .project-card .project-card__open {
    position: relative;
    z-index: 2;
  }

  .project-card__gallery {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1.5px solid var(--color-plum);
    background: var(--color-ink);
  }

  .project-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1.5px solid var(--color-plum);
    border-radius: 50%;
    background: var(--color-cream);
    color: var(--color-plum);
    transform: translate(-50%, -50%);
  }

  .project-card__badge {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 5px 10px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-cream);
    color: var(--color-plum);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(26px, 3.4vw, 40px);
  }

  .project-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .project-card__year {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .project-card h3 {
    margin-bottom: 12px;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.3vw, 1.75rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .project-card__title-link {
    text-decoration: none;
    transition: color var(--transition);
  }

  .project-card__title-link:hover {
    color: var(--color-accent-deep);
  }

  .project-card__focus {
    margin-bottom: 14px;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .project-card__roles,
  .project-card__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
    transition: outline var(--transition), background var(--transition);
  }

  .project-card__roles li,
  .project-card__tools li {
    padding: 4px 9px;
    border: 1.5px solid rgba(108, 3, 69, 0.35);
    border-radius: 2px;
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-plum);
  }

  .project-card__open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    margin-top: auto;
    padding: 10px 16px;
    border: 1.5px solid var(--color-plum);
    border-radius: 1px 5px 2px 6px;
    background: var(--color-surface);
    color: var(--color-plum);
    font-family: var(--font-ui);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    transform: rotate(-1deg);
    transition: background var(--transition), color var(--transition),
      transform var(--transition);
  }

  .project-card__open:hover {
    background: var(--color-plum);
    color: var(--color-cream);
    transform: rotate(-1deg) translateY(-1px);
  }

  .project-card__open-arrow {
    flex: none;
  }

  @media (max-width: 420px) {
    .project-card__filebar {
      padding-inline: 16px;
    }

    .project-card__fileno {
      font-size: 2.5rem;
    }

    .project-card__stamp {
      transform: none;
    }
  }
</style>
