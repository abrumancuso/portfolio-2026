---
import type { Project } from '../data/projects';
import { areaLabels } from '../data/projects';
import { miradaOptions } from '../data/miradas';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const miradas = miradaOptions.map((mirada) => mirada.id);
const imageCount = project.media.type === 'images' ? project.media.images.length : 0;
---

<dialog
  class="project-dialog"
  id={`dialog-${project.id}`}
  aria-labelledby={`dialog-title-${project.id}`}
  data-dialog
>
  <div class="project-dialog__panel">
    <button class="project-dialog__close" type="button" aria-label="Cerrar caso completo" data-dialog-close>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m6 6 12 12M18 6 6 18" stroke-linecap="round" />
      </svg>
    </button>

    <header class="project-dialog__header">
      <div class="project-dialog__topline">
        <span class="tag">{project.tag}</span>
        <span class="project-dialog__year">{project.year}</span>
      </div>
      <h2 id={`dialog-title-${project.id}`}>{project.title}</h2>
      <p class="project-dialog__summary">{project.summary}</p>
    </header>

    <div class="project-dialog__layout">
      <div class="project-dialog__media">
        {project.media.type === 'video' ? (
          <>
            <video
              controls
              preload="metadata"
              poster={project.media.poster}
              width="1080"
              height="1920"
            >
              <source src={project.media.src} type="video/mp4" />
              Tu navegador no puede reproducir este video.
            </video>
            <p class="project-dialog__caption">{project.media.caption}</p>
            <p class="project-dialog__note">
              Nota de accesibilidad: el video no cuenta con subtítulos ni audiodescripción.
            </p>
          </>
        ) : (
          <>
            <div class="project-dialog__carousel" data-carousel>
              <div class="project-dialog__slides">
                {project.media.images.map((image, index) => (
                  <img
                    class="project-dialog__slide"
                    src={image}
                    alt={`${project.media.alt} — imagen ${index + 1} de ${imageCount}`}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    hidden={index !== 0}
                    data-slide
                  />
                ))}
              </div>

              <div class="project-dialog__carousel-controls">
                <button type="button" aria-label="Imagen anterior" data-carousel-prev>
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <p class="project-dialog__counter" aria-live="polite">
                  <span data-carousel-current>1</span> / {imageCount}
                </p>
                <button type="button" aria-label="Imagen siguiente" data-carousel-next>
                  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </div>
            </div>
            <p class="project-dialog__caption">{project.media.caption}</p>
          </>
        )}
      </div>

      <div class="project-dialog__content">
        <section class="project-dialog__section" aria-label="Enfoque según la mirada activa">
          {miradas.map((mode) => (
            <div data-mirada-panel={mode}>
              <p class="project-dialog__focus">{project.miradas[mode].focus}</p>
              <p class="project-dialog__detail">{project.miradas[mode].detail}</p>
            </div>
          ))}
        </section>

        <section class="project-dialog__section" data-mirada-highlight="ux">
          <h3>Mi rol</h3>
          <p>{project.role}</p>
          <ul class="project-dialog__roles">
            {project.roles.map((role) => <li>{role}</li>)}
          </ul>
        </section>

        <section class="project-dialog__section">
          <h3>Sobre el proyecto</h3>
          <p>{project.problem}</p>
        </section>

        <section class="project-dialog__section" data-mirada-highlight="ux">
          <h3>Decisiones de diseño</h3>
          <ul class="project-dialog__list">
            {project.decisions.map((decision) => <li>{decision}</li>)}
          </ul>
        </section>

        <section class="project-dialog__section" data-mirada-highlight="codigo">
          <h3>Proceso técnico</h3>
          <ol class="project-dialog__process">
            {project.process.map((step) => (
              <li>
                <strong>{step.step}</strong>
                <span>{step.detail}</span>
              </li>
            ))}
          </ol>
        </section>

        <section class="project-dialog__section" data-mirada-highlight="codigo">
          <h3>Herramientas</h3>
          <ul class="project-dialog__tools">
            {project.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </section>

        <section class="project-dialog__section">
          <h3>Métricas del proyecto</h3>
          <dl class="project-dialog__metrics">
            {project.metrics.map((metric) => (
              <div>
                <dt>{metric.label}</dt>
                <dd>{metric.value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="project-dialog__section">
          <h3>Aprendizajes</h3>
          <p>{project.learnings}</p>
        </section>

        <footer class="project-dialog__footer">
          <p>Áreas: {project.areas.map((area) => areaLabels[area]).join(' · ')}</p>
          <a class="btn btn--behance" href={project.behanceUrl} target="_blank" rel="noopener noreferrer">
            Ver en Behance
          </a>
        </footer>
      </div>
    </div>
  </div>
</dialog>

<style>
  .project-dialog {
    width: min(1120px, calc(100vw - 32px));
    max-width: 1120px;
    max-height: 92vh;
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    color: var(--color-text);
    overflow: hidden;
  }

  .project-dialog::backdrop {
    background: rgba(18, 16, 14, 0.78);
    backdrop-filter: blur(5px);
  }

  .project-dialog__panel {
    position: relative;
    max-height: 92vh;
    overflow-y: auto;
    padding: clamp(22px, 4vw, 42px);
  }

  .project-dialog__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-bg-alt);
    color: var(--color-text);
    transition: background var(--transition);
  }

  .project-dialog__close:hover {
    background: var(--color-accent-light);
  }

  .project-dialog__header {
    max-width: 820px;
    margin-bottom: 26px;
    padding-right: 48px;
  }

  .project-dialog__topline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .project-dialog__year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .project-dialog h2 {
    margin-bottom: 10px;
    font-size: clamp(1.6rem, 4vw, 2.5rem);
  }

  .project-dialog__summary {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .project-dialog__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(22px, 4vw, 42px);
    align-items: start;
  }

  .project-dialog__media {
    position: sticky;
    top: 0;
  }

  .project-dialog__media video {
    display: block;
    width: 100%;
    max-height: 70vh;
    border-radius: var(--radius-md);
    background: #000;
  }

  .project-dialog__carousel {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #111;
  }

  .project-dialog__slides {
    display: grid;
    place-items: center;
    min-height: 260px;
    max-height: 70vh;
  }

  .project-dialog__slide {
    display: block;
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
  }

  .project-dialog__carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 10px;
    background: rgba(255, 255, 255, 0.06);
  }

  .project-dialog__carousel-controls button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    transition: background var(--transition);
  }

  .project-dialog__carousel-controls button:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .project-dialog__counter {
    min-width: 68px;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-align: center;
  }

  .project-dialog__caption,
  .project-dialog__note {
    margin-top: 10px;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .project-dialog__note {
    font-style: italic;
  }

  .project-dialog__content {
    display: grid;
    gap: 22px;
  }

  .project-dialog__section {
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
    transition: outline var(--transition), background var(--transition);
  }

  .project-dialog__section:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-dialog__section h3 {
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-dialog__section p,
  .project-dialog__section li {
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .project-dialog__focus {
    margin-bottom: 8px;
    color: var(--color-text) !important;
    font-size: 1.05rem !important;
    font-weight: 500;
  }

  .project-dialog__roles,
  .project-dialog__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .project-dialog__roles li {
    padding: 4px 9px;
    border-radius: 100px;
    background: var(--color-bg-alt);
    font-size: 0.75rem !important;
  }

  .project-dialog__tools li {
    padding: 4px 9px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-family: var(--font-display);
    font-size: 0.74rem !important;
    color: var(--color-accent-deep) !important;
  }

  .project-dialog__list {
    display: grid;
    gap: 8px;
    padding-left: 18px;
    list-style: disc;
  }

  .project-dialog__process {
    display: grid;
    gap: 10px;
    padding-left: 18px;
    list-style: decimal;
  }

  .project-dialog__process strong {
    display: block;
    color: var(--color-text);
    font-size: 0.88rem;
  }

  .project-dialog__process span {
    display: block;
    font-size: 0.86rem;
  }

  .project-dialog__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .project-dialog__metrics div {
    padding: 10px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    text-align: center;
  }

  .project-dialog__metrics dt {
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .project-dialog__metrics dd {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-accent-deep);
  }

  .project-dialog__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-top: 6px;
  }

  .project-dialog__footer p {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .project-dialog__layout {
      grid-template-columns: 1fr;
    }

    .project-dialog__media {
      position: static;
    }

    .project-dialog__metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .project-dialog {
      width: 100vw;
      max-height: 100dvh;
      border-radius: 0;
    }

    .project-dialog__panel {
      max-height: 100dvh;
      padding: 20px 16px 32px;
    }

    .project-dialog__close {
      top: 10px;
      right: 10px;
    }

    .project-dialog__header {
      padding-right: 40px;
    }

    .project-dialog__metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
