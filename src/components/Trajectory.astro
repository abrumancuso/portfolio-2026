---
import SectionHeading from './SectionHeading.astro';
import { skillGroups, timeline } from '../data/site';
---

<section class="trajectory section" id="trayectoria" aria-labelledby="trayectoria-title">
  <div class="trajectory__inner">
    <SectionHeading
      eyebrow="Trayectoria"
      title="Formación, trabajo y herramientas"
      description="Una trayectoria que combina estudio, gestión y producción. No como un CV lineal, sino como las capas que hoy sostienen mi forma de trabajar."
      id="trayectoria-title"
    />

    <div class="trajectory__grid">
      <div class="trajectory__timeline">
        <h3 class="trajectory__label">Recorrido</h3>
        <ol>
          {timeline.map((item) => (
            <li class="trajectory__item">
              <span class="trajectory__date">{item.date}</span>
              <h4>{item.title}</h4>
              <p class="trajectory__place">{item.place}</p>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="trajectory__skills">
        <h3 class="trajectory__label">Herramientas y competencias</h3>
        <div class="trajectory__skill-grid">
          {skillGroups.map((group) => (
            <article class="trajectory__skill">
              <h4>{group.title}</h4>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trajectory__inner {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .trajectory__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 72px);
  }

  .trajectory__label {
    margin-bottom: 22px;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .trajectory__timeline ol {
    position: relative;
    display: grid;
    gap: 0;
    padding-left: 26px;
  }

  .trajectory__timeline ol::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 4px;
    width: 1px;
    background: var(--color-border);
  }

  .trajectory__item {
    position: relative;
    padding-bottom: 32px;
  }

  .trajectory__item:last-child {
    padding-bottom: 0;
  }

  .trajectory__item::before {
    content: '';
    position: absolute;
    top: 5px;
    left: -26px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--color-accent-deep);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .trajectory__date {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent-deep);
  }

  .trajectory__item h4 {
    margin-bottom: 2px;
    font-size: 1.14rem;
  }

  .trajectory__place {
    margin-bottom: 8px;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .trajectory__item > p:last-child {
    color: var(--color-text-muted);
    font-size: 0.93rem;
    line-height: 1.7;
  }

  .trajectory__skill-grid {
    display: grid;
    gap: 14px;
  }

  .trajectory__skill {
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
  }

  .trajectory__skill h4 {
    margin-bottom: 12px;
    font-size: 1rem;
  }

  .trajectory__skill ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .trajectory__skill li {
    padding: 5px 10px;
    border-radius: 100px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 820px) {
    .trajectory__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
