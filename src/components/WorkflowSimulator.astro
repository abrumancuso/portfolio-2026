---
import SectionHeading from './SectionHeading.astro';
import { workflowStages } from '../data/workflow';
---

<section class="workflow section section--alt bg-wash" id="proceso" aria-labelledby="proceso-title">
  <div class="container">
    <SectionHeading
      eyebrow="Proceso de trabajo"
      title="De la idea al producto"
      description="Cómo paso de una idea compleja a un producto ejecutado: cinco etapas con sus <strong>entregables</strong>, <strong>herramientas</strong> y las preguntas que resuelvo para reducir la incertidumbre."
      id="proceso-title"
    />

    <div class="workflow__folder">
      <span class="folder__tab folder__tab--mustard">Proceso</span>

      <svg class="workflow__sparkle deco" viewBox="0 0 40 40" width="30" height="30" aria-hidden="true" focusable="false">
        <path d="M20 3c1.8 9.4 4.8 12.4 14.2 14.2C24.8 19 21.8 22 20 31.4 18.2 22 15.2 19 5.8 17.2 15.2 15.4 18.2 12.4 20 3Z" fill="#F7C566" stroke="#6C0345" stroke-width="1.6" stroke-linejoin="round" />
      </svg>

      <svg class="workflow__arrow deco" viewBox="0 0 80 50" width="70" height="44" fill="none" stroke="#DC6B19" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M10 8c18 3 30 14 36 30" />
        <path d="M39 33 46 38 48 30" />
      </svg>

      <div class="workflow__board" data-workflow>
      <div class="workflow__timeline" role="tablist" aria-label="Etapas del proceso de trabajo" aria-orientation="vertical">
        {workflowStages.map((stage, index) => (
          <button
            class="workflow__stage"
            type="button"
            role="tab"
            id={`workflow-tab-${stage.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`workflow-panel-${stage.id}`}
            tabindex={index === 0 ? 0 : -1}
            data-workflow-tab={stage.id}
          >
            <span class="workflow__stage-number">{stage.step}</span>
            <span class="workflow__stage-title">{stage.title}</span>
          </button>
        ))}
      </div>

      <div class="workflow__detail">
        {workflowStages.map((stage, index) => (
          <div
            class="workflow__panel"
            id={`workflow-panel-${stage.id}`}
            role="tabpanel"
            aria-labelledby={`workflow-tab-${stage.id}`}
            tabindex="0"
            hidden={index !== 0}
            data-workflow-panel={stage.id}
          >
            <header class="workflow__panel-head">
              <span class="workflow__panel-step">Etapa {stage.step} / 05</span>
              <h3>{stage.title}</h3>
              <p>{stage.description}</p>
            </header>

            <div class="workflow__panel-grid">
              <section class="workflow__block" aria-labelledby={`workflow-deliverables-${stage.id}`}>
                <h4 id={`workflow-deliverables-${stage.id}`}>Entregables</h4>
                <ul>
                  {stage.deliverables.map((item) => <li>{item}</li>)}
                </ul>
              </section>

              <section class="workflow__block" aria-labelledby={`workflow-tools-${stage.id}`}>
                <h4 id={`workflow-tools-${stage.id}`}>Herramientas</h4>
                <ul class="workflow__tools">
                  {stage.tools.map((tool) => <li>{tool}</li>)}
                </ul>
              </section>

              <section class="workflow__block" aria-labelledby={`workflow-questions-${stage.id}`}>
                <h4 id={`workflow-questions-${stage.id}`}>Preguntas que resuelvo</h4>
                <ul>
                  {stage.questions.map((question) => <li>{question}</li>)}
                </ul>
              </section>
            </div>
          </div>
        ))}
      </div>
      </div>

      <svg class="workflow__star deco" viewBox="0 0 60 60" width="32" height="32" fill="none" stroke="#DC6B19" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M30 5 37 23 56 23 41 34 47 53 30 41 13 53 19 34 4 23 23 23Z" />
      </svg>
    </div>

    <p class="visually-hidden" role="status" aria-live="polite" data-workflow-status></p>
  </div>
</section>

<script>
  const workflow = document.querySelector<HTMLElement>('[data-workflow]');

  if (workflow) {
    const tabs = Array.from(workflow.querySelectorAll<HTMLButtonElement>('[data-workflow-tab]'));
    const panels = Array.from(workflow.querySelectorAll<HTMLElement>('[data-workflow-panel]'));
    const status = document.querySelector<HTMLElement>('[data-workflow-status]');

    const activate = (id: string, focus = false) => {
      const index = tabs.findIndex((tab) => tab.dataset.workflowTab === id);
      if (index < 0) return;

      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.workflowPanel !== id;
      });

      const activeTab = tabs[index];
      if (focus) activeTab?.focus();

      if (status && activeTab) {
        const title = activeTab.querySelector<HTMLElement>('.workflow__stage-title')?.textContent?.trim();
        status.textContent = `Etapa ${index + 1} de ${tabs.length}${title ? `: ${title}` : ''}.`;
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.workflowTab;
        if (id) activate(id);
      });

      tab.addEventListener('keydown', (event) => {
        let nextIndex = index;

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = tabs.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        const nextTab = tabs[nextIndex];
        if (nextTab?.dataset.workflowTab) activate(nextTab.dataset.workflowTab, true);
      });
    });

    const firstTab = tabs[0];
    if (firstTab?.dataset.workflowTab) activate(firstTab.dataset.workflowTab);
  }
</script>

<style>
  .workflow__folder {
    position: relative;
    padding-top: 34px;
  }

  .workflow__folder > .folder__tab {
    left: clamp(16px, 4vw, 40px);
  }

  .workflow__sparkle {
    position: absolute;
    top: 2px;
    right: clamp(14px, 4vw, 40px);
    z-index: 3;
    transform: rotate(-8deg);
  }

  .workflow__arrow {
    position: absolute;
    top: -8px;
    left: clamp(160px, 20vw, 260px);
    z-index: 3;
    transform: rotate(-2deg);
    pointer-events: none;
  }

  .workflow__star {
    position: absolute;
    right: clamp(20px, 5vw, 60px);
    bottom: -16px;
    z-index: 3;
    transform: rotate(10deg);
    pointer-events: none;
  }

  .workflow__board {
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    overflow: hidden;
    border: 1.5px solid var(--color-plum);
    border-radius: 0 8px 8px 8px;
    background: var(--color-surface);
  }

  .workflow__timeline {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 16px;
    background: var(--color-plum-deep);
  }

  .workflow__stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    min-height: 60px;
    padding: 13px 14px;
    border: 1.5px solid transparent;
    border-bottom: 1px solid rgba(255, 248, 220, 0.18);
    border-radius: 2px;
    color: rgba(255, 248, 220, 0.72);
    text-align: left;
    transition: background var(--transition), color var(--transition),
      border-color var(--transition);
  }

  .workflow__stage:last-child {
    border-bottom: none;
  }

  .workflow__stage:hover {
    background: rgba(255, 248, 220, 0.1);
    border-color: rgba(255, 248, 220, 0.3);
    color: var(--color-cream);
  }

  .workflow__stage[aria-selected='true'] {
    border-color: var(--color-plum);
    background: var(--color-mustard);
    color: var(--color-plum);
  }

  .workflow__stage-number {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-mustard);
  }

  .workflow__stage[aria-selected='true'] .workflow__stage-number {
    color: var(--color-terracotta-deep);
  }

  .workflow__stage-title {
    font-family: var(--font-ui);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;
  }

  .workflow__detail {
    padding: clamp(24px, 4vw, 42px);
    border-left: 1px solid rgba(108, 3, 69, 0.18);
  }

  .workflow__panel {
    display: grid;
    gap: 26px;
  }

  .workflow__panel-head {
    display: grid;
    gap: 8px;
  }

  .workflow__panel-step {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
  }

  .workflow__panel h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.3rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .workflow__panel-head p {
    max-width: 62ch;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .workflow__panel-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .workflow__block {
    padding: 18px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-bg-alt);
  }

  .workflow__block:nth-child(2) {
    background: var(--color-surface);
  }

  .workflow__block:nth-child(3) {
    background: var(--color-bg-alt);
  }

  .workflow__block h4 {
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .workflow__block ul {
    display: grid;
    gap: 8px;
  }

  .workflow__block li {
    position: relative;
    padding-left: 14px;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .workflow__block li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-deep);
  }

  .workflow__block .workflow__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .workflow__tools li {
    padding: 4px 9px;
    border: 1.5px solid rgba(108, 3, 69, 0.35);
    border-radius: 2px;
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-plum);
  }

  .workflow__tools li::before {
    display: none;
  }

  @media (max-width: 900px) {
    .workflow__board {
      grid-template-columns: 1fr;
    }

    .workflow__timeline {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding: 12px;
      scrollbar-width: thin;
    }

    .workflow__stage {
      flex: 0 0 220px;
      min-height: 58px;
      border-right: 1px solid rgba(255, 248, 220, 0.18);
      border-bottom: 1.5px solid transparent;
    }

    .workflow__stage:last-child {
      border-right: none;
    }

    .workflow__detail {
      border-left: none;
      border-top: 1px solid rgba(108, 3, 69, 0.18);
    }
  }

  @media (max-width: 700px) {
    .workflow__panel-grid {
      grid-template-columns: 1fr;
    }

    .workflow__folder > .folder__tab {
      left: 16px;
      padding-inline: 14px;
      font-size: 0.6rem;
    }

    .workflow__sparkle,
    .workflow__arrow,
    .workflow__star {
      display: none;
    }
  }
</style>
