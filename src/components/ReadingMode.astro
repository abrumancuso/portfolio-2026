---
import { miradaOptions } from '../data/miradas';
---

<div
  class="reading-mode"
  data-reading-mode
  role="region"
  aria-label="Selector de mirada del portfolio"
>
  <div class="reading-mode__inner">
    <p class="reading-mode__label" id="mirada-label">Mirada</p>

    <div class="reading-mode__options" role="group" aria-labelledby="mirada-label">
      {miradaOptions.map((mirada) => (
        <button
          class="reading-mode__button"
          type="button"
          data-mirada-button={mirada.id}
          aria-pressed={mirada.id === 'integral' ? 'true' : 'false'}
        >
          {mirada.label}
        </button>
      ))}
    </div>

    <p class="reading-mode__hint">Cambia el énfasis del contenido</p>

    <p class="visually-hidden" role="status" aria-live="polite" data-mirada-status></p>
  </div>
</div>

<script>
  import { miradaOptions, type MiradaId } from '../data/miradas';

  const root = document.documentElement;
  const bar = document.querySelector<HTMLElement>('[data-reading-mode]');

  if (bar) {
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-mirada-button]'));
    const status = bar.querySelector<HTMLElement>('[data-mirada-status]');
    const labels = Object.fromEntries(miradaOptions.map((mirada) => [mirada.id, mirada.label])) as Record<
      MiradaId,
      string
    >;
    const descriptions = Object.fromEntries(
      miradaOptions.map((mirada) => [mirada.id, mirada.description]),
    ) as Record<MiradaId, string>;
    const validModes = miradaOptions.map((mirada) => mirada.id);
    const highlights = Array.from(document.querySelectorAll<HTMLElement>('[data-mirada-highlight]'));

    const isMirada = (value: string | null | undefined): value is MiradaId =>
      Boolean(value && validModes.includes(value as MiradaId));

    const applyMode = (mode: MiradaId, announce = true) => {
      root.dataset.mirada = mode;

      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.miradaButton === mode));
      });

      highlights.forEach((element) => {
        element.classList.toggle('is-highlighted', element.dataset.miradaHighlight === mode);
      });

      if (announce && status) {
        status.textContent = `Mirada activa: ${labels[mode]}. ${descriptions[mode]}`;
      }

      try {
        localStorage.setItem('portfolio-mirada', mode);
      } catch {
        /* El portfolio sigue funcionando si el navegador bloquea localStorage. */
      }

      document.dispatchEvent(
        new CustomEvent('mirada:change', {
          detail: { mirada: mode, label: labels[mode], description: descriptions[mode] },
        }),
      );
    };

    const readStoredMode = (): MiradaId | null => {
      try {
        const stored = localStorage.getItem('portfolio-mirada');
        return isMirada(stored) ? stored : null;
      } catch {
        return null;
      }
    };

    const initialMode = readStoredMode() ?? (isMirada(root.dataset.mirada) ? root.dataset.mirada : 'integral');
    applyMode(initialMode, false);

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const mode = button.dataset.miradaButton;
        if (isMirada(mode)) applyMode(mode);
      });
    });
  }
</script>

<style>
  .reading-mode {
    position: sticky;
    top: var(--nav-height);
    z-index: 900;
    border-bottom: 1px solid var(--color-border);
    background: rgba(253, 251, 249, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .reading-mode__inner {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--mode-bar-height);
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 8px 24px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .reading-mode__inner::-webkit-scrollbar {
    display: none;
  }

  .reading-mode__label {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .reading-mode__options {
    display: flex;
    flex: 0 0 auto;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-surface);
  }

  .reading-mode__button {
    min-height: 34px;
    padding: 6px 12px;
    border-radius: 100px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: background var(--transition), color var(--transition);
  }

  .reading-mode__button:hover {
    color: var(--color-accent-deep);
  }

  .reading-mode__button[aria-pressed='true'] {
    background: var(--color-ink);
    color: #fff;
  }

  .reading-mode__hint {
    margin-left: auto;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .reading-mode__hint {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .reading-mode__inner {
      gap: 8px;
      padding: 8px 16px;
    }

    .reading-mode__label {
      font-size: 0.64rem;
    }

    .reading-mode__button {
      min-height: 32px;
      padding: 5px 10px;
      font-size: 0.7rem;
    }
  }
</style>
