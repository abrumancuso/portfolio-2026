---
import SectionHeading from './SectionHeading.astro';
import { GITHUB_API_URL, GITHUB_USERNAME } from '../data/github';
---

<section class="live-api section" id="actividad" aria-labelledby="actividad-title">
  <div class="container">
    <SectionHeading
      eyebrow="Live API"
      title="Actividad & Repositorios en Tiempo Real (Live API)"
      description="Este panel consume la API pública de GitHub con fetch. Muestra datos reales y permite probar los estados de carga, éxito, vacío, error y respaldo local sin salir de la página."
      id="actividad-title"
    />

    <div class="live-api__panel" data-live-api data-state="loading" aria-busy="true">
      <div class="live-api__statusbar">
        <span class="live-api__badge" data-badge data-state="loading">
          🟡 Conectando con GitHub API…
        </span>
        <code class="live-api__endpoint">GET {GITHUB_API_URL.replace('https://', '')}</code>
      </div>

      <div class="live-api__testbar" aria-label="Controles para probar los estados de la API">
        <div>
          <p class="live-api__testbar-title">Probar estados en la defensa</p>
          <p class="live-api__testbar-hint">
            Refrescá para ver la carga. Escribí “zzz” en el buscador para ver el estado vacío.
          </p>
        </div>
        <div class="live-api__test-actions">
          <button class="live-api__test-button" type="button" data-refresh>
            Refrescar datos
          </button>
          <button class="live-api__test-button" type="button" data-simulate-error>
            Simular error
          </button>
          <button class="live-api__test-button" type="button" data-fallback>
            Usar datos de respaldo
          </button>
        </div>
      </div>

      <div class="live-api__toolbar" data-toolbar hidden>
        <div class="live-api__search">
          <label for="repo-search">Buscar repositorio</label>
          <input
            id="repo-search"
            type="search"
            data-repo-search
            placeholder="Ej. portfolio, backend, ecommerce"
            autocomplete="off"
            aria-controls="live-api-grid"
          />
        </div>

        <div class="live-api__languages" role="group" aria-label="Filtrar por lenguaje" data-languages></div>

        <button class="live-api__reset" type="button" data-reset>Limpiar filtros</button>
      </div>

      <div class="live-api__meta">
        <p class="live-api__status" role="status" aria-live="polite" data-status>
          Cargando repositorios de GitHub…
        </p>
        <p class="live-api__updated" data-updated>Consultando la API…</p>
      </div>

      <div class="live-api__loading" data-loading aria-hidden="true">
        {[0, 1, 2].map(() => (
          <div class="live-api__skeleton">
            <span class="live-api__skeleton-line live-api__skeleton-line--title"></span>
            <span class="live-api__skeleton-line"></span>
            <span class="live-api__skeleton-line live-api__skeleton-line--short"></span>
            <span class="live-api__skeleton-line live-api__skeleton-line--meta"></span>
          </div>
        ))}
      </div>

      <div class="live-api__content" data-content hidden>
        <div class="live-api__grid" id="live-api-grid" data-grid></div>
      </div>

      <div class="live-api__empty" data-empty hidden>
        <p class="live-api__empty-title" data-empty-title>No hay repositorios para mostrar.</p>
        <p class="live-api__empty-message" data-empty-message>
          Probá con otro filtro o volvé a intentar.
        </p>
        <div class="live-api__actions">
          <button class="btn btn--primary" type="button" data-reset>Limpiar filtros</button>
          <button class="btn btn--ghost" type="button" data-empty-retry>Reintentar</button>
          <a
            class="btn btn--ghost"
            href={`https://github.com/${GITHUB_USERNAME}`}
            target="_blank"
            rel="noopener noreferrer">Ver perfil en GitHub</a
          >
        </div>
      </div>

      <div class="live-api__error" data-error hidden>
        <p class="live-api__error-title" data-error-title>No pudimos cargar la actividad.</p>
        <p class="live-api__error-message" data-error-message></p>
        <div class="live-api__actions">
          <button class="btn btn--primary" type="button" data-retry>Reintentar</button>
          <button class="btn btn--ghost" type="button" data-fallback>Usar datos de respaldo</button>
        </div>
      </div>
    </div>

    <div class="live-api__footer">
      <a
        class="btn btn--ghost"
        href={`https://github.com/${GITHUB_USERNAME}`}
        target="_blank"
        rel="noopener noreferrer">Ver perfil de GitHub</a
      >
      <p>API pública de GitHub · sin claves privadas · datos actualizados al abrir la página</p>
    </div>

    <noscript>
      <style is:inline>
        [data-live-api] {
          display: none;
        }
      </style>
      <p class="live-api__noscript">
        Activá JavaScript para ver la actividad en tiempo real.
        <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener noreferrer"
          >Ver repositorios en GitHub</a
        >.
      </p>
    </noscript>
  </div>
</section>

<script>
  import { fallbackRepos, GITHUB_API_URL, type GitHubRepo } from '../data/github';

  const panel = document.querySelector<HTMLElement>('[data-live-api]');

  if (panel) {
    const get = <T extends HTMLElement>(selector: string) => panel.querySelector<T>(selector);

    const toolbar = get<HTMLElement>('[data-toolbar]');
    const search = get<HTMLInputElement>('[data-repo-search]');
    const languages = get<HTMLElement>('[data-languages]');
    const status = get<HTMLElement>('[data-status]');
    const updated = get<HTMLElement>('[data-updated]');
    const badge = get<HTMLElement>('[data-badge]');
    const loading = get<HTMLElement>('[data-loading]');
    const content = get<HTMLElement>('[data-content]');
    const grid = get<HTMLElement>('[data-grid]');
    const empty = get<HTMLElement>('[data-empty]');
    const emptyTitle = get<HTMLElement>('[data-empty-title]');
    const emptyMessage = get<HTMLElement>('[data-empty-message]');
    const emptyRetry = get<HTMLButtonElement>('[data-empty-retry]');
    const emptyReset = empty.querySelector<HTMLButtonElement>('[data-reset]');
    const error = get<HTMLElement>('[data-error]');
    const errorTitle = get<HTMLElement>('[data-error-title]');
    const errorMessage = get<HTMLElement>('[data-error-message]');
    const retryButton = get<HTMLButtonElement>('[data-retry]');
    const refreshButton = get<HTMLButtonElement>('[data-refresh]');
    const simulateErrorButton = get<HTMLButtonElement>('[data-simulate-error]');
    const fallbackButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-fallback]'));
    const resetButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-reset]'));

    type ViewState = 'loading' | 'success' | 'empty' | 'error';
    type Source = 'api' | 'fallback';

    let repos: GitHubRepo[] = [];
    let language = 'all';
    let query = '';
    let sourceType: Source = 'api';
    let requestId = 0;
    let controller: AbortController | null = null;

    const badgeMessages: Record<ViewState, string> = {
      loading: '🟡 Conectando con GitHub API…',
      success: '🟢 Conectado en vivo a GitHub API',
      empty: '⚪ Conectado, sin resultados',
      error: '🔴 Error de conexión con GitHub API',
    };

    const updateBadge = (view: ViewState) => {
      if (!badge) return;
      badge.dataset.state = view;
      badge.textContent =
        view === 'success' && sourceType === 'fallback'
          ? '🟠 Datos de respaldo locales'
          : badgeMessages[view];
    };

    const setView = (view: ViewState) => {
      panel.dataset.state = view;
      panel.setAttribute('aria-busy', String(view === 'loading'));
      loading.hidden = view !== 'loading';
      content.hidden = view !== 'success';
      empty.hidden = view !== 'empty';
      error.hidden = view !== 'error';
      updateBadge(view);
    };

    const setSource = (type: Source) => {
      sourceType = type;
      if (panel.dataset.state === 'success') updateBadge('success');
    };

    const normalize = (value: string) =>
      value
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();

    const formatDate = (value: string) => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return value;

      return new Intl.DateTimeFormat('es-AR', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
      }).format(date);
    };

    const formatTime = () =>
      new Intl.DateTimeFormat('es-AR', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
      }).format(new Date());

    const createCard = (repo: GitHubRepo) => {
      const card = document.createElement('article');
      card.className = 'live-api-card';

      const header = document.createElement('div');
      header.className = 'live-api-card__header';

      const title = document.createElement('h3');
      title.className = 'live-api-card__title';

      const link = document.createElement('a');
      link.href = repo.html_url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = repo.name;
      title.append(link);

      if (repo.fork) {
        const fork = document.createElement('span');
        fork.className = 'live-api-card__fork';
        fork.textContent = 'fork';
        title.append(fork);
      }

      const languageTag = document.createElement('span');
      languageTag.className = 'live-api-card__language';
      languageTag.textContent = repo.language ?? 'Sin lenguaje';

      header.append(title, languageTag);

      const description = document.createElement('p');
      description.className = 'live-api-card__description';
      description.textContent = repo.description ?? 'Sin descripción.';

      const meta = document.createElement('div');
      meta.className = 'live-api-card__meta';

      const stars = document.createElement('span');
      stars.textContent = `★ ${repo.stargazers_count ?? 0}`;

      const repoUpdated = document.createElement('span');
      repoUpdated.textContent = `Actualizado ${formatDate(repo.updated_at)}`;

      meta.append(stars, repoUpdated);

      const footer = document.createElement('a');
      footer.className = 'live-api-card__link';
      footer.href = repo.html_url;
      footer.target = '_blank';
      footer.rel = 'noopener noreferrer';
      footer.textContent = 'Ver repositorio ↗';

      card.append(header, description, meta, footer);
      return card;
    };

    const renderLanguages = () => {
      const available = Array.from(
        new Set(
          repos
            .map((repo) => repo.language)
            .filter((value): value is string => Boolean(value)),
        ),
      );

      if (language !== 'all' && !available.includes(language)) language = 'all';

      const options = ['all', ...available];

      languages.replaceChildren(
        ...options.map((option) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'live-api-filter';
          button.dataset.language = option;
          button.setAttribute('aria-pressed', String(language === option));
          button.setAttribute('aria-controls', 'live-api-grid');
          button.textContent = option === 'all' ? 'Todos' : option;

          button.addEventListener('click', () => {
            language = option;

            languages.querySelectorAll<HTMLButtonElement>('[data-language]').forEach((item) => {
              item.setAttribute('aria-pressed', String(item.dataset.language === language));
            });

            renderFiltered();
          });

          return button;
        }),
      );
    };

    const updateFilterStatus = (visible: number) => {
      const parts = [`${visible} de ${repos.length} repositorios`];

      if (language !== 'all') parts.push(`lenguaje ${language}`);
      if (query.trim()) parts.push(`búsqueda “${query.trim()}”`);

      status.textContent = `${parts.join(' · ')}. ${
        sourceType === 'fallback' ? 'Datos de respaldo locales.' : 'Datos en vivo de GitHub.'
      }`;
    };

    const renderEmpty = (title: string, message: string) => {
      setView('empty');
      toolbar.hidden = repos.length === 0;
      emptyTitle.textContent = title;
      emptyMessage.textContent = message;
      status.textContent = title;
      updated.textContent =
        sourceType === 'fallback' ? 'Datos locales · sin resultados' : 'API consultada · sin resultados';

      if (emptyReset) emptyReset.hidden = repos.length === 0;
      emptyRetry.hidden = repos.length > 0;
    };

    const renderFiltered = () => {
      if (repos.length === 0) {
        renderEmpty(
          'No hay repositorios públicos para mostrar.',
          'El perfil no devolvió repositorios en este momento. Podés verlos directamente en GitHub.',
        );
        return;
      }

      const normalizedQuery = normalize(query.trim());

      const filtered = repos.filter((repo) => {
        const matchesLanguage = language === 'all' || repo.language === language;
        const haystack = normalize(`${repo.name} ${repo.description ?? ''} ${repo.language ?? ''}`);
        return matchesLanguage && (normalizedQuery === '' || haystack.includes(normalizedQuery));
      });

      if (filtered.length === 0) {
        renderEmpty(
          'No hay repositorios con ese filtro.',
          'Probá con otro lenguaje o una palabra clave distinta.',
        );
        return;
      }

      setView('success');
      toolbar.hidden = false;
      grid.replaceChildren(...filtered.map(createCard));
      updateFilterStatus(filtered.length);
      updated.textContent = `Actualizado ${formatTime()} · ${
        sourceType === 'fallback' ? 'datos de respaldo' : 'API en vivo'
      }`;
    };

    const showError = (title: string, message: string) => {
      setView('error');
      toolbar.hidden = true;
      errorTitle.textContent = title;
      errorMessage.textContent = message;
      status.textContent = title;
      updated.textContent = 'Sin datos en vivo';
    };

    const useFallback = () => {
      requestId += 1;
      controller?.abort();
      repos = fallbackRepos;
      language = 'all';
      query = '';
      search.value = '';
      setSource('fallback');
      renderLanguages();
      renderFiltered();
    };

    const simulateError = () => {
      requestId += 1;
      controller?.abort();
      showError(
        'Error simulado para la defensa.',
        'Este estado se activó manualmente desde el panel de pruebas. La interfaz muestra el mismo tratamiento que un error real: mensaje, reintento y opción de usar datos de respaldo.',
      );
    };

    const loadRepos = async () => {
      const currentRequest = ++requestId;

      controller?.abort();
      const localController = new AbortController();
      controller = localController;

      const timeout = window.setTimeout(() => localController.abort(), 10000);

      setView('loading');
      toolbar.hidden = true;
      status.textContent = 'Cargando repositorios de GitHub…';
      updated.textContent = 'Consultando la API…';

      try {
        const response = await fetch(GITHUB_API_URL, {
          headers: { Accept: 'application/vnd.github+json' },
          cache: 'no-store',
          signal: localController.signal,
        });

        if (currentRequest !== requestId) return;

        if (!response.ok) {
          const remaining = response.headers.get('x-ratelimit-remaining');
          const reset = response.headers.get('x-ratelimit-reset');

          if (response.status === 403 || response.status === 429 || remaining === '0') {
            const resetSeconds = reset ? Number(reset) : Number.NaN;
            const resetLabel = Number.isFinite(resetSeconds)
              ? new Date(resetSeconds * 1000).toLocaleTimeString('es-AR', {
                  hour: '2-digit',
                  minute: '2-digit',
                })
              : null;

            throw new Error(
              `GitHub limitó las solicitudes (rate limit).${
                resetLabel ? ` Podés reintentar después de las ${resetLabel}.` : ''
              } Mientras tanto, usá los datos de respaldo.`,
            );
          }

          throw new Error(`La API respondió con el estado ${response.status}.`);
        }

        const data: unknown = await response.json();

        if (currentRequest !== requestId) return;
        if (!Array.isArray(data)) throw new Error('La API devolvió un formato inesperado.');

        repos = (data as GitHubRepo[]).filter(
          (repo) => typeof repo?.name === 'string' && typeof repo?.html_url === 'string',
        );

        language = 'all';
        query = '';
        search.value = '';
        setSource('api');
        renderLanguages();
        renderFiltered();
      } catch (caught) {
        if (currentRequest !== requestId) return;

        const caughtError = caught as Error;

        if (caughtError.name === 'AbortError') {
          showError(
            'La solicitud tardó demasiado.',
            'GitHub no respondió en 10 segundos. Revisá tu conexión, reintentá o usá los datos de respaldo.',
          );
        } else {
          showError(
            'No pudimos cargar la actividad de GitHub.',
            caughtError.message || 'Ocurrió un error inesperado al consultar la API.',
          );
        }
      } finally {
        window.clearTimeout(timeout);
      }
    };

    search.addEventListener('input', () => {
      query = search.value;
      renderFiltered();
    });

    resetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        language = 'all';
        query = '';
        search.value = '';
        renderLanguages();
        renderFiltered();
        if (!toolbar.hidden) search.focus();
      });
    });

    emptyRetry.addEventListener('click', loadRepos);
    retryButton.addEventListener('click', loadRepos);
    refreshButton.addEventListener('click', loadRepos);
    simulateErrorButton.addEventListener('click', simulateError);
    fallbackButtons.forEach((button) => button.addEventListener('click', useFallback));

    loadRepos();
  }
</script>

<style>
  .live-api__panel {
    margin-top: 32px;
  }

  .live-api__statusbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .live-api__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-surface);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .live-api__badge[data-state='success'] {
    border-color: #8ab89a;
    background: #eef8f1;
    color: #245c36;
  }

  .live-api__badge[data-state='loading'] {
    border-color: #e5c98d;
    background: #fff8e8;
    color: #6f5317;
  }

  .live-api__badge[data-state='empty'] {
    border-color: var(--color-border);
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
  }

  .live-api__badge[data-state='error'] {
    border-color: #d8a39a;
    background: #fff0ee;
    color: #8a2f21;
  }

  .live-api__endpoint {
    max-width: 100%;
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    overflow-wrap: anywhere;
  }

  .live-api__testbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 16px;
    padding: 16px;
    border: 1px dashed var(--color-accent-deep);
    border-radius: var(--radius-md);
    background: #fffdf9;
  }

  .live-api__testbar-title {
    margin-bottom: 4px;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .live-api__testbar-hint {
    color: var(--color-text-muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .live-api__test-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .live-api__test-button {
    min-height: 38px;
    padding: 7px 11px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-accent-deep);
    transition: background var(--transition), border-color var(--transition);
  }

  .live-api__test-button:hover {
    border-color: var(--color-accent-deep);
    background: var(--color-bg-alt);
  }

  .live-api__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 16px;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .live-api__search {
    display: flex;
    flex: 1 1 260px;
    flex-direction: column;
    gap: 6px;
  }

  .live-api__search label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .live-api__search input {
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-bg);
    font: inherit;
    color: var(--color-ink);
  }

  .live-api__languages {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  :global(.live-api-filter) {
    min-height: 36px;
    padding: 6px 12px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-bg);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  :global(.live-api-filter:hover) {
    border-color: var(--color-accent);
    color: var(--color-accent-deep);
  }

  :global(.live-api-filter[aria-pressed='true']) {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: #fff;
  }

  .live-api__reset {
    min-height: 44px;
    padding: 0 8px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .live-api__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 18px 0;
  }

  .live-api__status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .live-api__updated {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .live-api__loading,
  .live-api__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .live-api__skeleton {
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .live-api__skeleton-line {
    display: block;
    height: 12px;
    margin-bottom: 12px;
    border-radius: 100px;
    background: linear-gradient(
      90deg,
      var(--color-border) 25%,
      var(--color-bg) 50%,
      var(--color-border) 75%
    );
    background-size: 200% 100%;
    animation: live-api-shimmer 1.4s ease-in-out infinite;
  }

  .live-api__skeleton-line--title {
    width: 60%;
    height: 18px;
  }

  .live-api__skeleton-line--short {
    width: 75%;
  }

