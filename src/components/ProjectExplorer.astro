---
import { filterAreas, projects } from '../data/projects';
import {
  miradaDescriptions,
  miradaLabels,
  miradaOptions,
  type MiradaId,
} from '../data/miradas';
import ProjectCard from './ProjectCard.astro';

const defaultMirada: MiradaId = 'producto';
---

<section class="projects section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="projects__inner">
    <header class="projects__header">
      <div class="projects__intro">
        <svg class="projects__sparkle deco" viewBox="0 0 40 40" width="32" height="32" aria-hidden="true" focusable="false">
          <path d="M20 3c1.8 9.4 4.8 12.4 14.2 14.2C24.8 19 21.8 22 20 31.4 18.2 22 15.2 19 5.8 17.2 15.2 15.4 18.2 12.4 20 3Z" fill="#F7C566" stroke="#6C0345" stroke-width="1.6" stroke-linejoin="round" />
        </svg>

        <span class="section-header__eyebrow">Proyectos</span>
        <h2 id="proyectos-title">
          Selección de proyectos
          <span class="projects__circle">
            destacados
            <svg class="projects__circle-svg" viewBox="0 0 260 26" preserveAspectRatio="none" fill="none" stroke="#DC6B19" stroke-linecap="round" aria-hidden="true" focusable="false">
              <path d="M6 16c50-9 108-12 248-5" stroke-width="2.6" />
              <path d="M16 22c62-6 116-8 228-5" stroke-width="1.4" opacity="0.6" />
            </svg>
          </span>
        </h2>
        <p>
          Una selección de trabajos que muestra distintas capas de mi práctica:
          motion graphics, visualización 3D, diseño estratégico e identidad visual.
          El selector de enfoque permite leer cada caso desde la gestión de proyectos
          o desde el diseño de experiencia. Cada proyecto se abre en su propia página
          para ver el caso completo, las dos lecturas y el proceso técnico.
        </p>
      </div>

      <aside class="projects__note" aria-label="Sobre esta selección de proyectos">
        <p>
          <strong>La selección presentada reúne algunos de los proyectos</strong> en
          los que apliqué diseño de experiencia, estrategia y desarrollo. El portfolio
          completo de diseño e identidad está disponible en Behance.
        </p>
        <a
          class="btn btn--behance"
          href="https://www.behance.net/abrilmancuso"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver portfolio completo en Behance
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </aside>
    </header>

    <div class="explorer__folder">
      <span class="folder__tab folder__tab--mustard">Archivo de proyectos</span>

      <div class="explorer" data-explorer data-view="ficha">
      <div class="explorer__mode-switch" data-mode-switch>
        <div class="explorer__mode-head">
          <span class="explorer__label" id="mirada-label">Leer proyectos desde</span>
          <p class="explorer__mode-current" data-mode-current>{miradaLabels[defaultMirada]}</p>
        </div>

        <div class="explorer__mode-options" role="group" aria-labelledby="mirada-label">
          {miradaOptions.map((mirada, index) => (
            <button
              class="explorer__mode-button"
              type="button"
              data-mirada-button={mirada.id}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {mirada.label}
            </button>
          ))}
        </div>

        <p class="explorer__mode-description" data-mode-description>
          {miradaDescriptions[defaultMirada]}
        </p>

        <svg class="explorer__arrow" aria-hidden="true" viewBox="0 0 110 64" width="96" height="56">
          <path
            d="M102 8c-26 3-46 17-56 42"
            fill="none"
            stroke="#DC6B19"
            stroke-width="1.5"
            stroke-linecap="round"
          />
          <path
            d="M36 42c2 6 6 10 12 13M48 55c-6 0-11-2-15-6"
            fill="none"
            stroke="#DC6B19"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span class="explorer__arrow-note deco-note" aria-hidden="true">mirá más acá</span>
      </div>

      <div class="explorer__toolbar">
        <div class="explorer__control">
          <span class="explorer__label" id="filtro-label">Filtrar por área</span>
          <div class="explorer__chips" role="group" aria-labelledby="filtro-label">
            {filterAreas.map((area) => (
              <button
                class="explorer__chip"
                type="button"
                data-filter={area.id}
                aria-pressed={area.id === 'todas' ? 'true' : 'false'}
              >
                {area.label}
              </button>
            ))}
          </div>
        </div>

        <div class="explorer__control">
          <label class="explorer__label" for="project-search">
            Buscar por proyecto o herramienta
          </label>
          <input
            class="explorer__search"
            id="project-search"
            type="search"
            placeholder="Ej. After Effects, marca, podcast"
            autocomplete="off"
            data-search
          />
        </div>

        <div class="explorer__control">
          <span class="explorer__label" id="vista-label">Modo de visualización</span>
          <div class="explorer__view" role="group" aria-labelledby="vista-label">
            <button type="button" data-view="ficha" aria-pressed="true">
              Archivo editorial
            </button>
            <button type="button" data-view="galeria" aria-pressed="false">
              Galería visual
            </button>
          </div>
        </div>
      </div>

      <div class="explorer__statusbar">
        <p class="explorer__status" role="status" aria-live="polite" data-results-status>
          Mostrando 4 de 4 proyectos · Área: Todas
        </p>
        <button class="explorer__reset" type="button" data-reset>
          Limpiar filtros
        </button>
      </div>

      <div class="explorer__grid" data-grid>
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>

      <div class="explorer__empty" data-empty hidden>
        <p class="explorer__empty-title">No encontramos proyectos con esos filtros.</p>
        <p>
          Se puede intentar con otra área o palabra clave. La selección completa de
          diseño e identidad está disponible en Behance.
        </p>
        <div class="explorer__empty-actions">
          <button class="btn btn--primary" type="button" data-reset>
            Restablecer filtros
          </button>
          <a
            class="btn btn--ghost"
            href="https://www.behance.net/abrilmancuso"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ir a Behance
          </a>
        </div>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { miradaDescriptions, miradaLabels, miradaOptions, type MiradaId } from '../data/miradas';

  const defaultMirada: MiradaId = 'producto';
  const explorer = document.querySelector<HTMLElement>('[data-explorer]');

  if (explorer) {
    const cards = Array.from(explorer.querySelectorAll<HTMLElement>('[data-project-card]'));
    const filterButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    const viewButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('button[data-view]'));
    const searchInput = explorer.querySelector<HTMLInputElement>('[data-search]');
    const status = explorer.querySelector<HTMLElement>('[data-results-status]');
    const empty = explorer.querySelector<HTMLElement>('[data-empty]');
    const grid = explorer.querySelector<HTMLElement>('[data-grid]');
    const resetButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-reset]'));

    const state = {
      area: 'todas',
      query: '',
      view: 'ficha' as 'galeria' | 'ficha',
    };

    const root = document.documentElement;
    const modeButtons = Array.from(
      explorer.querySelectorAll<HTMLButtonElement>('[data-mirada-button]'),
    );
    const modeDescription = explorer.querySelector<HTMLElement>('[data-mode-description]');
    const modeCurrent = explorer.querySelector<HTMLElement>('[data-mode-current]');
    const highlights = Array.from(document.querySelectorAll<HTMLElement>('[data-mirada-highlight]'));
    const validModes = miradaOptions.map((mirada) => mirada.id);

    const isMirada = (value: string | null | undefined): value is MiradaId =>
      Boolean(value && validModes.includes(value as MiradaId));

    let visibleCount = cards.length;

    const normalize = (value: string) =>
      value
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();

    const updateStatus = (visible: number) => {
      const activeArea = filterButtons.find((button) => button.dataset.filter === state.area);
      const areaLabel = activeArea?.textContent?.trim() ?? 'Todas';
      const queryPart = state.query ? ` · Búsqueda: “${state.query}”` : '';
      if (status) {
        status.textContent = `Mostrando ${visible} de ${cards.length} proyectos · Área: ${areaLabel}${queryPart}`;
      }
    };

    const applyMode = (mode: MiradaId, announce = true) => {
      root.dataset.mirada = mode;

      modeButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.miradaButton === mode));
      });

      highlights.forEach((element) => {
        element.classList.toggle('is-highlighted', element.dataset.miradaHighlight === mode);
      });

      if (modeCurrent) modeCurrent.textContent = miradaLabels[mode];
      if (modeDescription) modeDescription.textContent = miradaDescriptions[mode];

      if (announce && status) {
        status.textContent = `Mirada ${miradaLabels[mode]} activa. Mostrando ${visibleCount} de ${cards.length} proyectos.`;
      }

      try {
        localStorage.setItem('portfolio-mirada', mode);
      } catch {
        /* El portfolio sigue funcionando si el navegador bloquea localStorage. */
      }
    };

    const applyFilters = () => {
      const query = normalize(state.query.trim());
      let visible = 0;

      cards.forEach((card) => {
        const areas = (card.dataset.areas ?? '').split(' ');
        const searchable = normalize(card.dataset.search ?? '');
        const matchesArea = state.area === 'todas' || areas.includes(state.area);
        const matchesQuery = query.length === 0 || searchable.includes(query);
        const matches = matchesArea && matchesQuery;

        card.hidden = !matches;
        if (matches) visible += 1;
      });

      visibleCount = visible;
      if (empty) empty.hidden = visible !== 0;
      if (grid) grid.hidden = visible === 0;

      filterButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.filter === state.area));
      });

      updateStatus(visible);
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        state.area = button.dataset.filter ?? 'todas';
        applyFilters();
      });
    });

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const view = button.dataset.view;
        if (view !== 'galeria' && view !== 'ficha') return;
        state.view = view;
        explorer.dataset.view = view;
        viewButtons.forEach((item) => {
          item.setAttribute('aria-pressed', String(item.dataset.view === view));
        });
        if (status) {
          status.textContent = `Vista ${view === 'galeria' ? 'galería visual' : 'archivo editorial'} activada. Mostrando ${visibleCount} de ${cards.length} proyectos.`;
        }
      });
    });

    searchInput?.addEventListener('input', () => {
      state.query = searchInput.value;
      applyFilters();
    });

    resetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        state.area = 'todas';
        state.query = '';
        state.view = 'ficha';
        explorer.dataset.view = 'ficha';
        if (searchInput) searchInput.value = '';
        viewButtons.forEach((item) => {
          item.setAttribute('aria-pressed', String(item.dataset.view === 'ficha'));
        });
        applyFilters();
        if (status) status.textContent = `Filtros restablecidos. Mostrando ${cards.length} de ${cards.length} proyectos · Área: Todas`;
      });
    });

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const mode = button.dataset.miradaButton;
        if (isMirada(mode)) applyMode(mode);
      });
    });

    applyFilters();

    let initialMode: MiradaId = defaultMirada;
    try {
      const storedMode = localStorage.getItem('portfolio-mirada');
      if (isMirada(storedMode)) initialMode = storedMode;
    } catch {
      /* Se usa el modo por defecto si localStorage no está disponible. */
    }
    applyMode(initialMode, false);
  }

</script>

<style>
  .projects__inner {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .projects__header {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(24px, 5vw, 56px);
    align-items: start;
    margin-bottom: clamp(32px, 5vw, 52px);
  }

  .projects__intro h2 {
    margin: 10px 0 24px;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
  }

  /* --- Capa decorativa editorial --- */
  .projects__intro {
    position: relative;
  }

  .projects__sparkle {
    position: absolute;
    top: -12px;
    right: clamp(6px, 10vw, 90px);
    z-index: 1;
    transform: rotate(12deg);
  }

  .projects__circle {
    position: relative;
    display: inline-block;
  }

  .projects__circle-svg {
    position: absolute;
    left: -4%;
    bottom: -0.42em;
    width: 108%;
    height: 0.55em;
    overflow: visible;
    pointer-events: none;
  }

  .explorer__arrow-note {
    position: absolute;
    right: clamp(10px, 3vw, 26px);
    bottom: 8px;
    transform: rotate(-3deg);
    z-index: 1;
  }

  .projects__intro p {
    max-width: 62ch;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .projects__note {
    position: relative;
    padding: 28px 24px 24px;
    border: 1.5px solid var(--color-plum);
    border-top: 4px solid var(--color-mustard);
    border-radius: 3px;
    background: var(--color-surface);
  }

  .projects__note p {
    margin-bottom: 16px;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .projects__note strong {
    color: var(--color-text);
  }

  .explorer__folder {
    position: relative;
    padding-top: 34px;
  }

  .explorer__folder > .folder__tab {
    left: clamp(14px, 3vw, 30px);
  }

  .explorer {
    padding: clamp(20px, 3vw, 32px);
    border: 1.5px solid var(--color-plum);
    border-radius: 0 8px 8px 8px;
    background: var(--color-bg-alt);
  }

  .explorer__toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(220px, 0.8fr) auto;
    gap: 18px;
    align-items: end;
  }

  .explorer__control {
    display: grid;
    gap: 8px;
  }

  .explorer__label {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .explorer__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding-top: 3px;
  }

  .explorer__chip {
    min-height: 38px;
    padding: 8px 14px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-plum);
    transition: background var(--transition), color var(--transition);
  }

  .explorer__chip:hover {
    background: var(--color-mustard);
  }

  .explorer__chip[aria-pressed='true'] {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .explorer__view {
    display: inline-flex;
    overflow: hidden;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-surface);
  }

  .explorer__view button {
    min-height: 38px;
    padding: 8px 14px;
    border: none;
    border-radius: 0;
    background: transparent;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-plum);
    transition: background var(--transition), color var(--transition);
  }

  .explorer__view button + button {
    border-left: 1.5px solid var(--color-plum);
  }

  .explorer__view button:hover {
    background: var(--color-mustard);
    color: var(--color-plum);
    transform: none;
  }

  .explorer__view button[aria-pressed='true'] {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .explorer__search {
    width: 100%;
    min-height: 42px;
    padding: 10px 14px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    transition: border-color var(--transition);
  }

  .explorer__search:focus {
    border-color: var(--color-terracotta);
    outline: none;
  }

  .explorer__search::placeholder {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .explorer__statusbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 20px 0 14px;
    padding-top: 16px;
    border-top: 1px solid rgba(108, 3, 69, 0.18);
  }

  .explorer__status {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }

  .explorer__reset {
    min-height: 36px;
    padding: 6px 10px;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-plum);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .explorer__mode-switch {
    position: relative;
    display: grid;
    gap: 14px;
    margin-bottom: 24px;
    padding: clamp(18px, 2.5vw, 24px);
    border: 1.5px solid var(--color-plum);
    border-radius: 3px;
    background: var(--color-surface);
  }

  .explorer__mode-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding-right: clamp(0px, 8vw, 96px);
  }

  .explorer__mode-current {
    font-family: var(--font-script);
    font-style: italic;
    font-size: 1.16rem;
    font-weight: 400;
    color: var(--color-accent-deep);
  }

  .explorer__mode-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding: 0;
    border: none;
    background: transparent;
  }

  .explorer__mode-button {
    min-height: 46px;
    padding: 10px 14px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-bg-alt);
    font-family: var(--font-ui);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.35;
    text-transform: none;
    color: var(--color-plum);
    text-align: left;
    transition: background var(--transition), color var(--transition);
  }

  .explorer__mode-button:hover {
    background: var(--color-mustard);
  }

  .explorer__mode-button[aria-pressed='true'] {
    background: var(--color-plum);
    color: var(--color-cream);
  }

  .explorer__mode-description {
    max-width: 62ch;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .explorer__arrow {
    position: absolute;
    right: clamp(6px, 2vw, 22px);
    bottom: -26px;
    transform: rotate(-4deg);
    pointer-events: none;
  }

  .explorer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 2.6vw, 30px);
    padding: 6px 4px 10px;
  }

  .explorer[data-view='ficha'] :global(.project-card__gallery) {
    display: none;
  }

  .explorer[data-view='galeria'] :global(.project-card__ficha) {
    display: none;
  }

  .explorer__empty {
    padding: clamp(28px, 5vw, 48px);
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-surface);
    text-align: center;
  }

  .explorer__empty-title {
    margin-bottom: 8px;
    font-family: var(--font-ui);
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: none;
  }

  .explorer__empty > p:not(.explorer__empty-title) {
    max-width: 52ch;
    margin: 0 auto 18px;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .explorer__empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  @media (max-width: 1000px) {
    .projects__header {
      grid-template-columns: 1fr;
    }

    .projects__note {
      transform: none;
    }

    .explorer__toolbar {
      grid-template-columns: 1fr 1fr;
    }

    .explorer__control:last-child {
      grid-column: 1 / -1;
    }

    .projects__sparkle {
      display: none;
    }

    .explorer__arrow {
      display: none;
    }

    .explorer__arrow-note {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .explorer {
      padding: 16px;
    }

    .explorer__toolbar {
      grid-template-columns: 1fr;
    }

    .explorer__control:last-child {
      grid-column: auto;
    }

    .explorer__grid {
      grid-template-columns: 1fr;
    }

    .explorer__mode-options {
      grid-template-columns: 1fr;
    }

    .explorer__empty-actions {
      flex-direction: column;
    }

    .explorer__empty-actions .btn {
      width: 100%;
    }

    .explorer__folder > .folder__tab {
      left: 14px;
      padding-inline: 14px;
      font-size: 0.6rem;
    }
  }
</style>
