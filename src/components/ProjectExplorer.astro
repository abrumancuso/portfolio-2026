---
import { filterAreas, projects } from '../data/projects';
import { miradaLabels, type MiradaId } from '../data/miradas';
import ProjectCard from './ProjectCard.astro';
import ProjectDialog from './ProjectDialog.astro';

const miradas: MiradaId[] = ['integral', 'ux', 'codigo'];

const miradaNotes: Record<MiradaId, string> = {
  integral:
    'Mirada integral: cada proyecto muestra su resumen, sus roles y sus señales principales.',
  ux: 'Mirada Diseño & UX: se destacan roles, decisiones de investigación y criterios de experiencia.',
  codigo:
    'Mirada Arquitectura & Código: se destacan procesos técnicos, herramientas y métricas de producción.',
};
---

<section class="projects section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="projects__inner">
    <header class="projects__header">
      <div class="projects__intro">
        <span class="section-header__eyebrow">Proyectos</span>
        <h2 id="proyectos-title">Selección de algunos proyectos destacados</h2>
        <p>
          Cuatro trabajos que muestran distintas capas de mi práctica: motion graphics,
          visualización 3D, diseño estratégico e identidad visual. La selección no
          representa la totalidad de mis proyectos.
        </p>
      </div>

      <aside class="projects__note" aria-label="Sobre esta selección de proyectos">
        <p>
          <strong>Esta es una selección de algunos proyectos destacados</strong>, no la
          totalidad de mis trabajos. En Behance podés ver el portfolio completo, con
          más piezas y procesos.
        </p>
        <a
          class="btn btn--behance"
          href="https://www.behance.net/abrilmancuso"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver portfolio completo en Behance
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </aside>
    </header>

    <div class="explorer" data-explorer data-view="galeria">
      <div class="explorer__toolbar">
        <div class="explorer__control">
          <span class="explorer__label" id="filtro-label">Filtrar por área</span>
          <div class="explorer__chips" role="group" aria-labelledby="filtro-label">
            {filterAreas.map((area) => (
              <button
                class="explorer__chip"
                type="button"
                data-filter={area.id}
                aria-pressed={area.id === 'todas' ? 'true' : 'false'}
              >
                {area.label}
              </button>
            ))}
          </div>
        </div>

        <div class="explorer__control">
          <label class="explorer__label" for="project-search">
            Buscar por proyecto o herramienta
          </label>
          <input
            class="explorer__search"
            id="project-search"
            type="search"
            placeholder="Ej. After Effects, marca, podcast"
            autocomplete="off"
            data-search
          />
        </div>

        <div class="explorer__control">
          <span class="explorer__label" id="vista-label">Modo de visualización</span>
          <div class="explorer__view" role="group" aria-labelledby="vista-label">
            <button type="button" data-view="galeria" aria-pressed="true">
              Galería visual
            </button>
            <button type="button" data-view="ficha" aria-pressed="false">
              Ficha técnica
            </button>
          </div>
        </div>
      </div>

      <div class="explorer__statusbar">
        <p class="explorer__status" role="status" aria-live="polite" data-results-status>
          Mostrando 4 de 4 proyectos · Área: Todas
        </p>
        <button class="explorer__reset" type="button" data-reset>
          Limpiar filtros
        </button>
      </div>

      <div class="explorer__mode-note">
        {miradas.map((mode) => (
          <p data-mirada-panel={mode}>
            <span>{miradaLabels[mode]}</span> {miradaNotes[mode]}
          </p>
        ))}
      </div>

      <div class="explorer__grid" data-grid>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>

      <div class="explorer__empty" data-empty hidden>
        <p class="explorer__empty-title">No encontramos proyectos con esos filtros.</p>
        <p>
          Probá con otra área o palabra clave. También podés ver la selección completa
          en Behance.
        </p>
        <div class="explorer__empty-actions">
          <button class="btn btn--primary" type="button" data-reset>
            Restablecer filtros
          </button>
          <a
            class="btn btn--ghost"
            href="https://www.behance.net/abrilmancuso"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ir a Behance
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{projects.map((project) => <ProjectDialog project={project} />)}

<script>
  const explorer = document.querySelector<HTMLElement>('[data-explorer]');

  if (explorer) {
    const cards = Array.from(explorer.querySelectorAll<HTMLElement>('[data-project-card]'));
    const filterButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    const viewButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('button[data-view]'));
    const searchInput = explorer.querySelector<HTMLInputElement>('[data-search]');
    const status = explorer.querySelector<HTMLElement>('[data-results-status]');
    const empty = explorer.querySelector<HTMLElement>('[data-empty]');
    const grid = explorer.querySelector<HTMLElement>('[data-grid]');
    const resetButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-reset]'));

    const state = {
      area: 'todas',
      query: '',
      view: 'galeria' as 'galeria' | 'ficha',
    };

    let visibleCount = cards.length;

    const normalize = (value: string) =>
      value
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();

    const updateStatus = (visible: number) => {
      const activeArea = filterButtons.find((button) => button.dataset.filter === state.area);
      const areaLabel = activeArea?.textContent?.trim() ?? 'Todas';
      const queryPart = state.query ? ` · Búsqueda: “${state.query}”` : '';
      if (status) {
        status.textContent = `Mostrando ${visible} de ${cards.length} proyectos · Área: ${areaLabel}${queryPart}`;
      }
    };

    const applyFilters = () => {
      const query = normalize(state.query.trim());
      let visible = 0;

      cards.forEach((card) => {
        const areas = (card.dataset.areas ?? '').split(' ');
        const searchable = normalize(card.dataset.search ?? '');
        const matchesArea = state.area === 'todas' || areas.includes(state.area);
        const matchesQuery = query.length === 0 || searchable.includes(query);
        const matches = matchesArea && matchesQuery;

        card.hidden = !matches;
        if (matches) visible += 1;
      });

      visibleCount = visible;
      if (empty) empty.hidden = visible !== 0;
      if (grid) grid.hidden = visible === 0;

      filterButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.filter === state.area));
      });

      updateStatus(visible);
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        state.area = button.dataset.filter ?? 'todas';
        applyFilters();
      });
    });

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const view = button.dataset.view;
        if (view !== 'galeria' && view !== 'ficha') return;
        state.view = view;
        explorer.dataset.view = view;
        viewButtons.forEach((item) => {
          item.setAttribute('aria-pressed', String(item.dataset.view === view));
        });
        if (status) {
          status.textContent = `Vista ${view === 'galeria' ? 'galería visual' : 'ficha técnica'} activada. Mostrando ${visibleCount} de ${cards.length} proyectos.`;
        }
      });
    });

    searchInput?.addEventListener('input', () => {
      state.query = searchInput.value;
      applyFilters();
    });

    resetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        state.area = 'todas';
        state.query = '';
        state.view = 'galeria';
        explorer.dataset.view = 'galeria';
        if (searchInput) searchInput.value = '';
        viewButtons.forEach((item) => {
          item.setAttribute('aria-pressed', String(item.dataset.view === 'galeria'));
        });
        applyFilters();
        if (status) status.textContent = `Filtros restablecidos. Mostrando ${cards.length} de ${cards.length} proyectos · Área: Todas`;
      });
    });

    applyFilters();

    document.addEventListener('mirada:change', (event) => {
      const detail = (event as CustomEvent<{ label?: string }>).detail;
      if (status && detail?.label) {
        status.textContent = `Mirada ${detail.label} activa. Mostrando ${visibleCount} de ${cards.length} proyectos.`;
      }
    });
  }

  /* --- Diálogos de caso completo y carruseles --- */
  const dialogs = Array.from(document.querySelectorAll<HTMLDialogElement>('dialog[data-dialog]'));

  const lockBody = () => {
    document.body.classList.add('is-locked');
  };

  const unlockBodyIfNeeded = () => {
    const anyOpen = Array.from(document.querySelectorAll<HTMLDialogElement>('dialog[data-dialog]')).some(
      (dialog) => dialog.open,
    );
    if (!anyOpen) document.body.classList.remove('is-locked');
  };

  dialogs.forEach((dialog) => {
    const carousel = dialog.querySelector<HTMLElement>('[data-carousel]');

    if (carousel) {
      const slides = Array.from(carousel.querySelectorAll<HTMLImageElement>('[data-slide]'));
      const current = carousel.querySelector<HTMLElement>('[data-carousel-current]');
      let index = 0;

      const showSlide = (nextIndex: number) => {
        if (slides.length === 0) return;
        index = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, slideIndex) => {
          slide.hidden = slideIndex !== index;
        });
        if (current) current.textContent = String(index + 1);
      };

      carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => showSlide(index - 1));
      carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => showSlide(index + 1));

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showSlide(index - 1);
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          showSlide(index + 1);
        }
      });

      dialog.addEventListener('close', () => showSlide(0));
    }

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      dialog.querySelectorAll('video').forEach((video) => video.pause());
      unlockBodyIfNeeded();
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const opener = target.closest<HTMLElement>('[data-open-dialog]');
    if (opener) {
      const id = opener.dataset.openDialog;
      const dialog = id ? document.getElementById(`dialog-${id}`) as HTMLDialogElement | null : null;
      if (dialog && !dialog.open) {
        dialog.showModal();
        lockBody();
      }
      return;
    }

    const closer = target.closest<HTMLElement>('[data-dialog-close]');
    if (closer) {
      closer.closest('dialog')?.close();
    }
  });
</script>

<style>
  .projects__inner {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .projects__header {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(24px, 5vw, 56px);
    align-items: start;
    margin-bottom: clamp(32px, 5vw, 52px);
  }

  .projects__intro h2 {
    margin: 10px 0 14px;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
  }

  .projects__intro p {
    max-width: 62ch;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .projects__note {
    padding: 22px;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent-deep);
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
  }

  .projects__note p {
    margin-bottom: 16px;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .projects__note strong {
    color: var(--color-text);
  }

  .explorer {
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
  }

  .explorer__toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(220px, 0.8fr) auto;
    gap: 18px;
    align-items: end;
  }

  .explorer__control {
    display: grid;
    gap: 8px;
  }

  .explorer__label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .explorer__chips,
  .explorer__view {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .explorer__chip,
  .explorer__view button {
    min-height: 40px;
    padding: 8px 13px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-surface);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .explorer__chip:hover,
  .explorer__view button:hover {
    border-color: var(--color-accent-deep);
    color: var(--color-accent-deep);
  }

  .explorer__chip[aria-pressed='true'],
  .explorer__view button[aria-pressed='true'] {
    border-color: var(--color-accent-deep);
    background: var(--color-accent-deep);
    color: #fff;
  }

  .explorer__view {
    padding: 4px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-surface);
    gap: 2px;
  }

  .explorer__view button {
    border: none;
    background: transparent;
    border-radius: 100px;
  }

  .explorer__view button[aria-pressed='true'] {
    background: var(--color-accent-deep);
  }

  .explorer__search {
    width: 100%;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: 0.9rem;
  }

  .explorer__search::placeholder {
    color: #8a817a;
  }

  .explorer__statusbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 18px 0 12px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }

  .explorer__status {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .explorer__reset {
    min-height: 36px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .explorer__mode-note {
    margin-bottom: 18px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.84rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .explorer__mode-note span {
    display: inline-block;
    margin-right: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-accent-deep);
  }

  .explorer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .explorer[data-view='ficha'] .explorer__grid {
    grid-template-columns: 1fr;
  }

  .explorer[data-view='galeria'] :global(.project-card__technical) {
    display: none;
  }

  .explorer[data-view='ficha'] :global(.project-card__gallery) {
    display: none;
  }

  .explorer[data-view='ficha'] :global(.project-card:hover) {
    transform: none;
  }

  .explorer__empty {
    padding: clamp(28px, 5vw, 48px);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-align: center;
  }

  .explorer__empty-title {
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .explorer__empty > p:not(.explorer__empty-title) {
    max-width: 52ch;
    margin: 0 auto 18px;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .explorer__empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  @media (max-width: 1000px) {
    .projects__header {
      grid-template-columns: 1fr;
    }

    .explorer__toolbar {
      grid-template-columns: 1fr 1fr;
    }

    .explorer__control:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .explorer {
      padding: 16px;
    }

    .explorer__toolbar {
      grid-template-columns: 1fr;
    }

    .explorer__control:last-child {
      grid-column: auto;
    }

    .explorer__grid {
      grid-template-columns: 1fr;
    }

    .explorer__empty-actions {
      flex-direction: column;
    }

    .explorer__empty-actions .btn {
      width: 100%;
    }
  }
</style>
