---
import { navLinks, site } from '../data/site';
---

<nav class="nav" aria-label="Navegación principal" data-nav>
  <div class="nav__inner">
    <a class="nav__logo" href="/#inicio" aria-label={`${site.name}, ir al inicio`}>
      {site.shortName}
    </a>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Abrir menú de navegación"
      data-nav-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav__menu" id="nav-menu" data-nav-menu>
      {navLinks.map((link) => (
        <li>
          <a class="nav__link" href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (nav) {
    const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const menu = nav.querySelector<HTMLElement>('[data-nav-menu]');
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.nav__link'));

    const closeMenu = () => {
      if (!toggle || !menu) return;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú de navegación');
      menu.dataset.open = 'false';
    };

    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Abrir menú de navegación' : 'Cerrar menú de navegación');
      if (menu) menu.dataset.open = String(!isOpen);
    });

    links.forEach((link) => link.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node)) closeMenu();
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) closeMenu();
    });

    /* --- Indicador de sección activa ---
       Recorre las secciones enlazadas y marca la última que pasó
       el umbral superior. Así el usuario siempre sabe dónde está. */
    const isHome = window.location.pathname === '/';
    const sections = isHome
      ? links
          .map((link) => {
            const href = link.getAttribute('href');
            const hash = href?.includes('#') ? `#${href.split('#')[1]}` : null;
            const section = hash ? document.querySelector<HTMLElement>(hash) : null;
            return section ? { link, section } : null;
          })
          .filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(item))
      : [];

    if (!isHome && window.location.pathname.startsWith('/proyectos/')) {
      const projectsLink = links.find((link) => link.getAttribute('href')?.endsWith('#proyectos'));
      projectsLink?.setAttribute('aria-current', 'page');
    }

    let ticking = false;

    const updateActiveLink = () => {
      if (sections.length === 0) return;
      const threshold = window.scrollY + 160;
      let active = sections[0];

      sections.forEach((item) => {
        if (item.section.offsetTop <= threshold) active = item;
      });

      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 4) {
        active = sections[sections.length - 1];
      }

      sections.forEach(({ link }) => {
        if (link === active?.link) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      ticking = false;
    };

    const requestUpdate = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateActiveLink);
        ticking = true;
      }
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    updateActiveLink();
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: var(--nav-height);
    background: rgba(255, 248, 220, 0.94);
    border-bottom: 2px solid var(--color-plum);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--container-width);
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
  }

  .nav__logo {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-plum);
    transition: opacity var(--transition);
  }

  .nav__logo:hover {
    opacity: 0.65;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.8vw, 24px);
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding: 7px 10px;
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--color-plum-soft);
    transition: color var(--transition), background var(--transition);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    right: 10px;
    bottom: 2px;
    left: 10px;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-terracotta);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .nav__link:hover,
  .nav__link[aria-current='location'],
  .nav__link[aria-current='page'] {
    background: var(--color-mustard);
    color: var(--color-plum);
  }

  .nav__link:hover::after,
  .nav__link[aria-current='location']::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
  }

  .nav__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-plum);
    transition: transform var(--transition), opacity var(--transition);
  }

  .nav__toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .nav__toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .nav__toggle {
      display: flex;
    }

    .nav__menu {
      position: fixed;
      top: var(--nav-height);
      right: 0;
      left: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 12px 24px 20px;
      background: var(--color-bg);
      border-bottom: 2px solid var(--color-plum);
      box-shadow: 0 10px 0 rgba(108, 3, 69, 0.12);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
      transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
    }

    .nav__menu[data-open='true'] {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav__menu li {
      border-bottom: 1px solid var(--color-border);
    }

    .nav__menu li:last-child {
      border-bottom: none;
    }

    .nav__link {
      display: block;
      padding: 14px 0;
      font-size: 1rem;
    }

    .nav__link::after {
      display: none;
    }
  }
</style>
