---
/**
 * Galería editorial con parallax para las páginas internas de proyecto.
 *
 * Layout: las imágenes se agrupan en filas que alternan ancho completo con
 * pares en dos columnas escalonadas. Al scrollear, cada columna se desplaza a
 * distinta velocidad (`transform: translateY(...)`) mediante un único loop de
 * requestAnimationFrame, y la imagen escala lo mínimo necesario para que nunca
 * se vea el borde del marco.
 *
 * Accesibilidad: sin JS las imágenes se ven completas y en orden; con
 * `prefers-reduced-motion` o en mobile no se aplica ningún transform.
 */
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const images = project.media.type === 'images' ? project.media.images : [];

type Row = {
  kind: 'full' | 'pair';
  items: { src: string; index: number }[];
};

const rows: Row[] = [];

if (images.length > 0) {
  rows.push({ kind: 'full', items: [{ src: images[0], index: 1 }] });
  let cursor = 1;
  let step = 0;

  // Ritmo editorial: par, par, ancho completo.
  while (cursor < images.length) {
    const remaining = images.length - cursor;

    if (remaining === 1 || step % 3 === 2) {
      rows.push({ kind: 'full', items: [{ src: images[cursor], index: cursor + 1 }] });
      cursor += 1;
    } else {
      const items = images
        .slice(cursor, cursor + 2)
        .map((src, offset) => ({ src, index: cursor + offset + 1 }));
      rows.push({ kind: 'pair', items });
      cursor += items.length;
    }

    step += 1;
  }
}

const total = images.length;
const pad = (value: number) => String(value).padStart(2, '0');
const speeds = [0.052, 0.03];
---

<div class="gallery" data-gallery>
  {rows.map((row, rowIndex) => (
    <div
      class:list={[
        'gallery__row',
        `gallery__row--${row.kind}`,
        { 'gallery__row--offset': rowIndex % 2 === 1 },
      ]}
    >
      {row.items.map((item, itemIndex) => (
        <figure
          class="gallery__frame"
          data-parallax
          data-speed={String(row.kind === 'full' ? 0.038 : speeds[itemIndex % speeds.length])}
        >
          <img
            src={item.src}
            alt={`${project.media.alt} — imagen ${item.index} de ${total}`}
            loading={rowIndex === 0 && itemIndex === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <span class="gallery__num" aria-hidden="true">{pad(item.index)}</span>
        </figure>
      ))}
    </div>
  ))}
</div>

<script>
  const galleries = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const compact = window.matchMedia('(max-width: 820px)');

  galleries.forEach((gallery) => {
    const frames = Array.from(gallery.querySelectorAll<HTMLElement>('[data-parallax]'));
    if (frames.length === 0) return;

    const active = () => !reduceMotion.matches && !compact.matches;

    const syncActive = () => {
      const enabled = active();
      gallery.classList.toggle('is-active', enabled);
      if (!enabled) {
        frames.forEach((frame) => {
          const image = frame.querySelector<HTMLImageElement>('img');
          image?.style.removeProperty('--gallery-y');
          image?.style.removeProperty('--gallery-scale');
        });
      }
      return enabled;
    };

    // Revelado suave dentro del marco (sólo la primera vez).
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -6% 0px', threshold: 0.1 },
      );

      frames.forEach((frame) => observer.observe(frame));
    } else {
      frames.forEach((frame) => frame.classList.add('is-visible'));
    }

    let frameRequest = 0;

    const render = () => {
      frameRequest = 0;
      if (!syncActive()) return;

      const viewport = window.innerHeight || 1;

      frames.forEach((frame) => {
        const image = frame.querySelector<HTMLImageElement>('img');
        if (!image) return;

        const rect = frame.getBoundingClientRect();
        if (rect.bottom < -160 || rect.top > viewport + 160) return;

        const speed = Number(frame.dataset.speed ?? '0.04');
        const center = rect.top + rect.height / 2;
        const progress = (center - viewport / 2) / viewport;
        const max = Math.max(0, rect.height * 0.03);
        const offset = Math.max(-max, Math.min(max, -progress * speed * viewport));
        const scale = 1 + (2 * Math.abs(offset)) / Math.max(rect.height, 1);

        image.style.setProperty('--gallery-y', `${offset.toFixed(2)}px`);
        image.style.setProperty('--gallery-scale', scale.toFixed(4));
      });
    };

    const requestRender = () => {
      if (frameRequest) return;
      frameRequest = window.requestAnimationFrame(render);
    };

    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', requestRender);
    reduceMotion.addEventListener('change', requestRender);
    compact.addEventListener('change', requestRender);

    render();
  });
</script>

<style>
  .gallery {
    display: grid;
    gap: clamp(16px, 3vw, 34px);
    margin-bottom: clamp(32px, 5vw, 52px);
  }

  .gallery__row {
    display: grid;
    gap: clamp(14px, 2.4vw, 26px);
    align-items: start;
  }

  .gallery__row--pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .gallery__row--offset .gallery__frame:nth-child(2) {
    margin-top: clamp(24px, 6vw, 84px);
  }

  .gallery__row--pair:not(.gallery__row--offset) .gallery__frame:nth-child(2) {
    margin-top: clamp(14px, 3vw, 38px);
  }

  .gallery__frame {
    position: relative;
    overflow: hidden;
    margin: 0;
    border: 1.5px solid var(--color-plum);
    border-radius: 3px;
    background: var(--color-ink);
  }

  .gallery__frame img {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: center center;
  }

  /* Sólo con JS activo: parallax + revelado. Sin JS no se recorta nada. */
  .gallery.is-active .gallery__frame {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 640ms ease, transform 640ms ease;
  }

  .gallery.is-active .gallery__frame.is-visible {
    opacity: 1;
    transform: none;
  }

  .gallery.is-active .gallery__frame img {
    transform: translate3d(0, var(--gallery-y, 0px), 0) scale(var(--gallery-scale, 1));
  }

  .gallery__num {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    padding: 3px 8px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-cream);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-plum);
  }

  @media (max-width: 820px) {
    .gallery__row--pair {
      grid-template-columns: 1fr;
    }

    .gallery__row--offset .gallery__frame:nth-child(2),
    .gallery__row--pair:not(.gallery__row--offset) .gallery__frame:nth-child(2) {
      margin-top: 0;
    }

    .gallery__frame {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery.is-active .gallery__frame,
    .gallery.is-active .gallery__frame.is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .gallery.is-active .gallery__frame img {
      transform: none;
    }
  }
</style>
