---
import SectionHeading from './SectionHeading.astro';
import { GITHUB_USERNAME } from '../data/github';
---

<section class="github section section--alt" id="actividad" aria-labelledby="actividad-title">
  <div class="container">
    <SectionHeading
      eyebrow="Actividad técnica"
      title="Lo que estoy construyendo en GitHub"
      description="Este bloque consume la API pública de GitHub en tiempo real. Si la API falla, alcanza el límite de solicitudes o no hay conexión, la interfaz lo informa y ofrece datos de respaldo locales."
      id="actividad-title"
    />

    <div class="github__panel" data-github data-state="loading" aria-busy="true">
      <div class="github__toolbar" data-toolbar hidden>
        <div class="github__search">
          <label for="repo-search">Buscar repositorio</label>
          <input
            id="repo-search"
            type="search"
            data-repo-search
            placeholder="Ej. portfolio, backend, ecommerce"
            autocomplete="off"
            aria-controls="github-grid"
          />
        </div>

        <div class="github__languages" role="group" aria-label="Filtrar por lenguaje" data-languages></div>

        <button class="github__reset" type="button" data-reset>Limpiar filtros</button>
      </div>

      <div class="github__meta">
        <p class="github__status" role="status" aria-live="polite" data-status>
          Cargando repositorios de GitHub…
        </p>

        <div class="github__source" data-source hidden>
          <span class="github__source-label" data-source-label></span>
          <button class="github__source-button" type="button" data-retry-api>Actualizar</button>
        </div>
      </div>

      <div class="github__loading" data-loading aria-hidden="true">
        {[0, 1, 2].map(() => (
          <div class="github__skeleton">
            <span class="github__skeleton-line github__skeleton-line--title"></span>
            <span class="github__skeleton-line"></span>
            <span class="github__skeleton-line github__skeleton-line--short"></span>
            <span class="github__skeleton-line github__skeleton-line--meta"></span>
          </div>
        ))}
      </div>

      <div class="github__content" data-content hidden>
        <div class="github__grid" id="github-grid" data-grid></div>
      </div>

      <div class="github__empty" data-empty hidden>
        <p class="github__empty-title" data-empty-title>No hay repositorios para mostrar.</p>
        <p class="github__empty-message" data-empty-message>
          Probá con otro filtro o volvé a intentar.
        </p>
        <div class="github__actions">
          <button class="btn btn--primary" type="button" data-reset>Limpiar filtros</button>
          <button class="btn btn--ghost" type="button" data-empty-retry>Reintentar</button>
          <a
            class="btn btn--ghost"
            href={`https://github.com/${GITHUB_USERNAME}`}
            target="_blank"
            rel="noopener noreferrer">Ver perfil en GitHub</a
          >
        </div>
      </div>

      <div class="github__error" data-error hidden>
        <p class="github__error-title" data-error-title>No pudimos cargar la actividad.</p>
        <p class="github__error-message" data-error-message></p>
        <div class="github__actions">
          <button class="btn btn--primary" type="button" data-retry>Reintentar</button>
          <button class="btn btn--ghost" type="button" data-fallback>Usar datos de respaldo</button>
        </div>
      </div>
    </div>

    <div class="github__footer">
      <a
        class="btn btn--ghost"
        href={`https://github.com/${GITHUB_USERNAME}`}
        target="_blank"
        rel="noopener noreferrer">Ver perfil de GitHub</a
      >
      <p>API pública de GitHub · sin claves privadas · datos actualizados al abrir la página</p>
    </div>

    <noscript>
      <style is:inline>
        [data-github] {
          display: none;
        }
      </style>
      <p class="github__noscript">
        Activá JavaScript para ver la actividad en tiempo real.
        <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener noreferrer"
          >Ver repositorios en GitHub</a
        >.
      </p>
    </noscript>
  </div>
</section>

<script>
  import { fallbackRepos, GITHUB_API_URL, type GitHubRepo } from '../data/github';

  const panel = document.querySelector<HTMLElement>('[data-github]');

  if (panel) {
    const get = <T extends HTMLElement>(selector: string) => panel.querySelector<T>(selector);

    const toolbar = get<HTMLElement>('[data-toolbar]');
    const search = get<HTMLInputElement>('[data-repo-search]');
    const languages = get<HTMLElement>('[data-languages]');
    const status = get<HTMLElement>('[data-status]');
    const source = get<HTMLElement>('[data-source]');
    const sourceLabel = get<HTMLElement>('[data-source-label]');
    const loading = get<HTMLElement>('[data-loading]');
    const content = get<HTMLElement>('[data-content]');
    const grid = get<HTMLElement>('[data-grid]');
    const empty = get<HTMLElement>('[data-empty]');
    const emptyTitle = get<HTMLElement>('[data-empty-title]');
    const emptyMessage = get<HTMLElement>('[data-empty-message]');
    const emptyRetry = get<HTMLButtonElement>('[data-empty-retry]');
    const emptyReset = empty.querySelector<HTMLButtonElement>('[data-reset]');
    const error = get<HTMLElement>('[data-error]');
    const errorTitle = get<HTMLElement>('[data-error-title]');
    const errorMessage = get<HTMLElement>('[data-error-message]');
    const retryButton = get<HTMLButtonElement>('[data-retry]');
    const fallbackButton = get<HTMLButtonElement>('[data-fallback]');
    const retryApiButton = get<HTMLButtonElement>('[data-retry-api]');
    const resetButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-reset]'));

    type ViewState = 'loading' | 'success' | 'empty' | 'error';
    type Source = 'api' | 'fallback';

    let repos: GitHubRepo[] = [];
    let language = 'all';
    let query = '';
    let sourceType: Source = 'api';
    let requestId = 0;
    let controller: AbortController | null = null;

    const setView = (view: ViewState) => {
      panel.dataset.state = view;
      panel.setAttribute('aria-busy', String(view === 'loading'));
      loading.hidden = view !== 'loading';
      content.hidden = view !== 'success';
      empty.hidden = view !== 'empty';
      error.hidden = view !== 'error';
    };

    const setSource = (type: Source) => {
      sourceType = type;
      source.hidden = false;
      source.dataset.source = type;

      if (type === 'fallback') {
        sourceLabel.textContent = 'Datos de respaldo locales';
        retryApiButton.textContent = 'Reintentar API';
      } else {
        sourceLabel.textContent = 'Datos en vivo de GitHub';
        retryApiButton.textContent = 'Actualizar';
      }
    };

    const normalize = (value: string) =>
      value
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();

    const formatDate = (value: string) => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return value;

      return new Intl.DateTimeFormat('es-AR', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
      }).format(date);
    };

    const createCard = (repo: GitHubRepo) => {
      const card = document.createElement('article');
      card.className = 'gh-card';

      const header = document.createElement('div');
      header.className = 'gh-card__header';

      const title = document.createElement('h3');
      title.className = 'gh-card__title';

      const link = document.createElement('a');
      link.href = repo.html_url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = repo.name;
      title.append(link);

      if (repo.fork) {
        const fork = document.createElement('span');
        fork.className = 'gh-card__fork';
        fork.textContent = 'fork';
        title.append(fork);
      }

      const languageTag = document.createElement('span');
      languageTag.className = 'gh-card__language';
      languageTag.textContent = repo.language ?? 'Sin lenguaje';

      header.append(title, languageTag);

      const description = document.createElement('p');
      description.className = 'gh-card__description';
      description.textContent = repo.description ?? 'Sin descripción.';

      const meta = document.createElement('div');
      meta.className = 'gh-card__meta';

      const stars = document.createElement('span');
      stars.textContent = `★ ${repo.stargazers_count ?? 0}`;

      const updated = document.createElement('span');
      updated.textContent = `Actualizado ${formatDate(repo.updated_at)}`;

      meta.append(stars, updated);

      const footer = document.createElement('a');
      footer.className = 'gh-card__link';
      footer.href = repo.html_url;
      footer.target = '_blank';
      footer.rel = 'noopener noreferrer';
      footer.textContent = 'Ver repositorio ↗';

      card.append(header, description, meta, footer);
      return card;
    };

    const renderLanguages = () => {
      const available = Array.from(
        new Set(
          repos
            .map((repo) => repo.language)
            .filter((value): value is string => Boolean(value)),
        ),
      );

      if (language !== 'all' && !available.includes(language)) language = 'all';

      const options = ['all', ...available];

      languages.replaceChildren(
        ...options.map((option) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'gh-filter';
          button.dataset.language = option;
          button.setAttribute('aria-pressed', String(language === option));
          button.setAttribute('aria-controls', 'github-grid');
          button.textContent = option === 'all' ? 'Todos' : option;

          button.addEventListener('click', () => {
            language = option;

            languages.querySelectorAll<HTMLButtonElement>('[data-language]').forEach((item) => {
              item.setAttribute('aria-pressed', String(item.dataset.language === language));
            });

            renderFiltered();
          });

          return button;
        }),
      );
    };

    const updateFilterStatus = (visible: number) => {
      const parts = [`${visible} de ${repos.length} repositorios`];

      if (language !== 'all') parts.push(`lenguaje ${language}`);
      if (query.trim()) parts.push(`búsqueda “${query.trim()}”`);

      status.textContent = `${parts.join(' · ')}. ${
        sourceType === 'fallback' ? 'Datos de respaldo locales.' : 'Datos en vivo de GitHub.'
      }`;
    };

    const renderEmpty = (title: string, message: string) => {
      setView('empty');
      toolbar.hidden = repos.length === 0;
      emptyTitle.textContent = title;
      emptyMessage.textContent = message;
      status.textContent = title;

      if (emptyReset) emptyReset.hidden = repos.length === 0;
      emptyRetry.hidden = repos.length > 0;
    };

    const renderFiltered = () => {
      if (repos.length === 0) {
        renderEmpty(
          'No hay repositorios públicos para mostrar.',
          'El perfil no devolvió repositorios en este momento. Podés verlos directamente en GitHub.',
        );
        return;
      }

      const normalizedQuery = normalize(query.trim());

      const filtered = repos.filter((repo) => {
        const matchesLanguage = language === 'all' || repo.language === language;
        const haystack = normalize(`${repo.name} ${repo.description ?? ''} ${repo.language ?? ''}`);
        return matchesLanguage && (normalizedQuery === '' || haystack.includes(normalizedQuery));
      });

      if (filtered.length === 0) {
        renderEmpty(
          'No hay repositorios con ese filtro.',
          'Probá con otro lenguaje o una palabra clave distinta.',
        );
        return;
      }

      setView('success');
      toolbar.hidden = false;
      grid.replaceChildren(...filtered.map(createCard));
      updateFilterStatus(filtered.length);
    };

    const showError = (title: string, message: string) => {
      setView('error');
      toolbar.hidden = true;
      source.hidden = true;
      errorTitle.textContent = title;
      errorMessage.textContent = message;
      status.textContent = title;
    };

    const useFallback = () => {
      repos = fallbackRepos;
      language = 'all';
      query = '';
      search.value = '';
      setSource('fallback');
      renderLanguages();
      renderFiltered();
    };

    const loadRepos = async () => {
      const currentRequest = ++requestId;

      controller?.abort();
      const localController = new AbortController();
      controller = localController;

      const timeout = window.setTimeout(() => localController.abort(), 10000);

      setView('loading');
      toolbar.hidden = true;
      source.hidden = true;
      status.textContent = 'Cargando repositorios de GitHub…';

      try {
        const response = await fetch(GITHUB_API_URL, {
          headers: { Accept: 'application/vnd.github+json' },
          cache: 'no-store',
          signal: localController.signal,
        });

        if (currentRequest !== requestId) return;

        if (!response.ok) {
          const remaining = response.headers.get('x-ratelimit-remaining');
          const reset = response.headers.get('x-ratelimit-reset');

          if (response.status === 403 || response.status === 429 || remaining === '0') {
            const resetSeconds = reset ? Number(reset) : Number.NaN;
            const resetLabel = Number.isFinite(resetSeconds)
              ? new Date(resetSeconds * 1000).toLocaleTimeString('es-AR', {
                  hour: '2-digit',
                  minute: '2-digit',
                })
              : null;

            throw new Error(
              `GitHub limitó las solicitudes (rate limit).${
                resetLabel ? ` Podés reintentar después de las ${resetLabel}.` : ''
              } Mientras tanto, usá los datos de respaldo.`,
            );
          }

          throw new Error(`La API respondió con el estado ${response.status}.`);
        }

        const data: unknown = await response.json();

        if (currentRequest !== requestId) return;
        if (!Array.isArray(data)) throw new Error('La API devolvió un formato inesperado.');

        repos = (data as GitHubRepo[]).filter(
          (repo) => typeof repo?.name === 'string' && typeof repo?.html_url === 'string',
        );

        language = 'all';
        query = '';
        search.value = '';
        setSource('api');
        renderLanguages();
        renderFiltered();
      } catch (caught) {
        if (currentRequest !== requestId) return;

        const caughtError = caught as Error;

        if (caughtError.name === 'AbortError') {
          showError(
            'La solicitud tardó demasiado.',
            'GitHub no respondió en 10 segundos. Revisá tu conexión, reintentá o usá los datos de respaldo.',
          );
        } else {
          showError(
            'No pudimos cargar la actividad de GitHub.',
            caughtError.message || 'Ocurrió un error inesperado al consultar la API.',
          );
        }
      } finally {
        window.clearTimeout(timeout);
      }
    };

    search.addEventListener('input', () => {
      query = search.value;
      renderFiltered();
    });

    resetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        language = 'all';
        query = '';
        search.value = '';
        renderLanguages();
        renderFiltered();
        if (!toolbar.hidden) search.focus();
      });
    });

    emptyRetry.addEventListener('click', loadRepos);
    retryButton.addEventListener('click', loadRepos);
    retryApiButton.addEventListener('click', loadRepos);
    fallbackButton.addEventListener('click', useFallback);

    loadRepos();
  }
</script>

<style>
  .github__panel {
    margin-top: 32px;
  }

  .github__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 16px;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .github__search {
    display: flex;
    flex: 1 1 260px;
    flex-direction: column;
    gap: 6px;
  }

  .github__search label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .github__search input {
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-bg);
    font: inherit;
    color: var(--color-ink);
  }

  .github__languages {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  :global(.gh-filter) {
    min-height: 36px;
    padding: 6px 12px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-bg);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  :global(.gh-filter:hover) {
    border-color: var(--color-accent);
    color: var(--color-accent-deep);
  }

  :global(.gh-filter[aria-pressed='true']) {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: #fff;
  }

  .github__reset {
    min-height: 44px;
    padding: 0 8px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .github__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 18px 0;
  }

  .github__status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .github__source {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
  }

  .github__source-label {
    padding: 5px 9px;
    border-radius: 100px;
    background: var(--color-bg);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .github__source[data-source='fallback'] .github__source-label {
    background: #fff1e2;
    color: #8a4b00;
  }

  .github__source-button {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .github__loading,
  .github__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .github__skeleton {
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .github__skeleton-line {
    display: block;
    height: 12px;
    margin-bottom: 12px;
    border-radius: 100px;
    background: linear-gradient(
      90deg,
      var(--color-border) 25%,
      var(--color-bg) 50%,
      var(--color-border) 75%
    );
    background-size: 200% 100%;
    animation: github-shimmer 1.4s ease-in-out infinite;
  }

  .github__skeleton-line--title {
    width: 60%;
    height: 18px;
  }

  .github__skeleton-line--short {
    width: 75%;
  }

  .github__skeleton-line--meta {
    width: 45%;
    margin-top: 24px;
    margin-bottom: 0;
  }

  :global(.gh-card) {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: transform var(--transition), border-color var(--transition),
      box-shadow var(--transition);
  }

  :global(.gh-card:hover) {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: 0 12px 28px rgba(37, 33, 30, 0.07);
  }

  :global(.gh-card__header) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  :global(.gh-card__title) {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  :global(.gh-card__title a) {
    color: var(--color-ink);
    text-decoration: none;
  }

  :global(.gh-card__title a:hover) {
    color: var(--color-accent-deep);
  }

  :global(.gh-card__fork) {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 6px;
    border-radius: 100px;
    background: var(--color-bg);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  :global(.gh-card__language) {
    flex: 0 0 auto;
    padding: 4px 8px;
    border-radius: 100px;
    background: var(--color-bg);
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  :global(.gh-card__description) {
    flex: 1;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  :global(.gh-card__meta) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--color-border);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  :global(.gh-card__link) {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent-deep);
    text-decoration: none;
  }

  :global(.gh-card__link:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .github__empty,
  .github__error {
    padding: 32px;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-align: center;
  }

  .github__empty-title,
  .github__error-title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .github__empty-message,
  .github__error-message {
    max-width: 60ch;
    margin: 0 auto 20px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .github__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .github__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 24px;
  }

  .github__footer p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .github__noscript {
    margin-top: 16px;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  @keyframes github-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (max-width: 900px) {
    .github__loading,
    .github__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .github__loading,
    .github__grid {
      grid-template-columns: 1fr;
    }

    .github__meta,
    .github__footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .github__source {
      flex-wrap: wrap;
    }

    .github__empty,
    .github__error {
      padding: 24px 18px;
    }

    .github__actions .btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .github__skeleton-line {
      animation: none;
    }

    :global(.gh-card) {
      transition: none;
    }

    :global(.gh-card:hover) {
      transform: none;
    }
  }
</style>
