---
import type { Project } from '../data/projects';
import ProjectGallery from './ProjectGallery.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="project-media" data-project-media>
  {project.media.type === 'video' ? (
    <>
      <figure class="project-media__frame">
        <div class="project-media__video">
          <video controls preload="metadata" poster={project.media.poster} width="1080" height="1920">
            <source src={project.media.src} type="video/mp4" />
            Tu navegador no puede reproducir este video.
          </video>
        </div>
        <figcaption class="project-media__plate">
          <span>Lámina #01</span>
          <span class="project-media__plate-star" aria-hidden="true">✦</span>
        </figcaption>
      </figure>
      <p class="project-media__caption">{project.media.caption}</p>
      <p class="project-media__note">
        Nota de accesibilidad: el video no cuenta con subtítulos ni audiodescripción.
      </p>
    </>
  ) : (
    <>
      <ProjectGallery project={project} />
      <p class="project-media__caption">{project.media.caption}</p>
    </>
  )}
</div>

<style>
  .project-media {
    margin-bottom: clamp(32px, 5vw, 52px);
  }

  .project-media__frame {
    margin: 0;
  }

  .project-media__video {
    display: flex;
    justify-content: center;
    padding: clamp(14px, 2vw, 22px);
    border: 2px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-plum);
    box-shadow: var(--shadow-sticker);
  }

  .project-media__video video {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 76vh;
    border-radius: 2px;
  }

  /* Pie de lámina fuera del video. */
  .project-media__plate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 2px 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-media__plate-star {
    font-size: 0.82rem;
    color: var(--color-terracotta);
  }

  .project-media__caption {
    margin-top: 10px;
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .project-media__note {
    margin-top: 4px;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .project-media__video {
      padding: 10px;
    }
  }
</style>
