---
import { site } from '../data/site';
---

<footer class="footer" id="contacto">
  <div class="footer__inner">
    <p class="footer__eyebrow">Contacto</p>
    <h2>¿Buscás incorporar una Project Manager y Diseñadora UX/UI a tu equipo?</h2>
    <p class="footer__text">
      Estoy disponible para conversar sobre oportunidades de producto, gestión
      de proyectos digitales y diseño de experiencias. El portfolio completo de
      diseño e identidad está disponible en Behance.
    </p>

    <div class="footer__actions">
      <a class="btn btn--primary" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      <a class="btn btn--behance" href={site.behance} target="_blank" rel="noopener noreferrer">
        Ver portfolio en Behance
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <ul class="footer__social" aria-label="Redes y perfiles">
      <li>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
          </svg>
          LinkedIn
        </a>
      </li>
      <li>
        <a href={site.behance} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22 7h-7V5h7v2Zm1.73 10c-.44 1.3-2.03 3-5.1 3-3.08 0-5.57-1.73-5.57-5.68 0-3.9 2.33-5.92 5.47-5.92 3.08 0 4.96 1.78 5.37 4.43.08.5.11 1.19.1 2.14h-8.03c.13 3.21 3.48 3.31 4.59 2.03h3.17Zm-7.69-4h4.97c-.11-1.55-1.14-2.22-2.11-2.22-1.03 0-1.8.61-2.06 2.22ZM6.47 19.99H0V5.02h6.95c5.48.08 5.58 5.44 2.72 6.9 3.46 1.26 3.58 8.07-3.2 8.07Zm-6.72-8h6.32c-.66-1.31-1.54-1.32-2.31-1.32-1.03 0-1 .97-2.01 1.32Z" />
          </svg>
          Behance
        </a>
      </li>
      <li>
        <a href={site.github} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2.2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.2-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.75.81 1.2 1.84 1.2 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
          </svg>
          GitHub
        </a>
      </li>
      <li>
        <a href={`mailto:${site.email}`}>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Email
        </a>
      </li>
    </ul>

    <p class="footer__copy">
      © {new Date().getFullYear()} {site.name} · Portfolio multimedial construido con AstroJS.
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: clamp(24px, 5vw, 56px);
    padding: clamp(64px, 9vw, 112px) 24px 36px;
    border-radius: clamp(28px, 5vw, 52px) clamp(28px, 5vw, 52px) 0 0;
    background:
      radial-gradient(ellipse 55% 60% at 15% 0%, rgba(220, 107, 25, 0.28), transparent 70%),
      var(--color-ink);
    color: var(--color-ink-text);
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: -70px;
    right: -60px;
    width: 240px;
    height: 240px;
    border: 2px solid rgba(255, 248, 220, 0.22);
    border-radius: 46% 54% 62% 38% / 48% 42% 58% 52%;
  }

  .footer__inner {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .footer__eyebrow {
    display: inline-flex;
    margin-bottom: 18px;
    padding: 6px 14px;
    border: 2px solid var(--color-cream);
    border-radius: var(--radius-pill);
    background: var(--color-mustard);
    box-shadow: 3px 3px 0 var(--color-cream);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-plum-deep);
  }

  .footer h2 {
    font-size: clamp(1.7rem, 4.2vw, 2.8rem);
    margin-bottom: 18px;
    color: var(--color-ink-text);
  }

  .footer__text {
    max-width: 580px;
    margin: 0 auto 30px;
    color: var(--color-ink-muted);
  }

  .footer__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 34px;
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    padding-top: 28px;
    border-top: 2px dashed rgba(255, 248, 220, 0.28);
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 16px;
    border: 1.5px solid rgba(255, 248, 220, 0.28);
    border-radius: var(--radius-pill);
    background: rgba(255, 248, 220, 0.06);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    transition: background var(--transition), transform var(--transition),
      border-color var(--transition);
  }

  .footer__social a:hover {
    background: rgba(255, 248, 220, 0.14);
    border-color: var(--color-mustard);
    transform: translateY(-2px) rotate(-1deg);
  }

  .footer__copy {
    margin-top: 36px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 560px) {
    .footer__actions {
      flex-direction: column;
    }

    .footer__actions .btn {
      width: 100%;
    }
  }
</style>
