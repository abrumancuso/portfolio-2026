---
import { heroAreas, heroBody, heroEyebrow, heroFirstName, heroLastName, heroRole } from '../data/site';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__blob hero__blob--plum" aria-hidden="true"></div>
  <div class="hero__blob hero__blob--peach" aria-hidden="true"></div>

  <svg class="hero__doodle hero__doodle--star" aria-hidden="true" viewBox="0 0 100 100" width="86" height="86">
    <path
      d="M50 2c3 18 8 27 22 30-14 4-19 12-22 30-3-18-8-26-22-30 14-3 19-12 22-30Z"
      fill="#F7C566"
      stroke="#6C0345"
      stroke-width="3"
      stroke-linejoin="round"
    />
  </svg>

  <svg class="hero__doodle hero__doodle--smiley" aria-hidden="true" viewBox="0 0 100 100" width="78" height="78">
    <circle cx="50" cy="50" r="42" fill="#DC6B19" stroke="#6C0345" stroke-width="3.5" />
    <circle cx="37" cy="42" r="4.5" fill="#6C0345" />
    <circle cx="63" cy="42" r="4.5" fill="#6C0345" />
    <path d="M33 60c6 9 28 9 34 0" fill="none" stroke="#6C0345" stroke-width="4" stroke-linecap="round" />
  </svg>

  <svg class="hero__doodle hero__doodle--sparkle" aria-hidden="true" viewBox="0 0 40 40" width="42" height="42">
    <path d="M20 1c1.6 9 4.4 13.4 13 15-8.6 1.6-11.4 6-13 15-1.6-9-4.4-13.4-13-15 8.6-1.6 11.4-6 13-15Z" fill="#6C0345" />
  </svg>

  <div class="hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow"><span class="hero__dot" aria-hidden="true"></span>{heroEyebrow}</p>

      <h1 class="hero__title" id="hero-title">
        {heroFirstName}
        <span class="hero__last">
          {heroLastName}
          <svg class="hero__underline" aria-hidden="true" viewBox="0 0 240 22" preserveAspectRatio="none">
            <path
              d="M3 15c38-9 76-11 114-8 39 3 78 8 120 3"
              fill="none"
              stroke="#DC6B19"
              stroke-width="7"
              stroke-linecap="round"
            />
          </svg>
        </span>
      </h1>

      <p class="hero__role">{heroRole}</p>
      <p class="hero__thesis">{heroBody}</p>

      <div class="hero__stickers" aria-hidden="true">
        <span class="hero__sticker hero__sticker--cream">
          <span class="hero__sticker-emoji">✨</span> 4.º año · UMAI
        </span>
        <span class="hero__sticker hero__sticker--mustard">PM + UX/UI</span>
        <span class="hero__sticker hero__sticker--plum">Buenos Aires</span>
      </div>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#proyectos">Explorar proyectos</a>
        <a class="btn btn--ghost" href="#rituales">Probar la calculadora</a>
      </div>
    </div>

    <aside class="hero__index" aria-label="Foco profesional">
      <span class="hero__index-pin" aria-hidden="true">✦</span>
      <p class="hero__index-title">Mi foco</p>
      <ol>
        {heroAreas.map((area) => (
          <li><span>{area.number}</span> {area.label}</li>
        ))}
      </ol>
      <p class="hero__index-note">
        Investigación, estrategia y ejecución: el puente entre la necesidad de
        una persona y un producto que funciona.
      </p>
      <p class="hero__index-status">
        <span class="hero__index-dot" aria-hidden="true"></span>
        Disponible para proyectos
      </p>
    </aside>
  </div>

  <a class="hero__scroll" href="#sobre-mi">
    <span>Scroll para explorar</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--nav-height));
    padding: clamp(64px, 8vw, 116px) 24px;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 50% at 12% 15%, rgba(247, 197, 102, 0.55), transparent 68%),
      radial-gradient(ellipse 45% 45% at 88% 78%, rgba(220, 107, 25, 0.16), transparent 70%),
      var(--color-bg);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(108, 3, 69, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(108, 3, 69, 0.08) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(ellipse 78% 75% at 50% 45%, #000 35%, transparent 100%);
    pointer-events: none;
  }

  .hero__blob {
    position: absolute;
    border-radius: 46% 54% 62% 38% / 48% 42% 58% 52%;
    pointer-events: none;
  }

  .hero__blob--plum {
    right: -140px;
    bottom: -180px;
    width: 460px;
    height: 420px;
    background: rgba(108, 3, 69, 0.08);
    transform: rotate(-12deg);
  }

  .hero__blob--peach {
    top: -120px;
    left: -110px;
    width: 340px;
    height: 320px;
    background: rgba(251, 227, 196, 0.9);
    transform: rotate(18deg);
  }

  .hero__doodle {
    position: absolute;
    z-index: 1;
    filter: drop-shadow(3px 3px 0 rgba(108, 3, 69, 0.2));
    pointer-events: none;
  }

  .hero__doodle--star {
    top: clamp(28px, 9vw, 92px);
    right: clamp(20px, 7vw, 110px);
    transform: rotate(12deg);
    animation: hero-float 6s ease-in-out infinite;
  }

  .hero__doodle--smiley {
    right: clamp(18px, 12vw, 170px);
    bottom: clamp(110px, 16vw, 190px);
    transform: rotate(-10deg);
    animation: hero-float 7.5s ease-in-out infinite reverse;
  }

  .hero__doodle--sparkle {
    top: clamp(150px, 18vw, 240px);
    left: clamp(14px, 4vw, 54px);
    transform: rotate(-8deg);
    animation: hero-twinkle 4s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -12px;
    }
  }

  @keyframes hero-twinkle {
    0%,
    100% {
      opacity: 0.65;
      scale: 0.9;
    }
    50% {
      opacity: 1;
      scale: 1.08;
    }
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(270px, 0.7fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 22px;
    padding: 7px 15px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker-sm);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .hero__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-terracotta);
    box-shadow: 0 0 0 3px rgba(220, 107, 25, 0.22);
  }

  .hero__title {
    max-width: 12ch;
    margin-bottom: 26px;
    font-size: clamp(3.1rem, 9vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.92;
    color: var(--color-plum);
  }

  .hero__last {
    position: relative;
    display: inline-block;
    color: var(--color-terracotta);
  }

  .hero__underline {
    position: absolute;
    right: 0;
    bottom: -0.08em;
    left: 0;
    width: 100%;
    height: 0.22em;
    overflow: visible;
  }

  .hero__role {
    display: inline-block;
    margin-bottom: 18px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-mustard);
    font-family: var(--font-ui);
    font-size: clamp(0.78rem, 1.4vw, 0.92rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .hero__thesis {
    max-width: 56ch;
    margin-bottom: 26px;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.7vw, 1.14rem);
    line-height: 1.75;
  }

  .hero__stickers {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
  }

  .hero__sticker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--color-plum);
    box-shadow: var(--shadow-sticker-sm);
    transition: transform var(--transition);
  }

  .hero__sticker-emoji {
    font-size: 0.95rem;
  }

  .hero__sticker--cream {
    background: var(--color-surface);
    transform: rotate(-2deg);
  }

  .hero__sticker--mustard {
    background: var(--color-mustard);
    transform: rotate(1.5deg);
  }

  .hero__sticker--plum {
    background: var(--color-plum);
    color: var(--color-cream);
    transform: rotate(-1deg);
  }

  .hero__stickers:hover .hero__sticker {
    transform: rotate(0deg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero__index {
    position: relative;
    padding: 30px 26px 26px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-lg);
    background: var(--color-mustard);
    box-shadow: var(--shadow-sticker-lg);
    transform: rotate(1.4deg);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .hero__index:hover {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: 12px 12px 0 var(--color-plum);
  }

  .hero__index-pin {
    position: absolute;
    top: -18px;
    right: 20px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 2px solid var(--color-plum);
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker-sm);
    color: var(--color-terracotta);
    font-size: 1.05rem;
  }

  .hero__index-title {
    margin-bottom: 16px;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .hero__index ol {
    display: grid;
    gap: 10px;
  }

  .hero__index li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding-bottom: 10px;
    border-bottom: 2px dashed rgba(108, 3, 69, 0.25);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-plum-deep);
  }

  .hero__index li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .hero__index li span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-terracotta-deep);
  }

  .hero__index-note {
    margin-top: 16px;
    color: var(--color-plum-deep);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .hero__index-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 6px 12px;
    border: 2px solid var(--color-plum);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-plum);
  }

  .hero__index-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-terracotta);
    animation: hero-pulse 2s ease-in-out infinite;
  }

  @keyframes hero-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .hero__scroll {
    position: absolute;
    bottom: 22px;
    left: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    transform: translateX(-50%);
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .hero__scroll-line {
    width: 2px;
    height: 34px;
    border-radius: var(--radius-pill);
    background: linear-gradient(to bottom, var(--color-terracotta), transparent);
    animation: scroll-pulse 2.2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scaleY(0.85);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.1);
    }
  }

  @media (max-width: 980px) {
    .hero {
      min-height: auto;
      padding-block: clamp(56px, 10vw, 92px) clamp(80px, 12vw, 110px);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: clamp(36px, 7vw, 56px);
    }

    .hero__title {
      max-width: 100%;
    }

    .hero__index {
      max-width: 460px;
      transform: rotate(0.8deg);
    }

    .hero__doodle--smiley {
      bottom: 40px;
      right: 12px;
      width: 58px;
      height: 58px;
    }

    .hero__doodle--star {
      width: 62px;
      height: 62px;
    }
  }

  @media (max-width: 560px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .btn {
      width: 100%;
    }

    .hero__index {
      padding: 24px 20px 20px;
    }

    .hero__doodle--sparkle,
    .hero__doodle--smiley {
      display: none;
    }

    .hero__scroll {
      display: none;
    }
  }
</style>
