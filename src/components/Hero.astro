---
import { heroAreas, heroBody, heroEyebrow, heroFirstName, heroLastName, heroRole } from '../data/site';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow"><span class="hero__dot" aria-hidden="true"></span>{heroEyebrow}</p>

      <h1 class="hero__title" id="hero-title">
        {heroFirstName}
        <span class="hero__last">{heroLastName}</span>
      </h1>

      <p class="hero__role">{heroRole}</p>
      <p class="hero__thesis">{heroBody}</p>

      <p class="hero__stickers">
        <span class="hero__sticker">4.º año · UMAI</span>
        <span class="hero__sticker">PM + UX/UI</span>
        <span class="hero__sticker">Buenos Aires</span>
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#proyectos">Explorar proyectos</a>
        <a class="btn btn--ghost" href="#rituales">Probar la calculadora</a>
      </div>
    </div>

    <aside class="hero__index" aria-label="Foco profesional">
      <p class="hero__index-title">Mi foco</p>
      <ol>
        {heroAreas.map((area) => (
          <li><span>{area.number}</span> {area.label}</li>
        ))}
      </ol>
      <p class="hero__index-note">
        Investigación, estrategia y ejecución: el puente entre la necesidad de
        una persona y un producto que funciona.
      </p>
      <p class="hero__index-status">
        <span class="hero__index-dot" aria-hidden="true"></span>
        Disponible para proyectos
      </p>
    </aside>
  </div>

  <a class="hero__scroll" href="#sobre-mi">
    <span>Scroll para explorar</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--nav-height));
    padding: clamp(56px, 8vw, 96px) clamp(20px, 4vw, 32px);
    overflow: clip;
    background:
      radial-gradient(ellipse 60% 50% at 12% 15%, rgba(247, 197, 102, 0.32), transparent 68%),
      var(--color-bg);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(270px, 0.7fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 22px;
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-terracotta-deep);
  }

  .hero__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-terracotta);
    box-shadow: 0 0 0 3px rgba(220, 107, 25, 0.22);
  }

  .hero__title {
    max-width: 100%;
    margin-bottom: 24px;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7.5vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-plum);
    overflow-wrap: break-word;
  }

  .hero__last {
    display: inline-block;
    font-family: var(--font-script);
    font-style: italic;
    font-weight: 400;
    font-size: 1.04em;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-terracotta);
  }

  .hero__role {
    position: relative;
    display: inline-block;
    margin-bottom: 22px;
    padding: 4px 10px;
    background: transparent;
    font-family: var(--font-ui);
    font-size: clamp(0.82rem, 1.3vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .hero__role::before {
    content: '';
    position: absolute;
    inset: -5px -13px;
    border: 1.5px solid var(--color-terracotta);
    border-radius: 52% 48% 46% 54% / 58% 52% 48% 42%;
    transform: rotate(-1.5deg);
    pointer-events: none;
  }

  .hero__thesis {
    max-width: 56ch;
    margin-bottom: 24px;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .hero__stickers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 30px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__sticker {
    display: inline-flex;
    align-items: center;
  }

  .hero__sticker + .hero__sticker::before {
    content: '·';
    margin: 0 10px;
    color: var(--color-terracotta);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__index {
    position: relative;
    padding: 28px 26px 24px;
    border: 1.5px solid var(--color-plum);
    border-top: 4px solid var(--color-mustard);
    border-radius: 3px;
    background: var(--color-surface);
    transition: border-color var(--transition);
  }

  .hero__index:hover {
    border-color: var(--color-terracotta);
  }

  .hero__index-title {
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .hero__index ol {
    display: grid;
    gap: 10px;
  }

  .hero__index li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(108, 3, 69, 0.18);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-plum-deep);
  }

  .hero__index li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .hero__index li span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-terracotta-deep);
  }

  .hero__index-note {
    margin-top: 16px;
    color: var(--color-plum-deep);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .hero__index-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 6px 12px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-bg-alt);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-plum);
  }

  .hero__index-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-terracotta);
    animation: hero-pulse 2s ease-in-out infinite;
  }

  @keyframes hero-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .hero__scroll {
    position: absolute;
    bottom: 22px;
    left: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .hero__scroll-line {
    width: 1.5px;
    height: 34px;
    background: linear-gradient(to bottom, var(--color-terracotta), transparent);
    animation: scroll-pulse 2.2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scaleY(0.85);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.1);
    }
  }

  @media (max-width: 980px) {
    .hero {
      min-height: auto;
      padding-block: clamp(56px, 10vw, 92px) clamp(80px, 12vw, 110px);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: clamp(36px, 7vw, 56px);
    }

    .hero__title {
      max-width: 100%;
    }

    .hero__index {
      max-width: 460px;
    }
  }

  @media (max-width: 560px) {
    .hero__title {
      font-size: clamp(2.9rem, 15vw, 4.2rem);
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .btn {
      width: 100%;
    }

    .hero__index {
      padding: 24px 20px 20px;
    }

    .hero__scroll {
      display: none;
    }
  }
</style>
