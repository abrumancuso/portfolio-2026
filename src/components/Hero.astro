---
import { heroAreas, heroBody, heroEyebrow, heroFirstName, heroLastName, heroRole } from '../data/site';
---

<section class="hero starfield" id="inicio" aria-labelledby="hero-title">
  <span class="hero__margin deco" aria-hidden="true">
    ABRU MANCUSO * PORTFOLIO 2026 * BUENOS AIRES, ARG
  </span>

  <svg class="hero__flower hero__flower--retro deco" viewBox="0 0 100 100" width="66" height="66" aria-hidden="true" focusable="false">
    <g fill="#F7C566" stroke="#6C0345" stroke-width="2" stroke-linejoin="round">
      <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" />
      <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(72 50 50)" />
      <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(144 50 50)" />
      <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(216 50 50)" />
      <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(288 50 50)" />
    </g>
    <circle cx="50" cy="50" r="6" fill="#6C0345" />
  </svg>

  <svg class="hero__flower hero__flower--drawn deco" viewBox="0 0 80 112" width="46" height="64" fill="none" stroke="#6C0345" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M24 10c-3 4-4 8-4 12M36 10c-3 4-4 8-4 12" />
    <g>
      <ellipse cx="40" cy="26" rx="7" ry="11" />
      <ellipse cx="40" cy="26" rx="7" ry="11" transform="rotate(72 40 38)" />
      <ellipse cx="40" cy="26" rx="7" ry="11" transform="rotate(144 40 38)" />
      <ellipse cx="40" cy="26" rx="7" ry="11" transform="rotate(216 40 38)" />
      <ellipse cx="40" cy="26" rx="7" ry="11" transform="rotate(288 40 38)" />
    </g>
    <circle cx="40" cy="38" r="5" />
    <path d="M40 44c2 16-2 28-1 42" />
    <path d="M39 70c-8-3-13 2-14 8 7 1 12-2 14-8Z" />
  </svg>

  <svg class="hero__heart deco" viewBox="0 0 40 36" width="24" height="22" fill="none" stroke="#DC6B19" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M20 31S5 21 5 12a7 7 0 0 1 15-2 7 7 0 0 1 15 2c0 9-15 19-15 19Z" />
  </svg>

  <svg class="hero__twinkle deco" viewBox="0 0 40 40" width="20" height="20" fill="none" stroke="#6C0345" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M20 4c1.6 8.4 4.2 11 12.6 12.6C24.2 18.2 21.6 20.8 20 29.2 18.4 20.8 15.8 18.2 7.4 16.6 15.8 15 18.4 12.4 20 4Z" />
  </svg>

  <div class="hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow"><span class="hero__dot" aria-hidden="true"></span>{heroEyebrow}</p>

      <h1 class="hero__title" id="hero-title">
        {heroFirstName}
        <span class="hero__last">{heroLastName}</span>
      </h1>

      <span class="hero__tagline" aria-hidden="true">✦ Creative &amp; Product Mind</span>

      <p class="hero__role">{heroRole}</p>
      <p class="hero__thesis">{heroBody}</p>

      <p class="hero__stickers">
        <span class="hero__sticker">4.º año · UMAI</span>
        <span class="hero__sticker">PM + UX/UI</span>
        <span class="hero__sticker">Buenos Aires</span>
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#proyectos">Explorar proyectos</a>
        <a class="btn btn--ghost" href="#rituales">Coordinar una reunión</a>

        <div class="hero__cta-note deco" aria-hidden="true">
          <svg viewBox="0 0 90 44" width="82" height="40" fill="none" stroke="#6C0345" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 38C24 34 44 24 60 8" />
            <path d="M51 10 60 8 58 17" />
          </svg>
          <span class="deco-note">empezá por acá</span>
        </div>
      </div>
    </div>

    <aside class="hero__index" aria-label="Foco profesional">
      <p class="hero__index-title">Mi foco</p>
      <ol>
        {heroAreas.map((area) => (
          <li><span>{area.number}</span> {area.label}</li>
        ))}
      </ol>
      <p class="hero__index-note">
        Investigación, estrategia y ejecución: el puente entre la necesidad de
        una persona y un producto que funciona.
      </p>
      <p class="hero__index-status">
        <span class="hero__index-dot" aria-hidden="true"></span>
        Disponible para proyectos
      </p>
    </aside>
  </div>

  <a class="hero__scroll" href="#sobre-mi">
    <span>Scroll para explorar</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--nav-height));
    padding: clamp(56px, 8vw, 96px) clamp(20px, 4vw, 32px);
    overflow: clip;
    background:
      radial-gradient(ellipse 60% 50% at 12% 15%, rgba(247, 197, 102, 0.32), transparent 68%),
      var(--color-bg);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(270px, 0.7fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 22px;
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-terracotta-deep);
  }

  .hero__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-terracotta);
    box-shadow: 0 0 0 3px rgba(220, 107, 25, 0.22);
  }

  .hero__title {
    max-width: 100%;
    margin-bottom: 24px;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7.5vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-plum);
    overflow-wrap: break-word;
  }

  .hero__last {
    display: inline-block;
    font-family: var(--font-script);
    font-style: italic;
    font-weight: 400;
    font-size: 1.04em;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-terracotta);
  }

  .hero__role {
    position: relative;
    display: inline-block;
    margin-bottom: 22px;
    padding: 4px 10px;
    background: transparent;
    font-family: var(--font-ui);
    font-size: clamp(0.82rem, 1.3vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .hero__role::before {
    content: '';
    position: absolute;
    inset: -5px -13px;
    border: 1.5px solid var(--color-terracotta);
    border-radius: 52% 48% 46% 54% / 58% 52% 48% 42%;
    transform: rotate(-1.5deg);
    pointer-events: none;
  }

  .hero__thesis {
    max-width: 56ch;
    margin-bottom: 24px;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .hero__stickers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 30px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__sticker {
    display: inline-flex;
    align-items: center;
  }

  .hero__sticker + .hero__sticker::before {
    content: '·';
    margin: 0 10px;
    color: var(--color-terracotta);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* --- Capa decorativa editorial (no interactiva) --- */
  .hero__content {
    position: relative;
  }

  .hero__margin {
    position: absolute;
    left: clamp(4px, 1.2vw, 12px);
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-plum);
    opacity: 0.5;
    z-index: 2;
    pointer-events: none;
  }

  .hero__tagline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-terracotta-deep);
  }

  .hero__flower--retro {
    right: clamp(8px, 3vw, 42px);
    bottom: clamp(64px, 11vw, 132px);
    transform: rotate(-8deg);
    z-index: 1;
  }

  .hero__flower--drawn {
    left: clamp(12px, 3.5vw, 46px);
    top: clamp(96px, 15vw, 172px);
    transform: rotate(6deg);
    z-index: 1;
  }

  .hero__heart {
    position: absolute;
    top: 58%;
    right: clamp(4px, 2vw, 24px);
    z-index: 1;
    transform: rotate(12deg);
    opacity: 0.9;
  }

  .hero__twinkle {
    position: absolute;
    bottom: 17%;
    left: clamp(8px, 3vw, 42px);
    z-index: 1;
    transform: rotate(-14deg);
  }

  .hero__cta-note {
    position: absolute;
    top: calc(100% + 8px);
    left: 2px;
    display: flex;
    align-items: center;
    gap: 6px;
    transform: rotate(-2deg);
  }

  .hero__cta-note svg {
    flex: none;
  }

  .hero__index {
    position: relative;
    padding: 28px 26px 24px;
    border: 1.5px solid var(--color-plum);
    border-top: 4px solid var(--color-mustard);
    border-radius: 3px;
    background: var(--color-surface);
    transition: border-color var(--transition);
  }

  .hero__index:hover {
    border-color: var(--color-terracotta);
  }

  .hero__index-title {
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .hero__index ol {
    display: grid;
    gap: 10px;
  }

  .hero__index li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(108, 3, 69, 0.18);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-plum-deep);
  }

  .hero__index li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .hero__index li span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-terracotta-deep);
  }

  .hero__index-note {
    margin-top: 16px;
    color: var(--color-plum-deep);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .hero__index-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 6px 12px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-bg-alt);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-plum);
  }

  .hero__index-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-terracotta);
    animation: hero-pulse 2s ease-in-out infinite;
  }

  @keyframes hero-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .hero__scroll {
    position: absolute;
    bottom: 22px;
    left: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-plum);
  }

  .hero__scroll-line {
    width: 1.5px;
    height: 34px;
    background: linear-gradient(to bottom, var(--color-terracotta), transparent);
    animation: scroll-pulse 2.2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scaleY(0.85);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.1);
    }
  }

  @media (max-width: 980px) {
    .hero {
      min-height: auto;
      padding-block: clamp(56px, 10vw, 92px) clamp(80px, 12vw, 110px);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: clamp(36px, 7vw, 56px);
    }

    .hero__title {
      max-width: 100%;
    }

    .hero__index {
      max-width: 460px;
    }
  }

  @media (max-width: 560px) {
    .hero__title {
      font-size: clamp(2.9rem, 15vw, 4.2rem);
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .btn {
      width: 100%;
    }

    .hero__index {
      padding: 24px 20px 20px;
    }

    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .hero__margin,
    .hero__flower,
    .hero__heart,
    .hero__twinkle,
    .hero__cta-note {
      display: none;
    }
  }
</style>
