---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ProjectExplorer from '../components/ProjectExplorer.astro';
import WorkflowSimulator from '../components/WorkflowSimulator.astro';
import AgileRitualCalculator from '../components/AgileRitualCalculator.astro';
---

<BaseLayout>
  <Hero />
  <div class="wave-divider" aria-hidden="true"></div>
  <About />
  <div class="wave-divider wave-divider--floral" aria-hidden="true"></div>
  <ProjectExplorer />
  <div class="wave-divider wave-divider--scissors" aria-hidden="true"></div>
  <WorkflowSimulator />
  <div class="wave-divider wave-divider--alt" aria-hidden="true"></div>
  <AgileRitualCalculator />
  <div class="wave-divider wave-divider--floral" aria-hidden="true"></div>
</BaseLayout>
