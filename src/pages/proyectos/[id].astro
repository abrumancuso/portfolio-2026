---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { areaLabels, projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const currentIndex = projects.findIndex((item) => item.id === project.id);
const previous = projects[(currentIndex - 1 + projects.length) % projects.length];
const next = projects[(currentIndex + 1) % projects.length];
const productReading = project.miradas.producto;
const managementReading = project.miradas.gestion;
---

<BaseLayout
  title={`${project.title} | Abril Mancuso`}
  description={`${project.summary} Caso completo de Abril Mancuso, Project Manager y Diseñadora UX/UI.`}
>
  <article class="project-page starfield starfield--soft">
    <div class="project-page__rail project-page__rail--left deco" aria-hidden="true">
      <svg viewBox="0 0 100 100" width="54" height="54" focusable="false">
        <g fill="#F7C566" stroke="#6C0345" stroke-width="2" stroke-linejoin="round">
          <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" />
          <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(72 50 50)" />
          <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(144 50 50)" />
          <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(216 50 50)" />
          <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(288 50 50)" />
        </g>
        <circle cx="50" cy="50" r="6" fill="#6C0345" />
      </svg>
      <svg viewBox="0 0 60 60" width="38" height="38" fill="none" stroke="#6C0345" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" focusable="false">
        <path d="M30 5 37 23 56 23 41 34 47 53 30 41 13 53 19 34 4 23 23 23Z" />
      </svg>
      <svg viewBox="0 0 40 36" width="30" height="28" fill="none" stroke="#DC6B19" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        <path d="M20 31S5 21 5 12a7 7 0 0 1 15-2 7 7 0 0 1 15 2c0 9-15 19-15 19Z" />
      </svg>
      <svg viewBox="0 0 40 40" width="26" height="26" fill="none" stroke="#6C0345" stroke-width="1.6" stroke-linejoin="round" focusable="false">
        <path d="M20 4c1.6 8.4 4.2 11 12.6 12.6C24.2 18.2 21.6 20.8 20 29.2 18.4 20.8 15.8 18.2 7.4 16.6 15.8 15 18.4 12.4 20 4Z" />
      </svg>
    </div>

    <div class="project-page__rail project-page__rail--right deco" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="24" height="24" fill="none" stroke="#6C0345" stroke-width="1.6" stroke-linejoin="round" focusable="false">
        <path d="M20 4c1.6 8.4 4.2 11 12.6 12.6C24.2 18.2 21.6 20.8 20 29.2 18.4 20.8 15.8 18.2 7.4 16.6 15.8 15 18.4 12.4 20 4Z" />
      </svg>
      <svg viewBox="0 0 80 112" width="40" height="56" fill="none" stroke="#6C0345" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        <path d="M24 10c-3 4-4 8-4 12M36 10c-3 4-4 8-4 12" />
        <g>
          <ellipse cx="40" cy="26" rx="7" ry="11" />
          <ellipse cx="40" cy="26" rx="7" ry="11" transform="rotate(72 40 38)" />
          <ellipse cx="40" cy="26" rx="7" ry="11" transform="rotate(144 40 38)" />
          <ellipse cx="40" cy="26" rx="7" ry="11" transform="rotate(216 40 38)" />
          <ellipse cx="40" cy="26" rx="7" ry="11" transform="rotate(288 40 38)" />
        </g>
        <circle cx="40" cy="38" r="5" />
        <path d="M40 44c2 16-2 28-1 42" />
        <path d="M39 70c-8-3-13 2-14 8 7 1 12-2 14-8Z" />
      </svg>
      <svg viewBox="0 0 60 60" width="32" height="32" fill="none" stroke="#DC6B19" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" focusable="false">
        <path d="M30 5 37 23 56 23 41 34 47 53 30 41 13 53 19 34 4 23 23 23Z" />
      </svg>
    </div>

    <div class="project-page__inner">
      <a class="project-page__back" href="/#proyectos">
        <span aria-hidden="true">←</span>
        Volver a proyectos
      </a>

      <header class="project-page__header">
        <svg class="project-page__stamp deco" viewBox="0 0 160 160" width="132" height="132" aria-hidden="true" focusable="false">
          <defs>
            <path id="project-stamp-path" d="M80 80m-58 0a58 58 0 1 1 116 0a58 58 0 1 1-116 0" />
          </defs>
          <circle cx="80" cy="80" r="75" fill="none" stroke="#6C0345" stroke-width="1.5" />
          <circle cx="80" cy="80" r="68" fill="none" stroke="#6C0345" stroke-width="0.8" opacity="0.55" />
          <circle cx="80" cy="80" r="46" fill="none" stroke="#6C0345" stroke-width="1" opacity="0.5" />
          <text class="project-page__stamp-text">
            <textPath href="#project-stamp-path" startOffset="0" textLength="358" lengthAdjust="spacing" dominant-baseline="central">
              CASO DE ESTUDIO * PORTFOLIO 2026 *
            </textPath>
          </text>
          <circle cx="80" cy="80" r="6" fill="#DC6B19" />
        </svg>

        <svg class="project-page__flower deco" viewBox="0 0 100 100" width="62" height="62" aria-hidden="true" focusable="false">
          <g fill="#F7C566" stroke="#6C0345" stroke-width="2" stroke-linejoin="round">
            <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" />
            <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(72 50 50)" />
            <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(144 50 50)" />
            <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(216 50 50)" />
            <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(288 50 50)" />
          </g>
          <circle cx="50" cy="50" r="6" fill="#6C0345" />
        </svg>

        <div class="project-page__topline">
          <span class="tag">{project.tag}</span>
          <span class="project-page__year">{project.year}</span>
        </div>
        <h1>{project.title}</h1>
        <p class="project-page__summary">{project.summary}</p>

        <div class="project-page__file folder">
          <span class="folder__tab folder__tab--terracotta">Archivo técnico del proyecto</span>
          <span class="deco-tape project-page__file-tape" aria-hidden="true"></span>
          <dl class="project-page__facts folder__body">
            <div>
              <dt>Áreas</dt>
              <dd>
                <ul class="project-page__pill-list">
                  {project.areas.map((area) => <li class="tag">{areaLabels[area]}</li>)}
                </ul>
              </dd>
            </div>
            <div>
              <dt>Mi rol</dt>
              <dd set:html={project.role}></dd>
            </div>
            <div>
              <dt>Herramientas</dt>
              <dd>
                <ul class="project-page__pill-list">
                  {project.tools.map((tool) => <li class="tag">{tool}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
        </div>
      </header>

      <div class="project-page__scrollnote deco" aria-hidden="true">
        <span class="deco-note">mirá el proceso abajo</span>
        <svg viewBox="0 0 80 60" width="64" height="48" fill="none" stroke="#6C0345" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M56 6c-3 19-14 32-32 42" />
          <path d="M27 40l-5 9 11 1" />
        </svg>
      </div>

      <div class="wave-divider wave-divider--floral project-page__divider" aria-hidden="true"></div>

      <ProjectMedia project={project} />

      <div class="wave-divider project-page__divider" aria-hidden="true"></div>

      <section class="project-page__metrics" aria-labelledby="metricas-title">
        <h2 class="visually-hidden" id="metricas-title">Métricas del proyecto</h2>
        <dl>
          {project.metrics.map((metric) => (
            <div>
              <dt>{metric.label}</dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="project-page__section project-page__card folder" aria-labelledby="desafio-title">
        <span class="folder__tab folder__tab--mustard">El desafío</span>
        <span class="paper-clip project-page__clip" aria-hidden="true"></span>
        <div class="project-page__card-body folder__body">
          <h2 id="desafio-title">Qué había que resolver</h2>
          <p set:html={project.problem}></p>
        </div>
      </section>

      <section class="project-page__section project-page__card folder" aria-labelledby="rol-title">
        <span class="folder__tab folder__tab--terracotta">Mi rol</span>
        <div class="project-page__card-body folder__body">
          <h2 id="rol-title">Qué hice y con quién</h2>
          <p set:html={project.role}></p>
          <ul class="project-page__roles" aria-label="Responsabilidades del proyecto">
            {project.roles.map((role) => <li>{role}</li>)}
          </ul>
        </div>
      </section>

      <section class="project-page__readings" aria-labelledby="lecturas-title">
        <div class="project-page__section-head">
          <p class="project-page__eyebrow">Dos lecturas</p>
          <h2 id="lecturas-title">El mismo proyecto desde dos enfoques</h2>
          <p>
            La misma evidencia, leída desde la <strong>experiencia de producto</strong> o
            desde la <strong>gestión</strong>. Acá están las dos.
          </p>
        </div>

        <div class="project-page__readings-grid">
          <article class="project-page__reading project-page__reading--product folder">
            <span class="folder__tab folder__tab--terracotta">UX/UI &amp; Producto</span>
            <div class="project-page__reading-body folder__body">
              <p class="project-page__focus" set:html={productReading.focus}></p>
              <p set:html={productReading.detail}></p>

              <h3>Decisiones de diseño</h3>
              <ul>
                {project.decisions.map((decision) => <li set:html={decision}></li>)}
              </ul>
            </div>
          </article>

          <article class="project-page__reading project-page__reading--management folder">
            <span class="folder__tab">Gestión &amp; Arquitectura Técnica</span>
            <div class="project-page__reading-body folder__body">
              <p class="project-page__focus" set:html={managementReading.focus}></p>
              <p set:html={managementReading.detail}></p>

              <h3>Proceso técnico</h3>
              <ol class="project-page__process">
                {project.process.map((step) => (
                  <li>
                    <strong>{step.step}</strong>
                    <span>{step.detail}</span>
                  </li>
                ))}
              </ol>

              <h3>Herramientas</h3>
              <ul class="project-page__tools">
                {project.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            </div>
          </article>
        </div>
      </section>

      <section class="project-page__section project-page__card folder" aria-labelledby="aprendizajes-title">
        <span class="folder__tab folder__tab--cream">Aprendizajes</span>
        <span class="paper-clip project-page__clip" aria-hidden="true"></span>
        <div class="project-page__card-body folder__body">
          <h2 id="aprendizajes-title">Qué me dejó el proyecto</h2>
          <p set:html={project.learnings}></p>
        </div>
      </section>

      <div class="wave-divider wave-divider--scissors project-page__divider" aria-hidden="true"></div>

      <section class="project-page__cta" aria-labelledby="cierre-title">
        <div class="project-page__cta-pattern deco" aria-hidden="true">
          {Array.from({ length: 8 }).map(() => (
            <span>DISEÑO UX/UI · GESTIÓN · EJECUCIÓN ·</span>
          ))}
        </div>

        <div class="project-page__cta-card">
          <span class="paper-clip" aria-hidden="true"></span>
          <svg class="project-page__cta-flower deco" viewBox="0 0 100 100" width="60" height="60" aria-hidden="true" focusable="false">
            <g fill="#F7C566" stroke="#6C0345" stroke-width="2" stroke-linejoin="round">
              <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" />
              <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(72 50 50)" />
              <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(144 50 50)" />
              <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(216 50 50)" />
              <path d="M50 50C41 44 37 27 50 14c13 13 9 30 0 36Z" transform="rotate(288 50 50)" />
            </g>
            <circle cx="50" cy="50" r="6" fill="#6C0345" />
          </svg>
          <svg class="project-page__cta-star deco" viewBox="0 0 60 60" width="46" height="46" fill="none" stroke="#6C0345" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M30 5 37 23 56 23 41 34 47 53 30 41 13 53 19 34 4 23 23 23Z" />
          </svg>

          <p class="project-page__eyebrow">Siguiente paso</p>
          <h2 id="cierre-title">¿Te gustó este enfoque? Llevémoslo a tu próximo proyecto.</h2>
          <p class="project-page__cta-copy">
            Coordinamos <strong>30 minutos</strong> y salís con una propuesta concreta:
            alcance, próximos pasos y horario que funcione para los dos.
          </p>

          <div class="project-page__cta-actions">
            <a class="btn btn--primary" href="/#rituales">
              Coordinar una reunión (Live Sync)
              <span aria-hidden="true">→</span>
            </a>
            <a class="btn btn--behance" href={project.behanceUrl} target="_blank" rel="noopener noreferrer">
              Ver más en mi Behance
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <a class="project-page__next" href={`/proyectos/${next.id}`}>
            <span class="project-page__next-label">Siguiente proyecto</span>
            <strong>{next.title} <span aria-hidden="true">→</span></strong>
          </a>
        </div>
      </section>

      <nav class="project-page__pagination" aria-label="Otros proyectos">
        <a class="project-page__pagination-link" href={`/proyectos/${previous.id}`}>
          <span>Proyecto anterior</span>
          <strong>{previous.title}</strong>
        </a>
        <a class="project-page__pagination-link project-page__pagination-link--next" href={`/proyectos/${next.id}`}>
          <span>Proyecto siguiente</span>
          <strong>{next.title}</strong>
        </a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    position: relative;
    overflow: clip;
    padding: clamp(40px, 7vw, 84px) 24px clamp(56px, 8vw, 96px);
    background-color: var(--color-bg);
    background-image:
      radial-gradient(ellipse 62% 38% at 8% 2%, rgba(247, 197, 102, 0.26), transparent 72%),
      radial-gradient(ellipse 48% 32% at 96% 58%, rgba(220, 107, 25, 0.09), transparent 72%);
  }

  /* --- Rieles decorativos en los márgenes (sólo pantallas anchas) --- */
  .project-page__rail {
    position: absolute;
    top: 250px;
    bottom: 280px;
    left: calc(50% - 672px);
    z-index: 2;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: 58px;
    pointer-events: none;
  }

  .project-page__rail--right {
    top: 44%;
    bottom: 140px;
    right: calc(50% - 672px);
    left: auto;
  }

  .project-page__rail--left > :nth-child(even) {
    transform: rotate(-9deg);
  }

  .project-page__rail--right > :nth-child(odd) {
    transform: rotate(8deg);
  }

  @media (min-width: 1360px) {
    .project-page__rail {
      display: flex;
    }
  }

  .project-page__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-width);
    margin: 0 auto;
  }

  /* --- Etiqueta de regreso tipo tira editorial --- */
  .project-page__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 30px;
    padding: 9px 16px;
    border: 1.5px solid var(--color-plum);
    border-radius: 2px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker-sm);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-plum);
    text-decoration: none;
    transform: rotate(-1deg);
    transition: transform var(--transition), background var(--transition),
      box-shadow var(--transition);
  }

  .project-page__back:hover {
    background: var(--color-mustard);
    transform: rotate(-1deg) translate(-1px, -1px);
    box-shadow: 5px 5px 0 var(--color-plum);
  }

  .project-page__header {
    position: relative;
    margin-bottom: clamp(18px, 3vw, 28px);
  }

  /* --- Sello circular y flor del encabezado --- */
  .project-page__stamp {
    position: absolute;
    top: -12px;
    right: 2px;
    width: 132px;
    height: 132px;
    transform: rotate(-9deg);
    opacity: 0.92;
  }

  .project-page__stamp-text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    fill: var(--color-plum);
  }

  .project-page__flower {
    position: absolute;
    top: 146px;
    right: 40px;
    transform: rotate(12deg);
    filter: drop-shadow(3px 4px 0 rgba(108, 3, 69, 0.14));
  }

  .project-page__topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    max-width: 900px;
    margin-bottom: 14px;
  }

  .project-page__year {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .project-page h1 {
    max-width: 16ch;
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .project-page__summary {
    max-width: 64ch;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.7;
  }

  /* --- Ficha técnica como carpeta de archivo --- */
  .project-page__file {
    max-width: 900px;
    margin-top: 30px;
    padding-top: 38px;
  }

  .project-page__file-tape {
    top: -9px;
    right: 52px;
    left: auto;
    transform: rotate(7deg);
  }

  .project-page__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: clamp(22px, 3vw, 30px);
    border: 2px solid var(--color-plum);
    border-radius: 0 10px 10px 10px;
    background: linear-gradient(160deg, var(--color-surface), var(--color-peach));
    box-shadow: var(--shadow-sticker);
  }

  .project-page__facts dt {
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-page__facts dd {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .project-page__pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-page__pill-list .tag {
    min-height: 24px;
    padding: 3px 9px;
    font-size: 0.62rem;
    box-shadow: 2px 2px 0 rgba(108, 3, 69, 0.14);
  }

  /* --- Nota manuscrita con flecha --- */
  .project-page__scrollnote {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    margin: 2px 12px 0;
    transform: rotate(-3deg);
  }

  .project-page__scrollnote .deco-note {
    font-size: 1.05rem;
  }

  .project-page__divider {
    margin: clamp(18px, 3vw, 30px) 0;
    opacity: 0.42;
  }

  .project-page__divider.wave-divider--floral {
    opacity: 0.85;
  }

  /* --- Métricas como recorte de archivo --- */
  .project-page__metrics {
    position: relative;
    margin-bottom: clamp(32px, 5vw, 52px);
    padding: clamp(22px, 3vw, 30px);
    border: 2px solid var(--color-plum);
    border-radius: 4px;
    background: linear-gradient(150deg, var(--color-cream-deep), var(--color-surface));
    box-shadow: var(--shadow-sticker-soft);
    transform: rotate(-0.35deg);
  }

  .project-page__metrics::after {
    content: '✦';
    position: absolute;
    top: 8px;
    right: 14px;
    font-size: 0.78rem;
    color: var(--color-terracotta);
  }

  .project-page__metrics dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
  }

  .project-page__metrics dt {
    margin-bottom: 2px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-page__metrics dd {
    margin: 0;
    font-family: var(--font-ui);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-plum);
  }

  /* --- Bloques de lectura como carpetas --- */
  .project-page__section {
    max-width: 900px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .project-page__card {
    padding-top: 38px;
  }

  .project-page__card-body {
    padding: clamp(24px, 3.4vw, 34px);
    border-width: 2px;
    border-radius: 0 10px 10px 10px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sticker-soft);
  }

  .project-page__clip {
    top: -16px;
    right: 30px;
    left: auto;
  }

  .project-page__eyebrow {
    margin-bottom: 8px;
